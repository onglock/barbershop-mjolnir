---
// Панель превью: в правом нижнем углу — кнопка, по клику справа выезжает дровер
// с органами управления конкретной страницы. Содержимое панели страница помечает
// атрибутом data-pp; скрипт переносит этот блок внутрь дровера и снимает у него
// фиксированное позиционирование, поэтому контент больше ничем не перекрыт.
// На страницах без [data-pp] (главная и обычные страницы) кнопка и дровер не
// показываются вовсе — компонент подключён один раз в Layout.
---

<button
	type="button"
	class="pp-toggle"
	id="pp-toggle"
	aria-expanded="false"
	aria-controls="pp-drawer"
>
	<span class="pp-dot" aria-hidden="true"></span>
	<span>Параметры превью</span>
</button>

<aside class="pp-drawer" id="pp-drawer" aria-hidden="true" aria-label="Параметры превью">
	<div class="pp-head">
		<span class="pp-title">Параметры превью</span>
		<button type="button" class="pp-close" id="pp-close" aria-label="Свернуть панель">Свернуть</button>
	</div>
	<div class="pp-body" id="pp-body"></div>
</aside>

<style is:global>
	/* На страницах без панели ничего не показываем. */
	html:not([data-pp-on]) .pp-toggle,
	html:not([data-pp-on]) .pp-drawer {
		display: none !important;
	}

	.pp-toggle {
		position: fixed;
		right: 16px;
		bottom: 16px;
		z-index: 300;
		display: inline-flex;
		align-items: center;
		gap: 9px;
		min-height: 48px;
		padding: 0 18px;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-deep) 92%, transparent);
		backdrop-filter: blur(10px);
		font-family: var(--font-label);
		font-size: var(--text-label);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text);
		cursor: pointer;
		transition: border-color 200ms cubic-bezier(0.33, 1, 0.68, 1), color 200ms cubic-bezier(0.33, 1, 0.68, 1);
	}
	.pp-toggle:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.pp-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent-warm);
	}
	/* Панель открыта — кнопка не нужна, закрыть можно крестиком, Esc или повторным кликом. */
	html[data-pp-open] .pp-toggle {
		opacity: 0;
		pointer-events: none;
	}

	.pp-drawer {
		position: fixed;
		top: 0;
		right: 0;
		bottom: 0;
		z-index: 310;
		width: min(92vw, 430px);
		display: flex;
		flex-direction: column;
		border-left: 1px solid var(--border);
		background: color-mix(in srgb, var(--bg-deep) 96%, transparent);
		backdrop-filter: blur(12px);
		transform: translateX(101%);
		transition: transform 320ms cubic-bezier(0.33, 1, 0.68, 1);
	}
	html[data-pp-open] .pp-drawer {
		transform: translateX(0);
	}
	.pp-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 14px 16px;
		border-bottom: 1px solid var(--border);
	}
	.pp-title {
		font-family: var(--font-label);
		font-size: var(--text-label);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.pp-close {
		min-height: 40px;
		padding: 8px 14px;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: transparent;
		font-family: var(--font-label);
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
		cursor: pointer;
	}
	.pp-close:hover {
		border-color: var(--accent);
		color: var(--text);
	}
	.pp-body {
		flex: 1 1 auto;
		overflow-y: auto;
		padding: 14px 16px 28px;
	}

	/* Перенесённая панель страницы: гасим фиксированное позиционирование, ширину,
	   фон и рамку — внутри дровера она обычный блок. Стили её внутренних кнопок
	   не трогаем: они остаются страничными. !important нужен, потому что у
	   страницы свои (в том числе scoped) правила на этот же элемент. */
	.pp-body [data-pp] {
		position: static !important;
		inset: auto !important;
		transform: none !important;
		width: auto !important;
		max-width: none !important;
		margin: 0 !important;
		border: 0 !important;
		border-radius: 0 !important;
		background: none !important;
		backdrop-filter: none !important;
		box-shadow: none !important;
	}

	@media (prefers-reduced-motion: reduce) {
		.pp-drawer { transition: none; }
	}
</style>

<script>
	const root = document.documentElement;
	const panel = document.querySelector('[data-pp]');
	const body = document.getElementById('pp-body');
	const toggle = document.getElementById('pp-toggle');
	const drawer = document.getElementById('pp-drawer');
	const close = document.getElementById('pp-close');

	if (panel && body) {
		/* Переносим панель страницы в дровер. Атрибут скоупа Astro висит на самих
		   элементах, поэтому страничные стили внутри панели продолжают работать. */
		body.appendChild(panel);
		root.dataset.ppOn = '1';

		const setOpen = (open: boolean) => {
			if (open) root.dataset.ppOpen = '1';
			else delete root.dataset.ppOpen;
			toggle?.setAttribute('aria-expanded', String(open));
			drawer?.setAttribute('aria-hidden', String(!open));
		};

		toggle?.addEventListener('click', () => setOpen(!root.dataset.ppOpen));
		close?.addEventListener('click', () => setOpen(false));
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});

		(window as any).__pp = {
			open: () => setOpen(true),
			close: () => setOpen(false),
			toggle: () => setOpen(!root.dataset.ppOpen),
			state: () => ({
				on: !!root.dataset.ppOn,
				open: !!root.dataset.ppOpen,
				panelInDrawer: !!body.querySelector('[data-pp]'),
				toggleVisible: toggle ? getComputedStyle(toggle).display !== 'none' : null,
			}),
		};
	}
</script>
