---
// Молот в hero. На 1024 и ниже 3D-сцена не грузится (Hero3D стоит под
// client:media="(min-width: 1024px)"), и кадр держит этот слой: заранее
// отрендеренный hammer-cold.png через astro:assets → AVIF/WebP с srcset.
//
// ── Скелет прилёта (этап 2) ──────────────────────────────────────────
// До клика молот скрыт, в hero стоит призыв. По клику играет звук притяжения,
// молот вылетает слева и встаёт в финальную позицию ровно на пике звука.
// Финальные координаты — те же константы, что зафиксированы раньше.
import { Picture } from 'astro:assets';
import hammerCold from '../assets/hammer/hammer-cold.png';
---

<div class="hero-hammer lg:hidden" aria-hidden="true" data-state="idle">
	<Picture
		src={hammerCold}
		widths={[320, 390, 480, 640]}
		sizes="100vw"
		formats={['avif', 'webp']}
		alt=""
		loading="eager"
		decoding="async"
		class="hero-hammer__img"
	/>
</div>

<style>
	.hero-hammer {
		/* Финальное положение — точка прилёта. */
		--hammer-2d-final-x: -14%;
		--hammer-2d-final-y: -12%;
		--hammer-2d-opacity: 0.62;

		/* Старт: молот за левым краем кадра. Уход по Z убран: с perspective он
		   тянул стартовую точку к центру, и вылет читался как «из середины».
		   История значений: −85vw (виден почти сразу), −100vw (ровно ширина
		   экрана), −150vw (0,65 с пустого кадра — перебор), −140vw (при
		   десктопном X = −18,8). Текущее — пропорциональный эквивалент X = −16:
		   140 · 16 / 18,8 ≈ 119vw. Это дистанция от финального места, как и X
		   в сцене: доля пути, на которой молот входит в кадр, у слоёв совпадает
		   приблизительно (см. замер в карте §16). */
		--hammer-2d-start-shift: -119vw;
		/* Стартовый масштаб 0,05 — синхронно с десктопом (решение Кирилла
		   2026-09-24). Рост на мобильном линейный, без кривой: одна CSS-анимация. */
		--hammer-2d-start-scale: 0.05;
		/* Вращение «колесом» в плоскости экрана (rotateZ): почти восемь
		   оборотов по часовой. При полёте 0,9 с (решение Кирилла, вариант Б)
		   это ≈3100 °/с против ≈2000 °/с при прежних 1,4 с. */
		--hammer-2d-turn: 2800deg;

		/* Старт полёта отложен: 0,3 с молот стоит за краем, звук уже играет. */
		--hammer-2d-delay: 0.3s;

		/* Полёт 0,9 с: старт на 0,3 с, приземление на 1,2 с — совпадает с пиком
		   звука (1120 мс от начала звучания + ≈90 мс латентности запуска). */
		--hammer-2d-flight: 0.9s;

		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		overflow: hidden;
	}

	.hero-hammer__img {
		position: absolute;
		right: var(--hammer-2d-final-x);
		bottom: var(--hammer-2d-final-y);
		height: 84%;
		width: auto;
		object-fit: contain;
		margin: 0;
		user-select: none;
	}

	/* ── До прилёта: молота в кадре нет ─────────────────────────────── */
	.hero-hammer[data-state='idle'] .hero-hammer__img {
		opacity: 0;
		transform: translateX(var(--hammer-2d-start-shift)) scale(var(--hammer-2d-start-scale));
	}

	/* ── В полёте: летит слева, растёт, вращается вокруг вертикали ──── */
	/* Полёт: рост и вращение идут ЛИНЕЙНО весь путь. Вращение — rotateZ,
	   то есть в плоскости экрана: молот летит и крутится «колесом», как
	   метательный нож. rotateY (как дверь) и rotateX (сальто в глубину)
	   не подошли — нужна именно третья ось. */
	.hero-hammer[data-state='flying'] .hero-hammer__img {
		opacity: var(--hammer-2d-opacity);
		transform-style: preserve-3d;
		/* fill-mode both: во время задержки молот уже стоит в стартовой позе
		   за краем и не мелькает в финальной точке. */
		animation: hero-fly var(--hammer-2d-flight) linear var(--hammer-2d-delay) both;
	}

	@keyframes hero-fly {
		from {
			transform: perspective(1100px)
				translateX(var(--hammer-2d-start-shift))
				rotateZ(var(--hammer-2d-turn))
				scale(var(--hammer-2d-start-scale));
		}
		to {
			transform: perspective(1100px) translateX(0) rotateZ(0deg) scale(1);
		}
	}

	/* ── Прилетел ───────────────────────────────────────────────────── */
	.hero-hammer[data-state='landed'] .hero-hammer__img {
		opacity: var(--hammer-2d-opacity);
		transform: perspective(1100px) translateX(0) rotateZ(0deg) scale(1);
	}

	/* Молот в полёте — поверх текста Hero (слой 3), после посадки возвращается. */
	.hero-hammer[data-state='flying'] { z-index: 50; }

	/* ── Десктоп: полёт рисует 2D-дублёр ────────────────────────────────
	   Canvas R3F центрирован по своей области, поэтому координата сцены не равна
	   координате страницы и «старт из-за левого края» в 3D не получается.
	   Поэтому на 1024+ летит эта же картинка (HTML-слой), а 3D-молот показывается
	   только в момент посадки — на том же месте и того же размера. */
	@media (min-width: 1024px) {
		.hero-hammer { display: none; }
	}
	/* После прилёта призыв гаснет — его место занимает рамка «Ты достоин». */
	.hero-call[data-done='1'] { opacity: 0; pointer-events: none; color: var(--text); }

	/* ── Мобильный: знак кувырка развёрнут ──────────────────────────────
	   На десктопе кувырок идёт через scene.rotation.z, где положительный угол
	   читается против часовой; в CSS rotateZ положительный — по часовой.
	   Поэтому одна и та же цифра даёт на 390 обратное направление.
	   Кирилл смотрел вживую: на мобильном нужен минус. */
	@media (max-width: 1023px) {
		.hero-hammer { --hammer-2d-turn: -2800deg; }
	}

	/* Reduce-motion: полёта нет, молот встаёт на место сразу. */
	@media (prefers-reduced-motion: reduce) {
		.hero-hammer[data-state='flying'] .hero-hammer__img { animation: none; }
		.hero-hammer[data-state='flying'] .hero-hammer__img,
		.hero-hammer[data-state='landed'] .hero-hammer__img {
			transform: perspective(1100px) translateX(0) rotateZ(0deg) scale(1);
		}
	}
</style>

<script>
	/* Пик звука hammer-catch.mp3 — 0,45 с от старта: файл 0,7 с, профиль
	   по 100 мс окнам прыгает с −96 dB до −5,2 dB на пятом окне. Полёт
	   длится ровно этот отрезок, поэтому удар совпадает с попаданием
	   молота в финальную позицию. */
	const layer = document.querySelector<HTMLElement>('.hero-hammer');
	const call = document.querySelector<HTMLElement>('.hero-call');
	const cta = document.querySelector<HTMLElement>('#top a[href="#contact"]');
	/* Переключатели для показа вариантов: ?call=a|b — оформление надписи,
	   ?fly=z|dim — молот поверх текста (z) или он же плюс затемнение (dim). */
	const params = new URLSearchParams(location.search);
	/* Направление кувырка для 2D-молота: ?turn=ccw — против часовой. */
	if (params.get('turn') === 'ccw' && layer) layer.style.setProperty('--hammer-2d-turn', '-2800deg');
	document.documentElement.dataset.call = params.get('call') || 'a';
	document.documentElement.dataset.fly = params.get('fly') || 'z';
	/* Пик звука hammer-attract-final.mp3 (извлечён из .mov Кирилла 2026-09-23).
	   Прежний комментарий («пик в самом конце, 1,9 с») НЕВЕРЕН: замер огибающей
	   (Web Audio: decodeAudioData + RMS по окнам 20 мс) даёт пик на 1120 мс
	   (−14 дБ), порог −40 дБ с 560 мс, конец файла 1963 мс. Тайминг построен по
	   факту: задержка 0,3 с + полёт 0,9 с = посадка на 1,2 с, звук стартует в
	   клик и его пик приходит на 1120 + ≈90 мс латентности запуска ≈ 1,21 с. */
	const PEAK_MS = 1200;
	const CALL_TEXT = 'Нажми — узнаешь, достоин ли ты стрижки рукой мастера';
	let running = false;
	let audio: HTMLAudioElement | null = null;
	/* Таймер посадки: нужен, чтобы сброс в момент полёта его гасил — иначе
	   отложенный колбэк вернул бы слой в «landed» уже после сброса. */
	let landTimer = 0;

	/* Тайминги прилёта — один набор для 2D-слоя и 3D-сцены: задержка 300 мс плюс
	   ход 900 мс, то есть молот встаёт на место на 1200 мс от клика.
	   Решение Кирилла (вариант Б, 2026-09-24): звук стартует в клик, а полёт
	   укорочен с 1400 до 900 мс — так пик звука совпадает с посадкой.
	   Почему 900, а не 820: пик файла 1120 мс отсчитывается от НАЧАЛА ЗВУЧАНИЯ,
	   а оно запаздывает относительно play() на ≈90 мс (замерено дважды: 77 и
	   114 мс) → пик приходит ≈ на 1210 мс. При 900 посадка 1200 (расхождение
	   ≈10 мс), при 820 была бы 1120 — на 90 мс раньше пика. */
	const FLIGHT_DELAY_MS = 300;
	const FLIGHT_MS = 900;

	/* Звук готовим ЗАРАНЕЕ и переиспользуем. Раньше `new Audio()` создавался в
	   момент клика, поэтому файл начинал качаться только тогда и звук опаздывал
	   ровно на время загрузки (в dev-режиме это ~1.4 с — читалось как «звук
	   отстал от анимации»). Подготовка файла жест не требует, только play(). */
	function armAttractSound(): HTMLAudioElement {
		if (!audio) {
			audio = new Audio('/sounds/hammer-attract-final.mp3');
			audio.preload = 'auto';
			audio.loop = false;
			audio.volume = 0.9;
		}
		return audio;
	}

	function playAttractSound() {
		const el = armAttractSound();
		/* Вариант Б (решение Кирилла, 2026-09-24): звук стартует СРАЗУ в клик —
		   вместе с укороченным до 900 мс полётом его пик (≈1210 мс с учётом
		   латентности запуска) приходится на посадку (1200 мс). Запуск идёт
		   прямо из обработчика жеста, поэтому автоплей разрешён гарантированно.
		   Повторный запуск НЕ глушится: полёт можно гонять подряд, и тогда звук
		   должен начинаться с начала, а не молчать (прежняя проверка `!paused`
		   ломала повторные прогоны). */
		try {
			el.currentTime = 0;
			const res = el.play();
			if (res && typeof res.catch === 'function') res.catch(() => {});
		} catch {
			/* Политика автоплея может отказать — анимация всё равно идёт. */
		}
	}

	/* Прогреваем сразу и подстраховываемся первым касанием (и на мобильном). */
	armAttractSound();
	window.addEventListener('pointerdown', () => armAttractSound(), { once: true, passive: true });

	function reset() {
		if (!layer) return;
		layer.dataset.state = 'idle';
		if (call) { call.textContent = CALL_TEXT; call.dataset.done = '0'; }
		/* Сброс должен останавливать и звук, и метку клика, и таймер посадки:
		   иначе после сброса остров, смонтировавшийся позже, разыграл бы полёт
		   сам, а отложенный колбэк вернул бы слой в «landed». */
		if (audio) { audio.pause(); audio.currentTime = 0; }
		if (landTimer) { window.clearTimeout(landTimer); landTimer = 0; }
		(window as any).__attractFired = false;
		running = false;
	}

	function attract() {
		if (!layer || running) return;
		running = true;

		playAttractSound();
		/* Метка для 3D-острова: если он смонтируется позже клика (модель ещё
		   грузится), он увидит метку на монтировании и разыграет полёт — иначе
		   событие терялось бы совсем и прилёт не проигрывался. */
		(window as any).__attractFired = true;

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (reduced) {
			layer.dataset.state = 'landed';
			/* Текст призыва не меняем: иначе ячейка слота сжимается и рамка прыгает. */
		if (call) call.dataset.done = '1';
			running = false;
			return;
		}

		layer.dataset.state = 'flying';
		/* Десктоп: 3D-молот в Hero3D слушает то же событие и летит по своим таймингам. */
		window.dispatchEvent(new CustomEvent('hero:attract'));
		landTimer = window.setTimeout(() => {
			landTimer = 0;
			/* Сброс во время полёта переводит слой в idle — тогда посадку не
			   доигрываем. */
			if (layer.dataset.state !== 'flying') return;
			layer.dataset.state = 'landed';
			/* Текст призыва не меняем: иначе ячейка слота сжимается и рамка прыгает. */
			if (call) call.dataset.done = '1';
			running = false;
		}, PEAK_MS);
	}

	cta?.addEventListener('click', (e) => {
		if (!layer) return;
		if (layer.dataset.state === 'idle') { attract(); e.preventDefault(); return; }
		if (layer.dataset.state === 'flying') e.preventDefault();
	});

	/* Призыв «Жми сюда» — тоже триггер: он и есть кнопка запуска. */
	call?.addEventListener('click', (e) => {
		if (!layer) return;
		e.preventDefault();
		if (layer.dataset.state === 'idle') attract();
	});

	/* Браузер возвращал прокрутку к якорю прошлой навигации (#contact), и
	   страница открывалась не на Hero. Восстановление выключаем, а при
	   ПЕРЕЗАГРУЗКЕ убираем и сам якорь из адреса: свежий вход всегда
	   начинается сверху, осознанные переходы по ссылкам работают. */
	if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
	const navType = (performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined)?.type;
	if (navType === 'reload' && location.hash) {
		history.replaceState(null, '', location.pathname + location.search);
	}
	if (!location.hash) window.addEventListener('load', () => window.scrollTo(0, 0));

	/* ?hero=attract — вернуть молот в исходное состояние, чтобы прогнать
	   анимацию заново без перезагрузки страницы. */
	if (new URLSearchParams(location.search).get('hero') === 'attract') reset();

	/* Запуск извне (страница подбора старта, dev-кнопки): то же событие, что
	   шлёт 3D-остров. Повторный вызов во время полёта игнорируется — гвардия
	   `running` выше ставится синхронно, поэтому двойного запуска нет и когда
	   клик по призыву сам рассылает это же событие. */
	window.addEventListener('hero:attract', attract);
	window.addEventListener('hero:reset', reset);
</script>
