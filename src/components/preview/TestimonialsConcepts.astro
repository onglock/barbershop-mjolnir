---
/* ══ TESTIMONIALS — пять концепций подачи (превью для выбора) ═══════════
   Каждая концепция — ДРУГОЙ тип взаимодействия, не параметр одного:
   T1 «ЛЕНТА»        — вертикальный скролл гонит горизонтальную ленту цитат
   T2 «ЖИВАЯ СТЕНА»  — карточки дрейфуют по плоскости + параллакс по скроллу
   T3 «РАЗГОВОР»     — чат: реплики появляются по клику/Enter
   T4 «ГОЛОС»        — цитата + волновая дорожка, «воспроизведение» по клику
   T5 «ПОЛНЫЙ ЭКРАН» — один отзыв на весь экран, навигация клавишами и точками

   Тексты — те же три отзыва, что в боевой секции (см. Testimonials.astro).
   НОВЫЙ КОНТЕНТ помечен в разметке комментарием «нужен контент» и вынесен
   в отчёт: фото клиентов, дополнительные отзывы, аудио.
   ══════════════════════════════════════════════════════════════════════ */

const reviews = [
	{
		id: 'andrey',
		monogram: 'А',
		author: 'Андрей, программист',
		short: 'Андрей',
		text: 'Стрижка держит форму три недели — впервые перестал думать про укладку по утрам. Мастер показал, в какую сторону сушить и чем, теперь получается даже самому.',
	},
	{
		id: 'sergey',
		monogram: 'С',
		author: 'Сергей, предприниматель',
		short: 'Сергей',
		text: 'Хожу с бородой семь лет и только здесь понял, что такое контур. Два месяца — и форма держится сама, между визитами ничего не подбриваю.',
	},
	{
		id: 'kirill',
		monogram: 'К',
		author: 'Кирилл, дизайнер',
		short: 'Кирилл',
		text: 'Пришёл с фотографией из интернета. Мне честно сказали, что форма не сядет на мою голову, и предложили вариант рядом. Вышло лучше картинки.',
	},
];

/* Реплики разговора (T3). Первая реплика — единственный новый текст, помечен. */
const dialogue = [
	{ side: 'ask', who: 'Гость', text: 'Расскажите, как вам здесь стрижка?', isNew: true },
	{ side: 'answer', who: 'Андрей', text: reviews[0].text },
	{ side: 'answer', who: 'Сергей', text: reviews[1].text },
	{ side: 'answer', who: 'Кирилл', text: reviews[2].text },
];

/* Слова для «озвучки» в T4: цитата режется на слова, каждое подсвечивается
   по ходу дорожки. Никакого аудио в прототипе нет — вместо него таймер,
   звук нужно записать (см. отчёт). */
const voices = reviews.map((review) => ({
	...review,
	words: review.text.split(' '),
	/* Высоты дорожки: стабильные, но «живые» — считаются от индекса слова. */
	bars: Array.from({ length: 48 }, (_, i) => 18 + Math.abs(Math.sin(i * 1.7 + review.id.length)) * 62),
}));
---

<!-- ══ T1 «ЛЕНТА» ═════════════════════════════════════════════════════ -->
<section id="tc-t1" class="tc tc-tape" data-concept="t1">
	<div class="tc-tape-scene" data-tape-scene>
		<div class="tc-tape-sticky">
			<div class="tc-head">
				<p class="tc-label">Отзывы</p>
				<h2 class="tc-title">Что говорят</h2>
				<p class="tc-hint">Скролл ведёт ленту вбок</p>
			</div>
			<div class="tc-tape-track" data-tape-track>
				{
					reviews.map((review) => (
						<figure class="tc-quote">
							<blockquote class="tc-quote-text">«{review.text}»</blockquote>
							<figcaption class="tc-quote-author">
								<span class="tc-monogram" aria-hidden="true">{review.monogram}</span>
								{review.author}
							</figcaption>
						</figure>
					))
				}
			</div>
		</div>
	</div>
</section>

<!-- ══ T2 «ЖИВАЯ СТЕНА» ══════════════════════════════════════════════ -->
<section id="tc-t2" class="tc tc-wall" data-concept="t2">
	<div class="tc-inner">
		<div class="tc-head">
			<p class="tc-label">Отзывы</p>
			<h2 class="tc-title">Что говорят</h2>
			<p class="tc-hint">Карточки живут своей жизнью, скролл двигает слои</p>
		</div>
		<div class="tc-wall-plane" data-wall-plane>
			{
				reviews.map((review, index) => (
					<figure class="tc-wall-card" data-wall-card={index} style={`--wx: ${[6, 40, 60][index]}%; --wy: ${[12, 46, 16][index]}%; --wd: ${index + 1}`}>
						<blockquote class="tc-wall-text">«{review.text}»</blockquote>
						<figcaption class="tc-wall-author">
							<span class="tc-monogram" aria-hidden="true">{review.monogram}</span>
							{review.author}
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>

<!-- ══ T3 «РАЗГОВОР» ════════════════════════════════════════════════ -->
<section id="tc-t3" class="tc tc-talk" data-concept="t3">
	<div class="tc-inner">
		<div class="tc-head">
			<p class="tc-label">Отзывы</p>
			<h2 class="tc-title">Что говорят</h2>
			<p class="tc-hint">Реплики идут по одной: клик или Enter</p>
		</div>
		<div class="tc-chat" data-chat>
			<div class="tc-chat-log" data-chat-log>
				{
					dialogue.map((line, index) => (
						<div class="tc-bubble tc-bubble--{line.side}" data-bubble={index}>
							<span class="tc-bubble-who">{line.who}</span>
							<p class="tc-bubble-text">{line.text}</p>
						</div>
					))
				}
				<div class="tc-typing" data-typing aria-hidden="true">
					<span></span><span></span><span></span>
				</div>
			</div>
			<div class="tc-chat-foot">
				<button type="button" class="tc-btn" data-chat-next>Дальше</button>
				<button type="button" class="tc-btn tc-btn--quiet" data-chat-reset>Сначала</button>
				<span class="tc-state" data-chat-state>0 / {dialogue.length}</span>
			</div>
		</div>
	</div>
</section>

<!-- ══ T4 «ГОЛОС» ═══════════════════════════════════════════════════ -->
<section id="tc-t4" class="tc tc-voice" data-concept="t4">
	<div class="tc-inner">
		<div class="tc-head">
			<p class="tc-label">Отзывы</p>
			<h2 class="tc-title">Что говорят</h2>
			<p class="tc-hint">Дорожка «проигрывает» отзыв слово за словом</p>
		</div>
		<div class="tc-voice-body">
			<div class="tc-voice-pick">
				{
					voices.map((voice, index) => (
						<button type="button" class="tc-pick" data-voice-pick={index} aria-pressed={index === 0}>
							<span class="tc-monogram" aria-hidden="true">{voice.monogram}</span>
							{voice.short}
						</button>
					))
				}
			</div>
			<div class="tc-voice-stage">
				{
					voices.map((voice, index) => (
						<div class="tc-voice-item" data-voice-item={index}>
							<p class="tc-voice-text" data-voice-text>
								{voice.words.map((word) => <span class="tc-word">{word}</span>)}
							</p>
							<div class="tc-wave" data-voice-wave>
								{voice.bars.map((height) => <span class="tc-bar" style={`--h: ${height}%`} />)}
							</div>
							<p class="tc-voice-author">{voice.author}</p>
						</div>
					))
				}
				<div class="tc-chat-foot">
					<button type="button" class="tc-btn" data-voice-play>Прослушать отзыв</button>
					<span class="tc-state" data-voice-state>готов</span>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- ══ T5 «ПОЛНЫЙ ЭКРАН» ════════════════════════════════════════════ -->
<section id="tc-t5" class="tc tc-full" data-concept="t5">
	<div class="tc-full-stage" data-full-stage>
		{
			reviews.map((review, index) => (
				<article class="tc-full-item" data-full-item={index}>
					<span class="tc-monogram tc-monogram--big" aria-hidden="true">{review.monogram}</span>
					<blockquote class="tc-full-text">«{review.text}»</blockquote>
					<p class="tc-full-author">{review.author}</p>
				</article>
			))
		}
		<div class="tc-full-nav">
			<button type="button" class="tc-btn" data-full-prev>←</button>
			<span class="tc-dots" data-full-dots role="tablist" aria-label="Отзывы">
				{reviews.map((review, index) => <button type="button" class="tc-dot" data-full-dot={index} role="tab" aria-label={review.short} aria-selected={index === 0} />)}
			</span>
			<button type="button" class="tc-btn" data-full-next>→</button>
			<span class="tc-state" data-full-state>1 / {reviews.length}</span>
		</div>
	</div>
</section>

<style>
	/* ── Общее ──────────────────────────────────────────────────────── */
	.tc {
		position: relative;
		border-bottom: 1px solid var(--border);
		padding: 32px 24px;
	}
	@media (min-width: 1024px) {
		.tc { padding: 40px 32px; }
	}
	.tc-inner { margin: 0 auto; max-width: 1400px; }
	.tc-head { max-width: 1400px; }
	.tc-label {
		font-family: var(--font-label);
		font-size: var(--text-label);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.tc-title {
		margin-top: 24px;
		max-width: 14ch;
		font-size: var(--text-h2);
		line-height: 0.98;
		letter-spacing: -0.045em;
		text-transform: uppercase;
		color: var(--text);
	}
	.tc-hint {
		margin-top: 14px;
		font-family: var(--font-label);
		font-size: var(--text-label);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent-warm);
	}
	.tc-monogram {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border: 1px solid var(--border);
		font-family: var(--font-display);
		font-size: 15px;
		color: var(--accent);
	}
	.tc-monogram--big {
		width: 72px;
		height: 72px;
		font-size: 30px;
	}
	.tc-btn {
		min-height: 44px;
		padding: 10px 16px;
		border: 1px solid var(--border);
		background: transparent;
		font-family: var(--font-label);
		font-size: var(--text-label);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text);
		cursor: pointer;
		transition: border-color 200ms cubic-bezier(0.33, 1, 0.68, 1), color 200ms cubic-bezier(0.33, 1, 0.68, 1);
	}
	.tc-btn:hover { border-color: var(--accent); color: var(--accent); }
	.tc-btn--quiet { color: var(--text-muted); }
	.tc-state {
		font-family: var(--font-label);
		font-size: var(--text-label);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.tc-chat-foot {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-top: 20px;
	}

	/* ── T1 Лента ───────────────────────────────────────────────────── */
	.tc-tape-scene { position: relative; }
	@media (min-width: 1024px) {
		.tc-tape-scene { height: 280vh; }
		.tc-tape-sticky {
			position: sticky;
			top: 0;
			display: flex;
			flex-direction: column;
			justify-content: center;
			height: 100svh;
			overflow: hidden;
		}
	}
	.tc-tape-track {
		margin-top: 40px;
		display: flex;
		gap: 24px;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.tc-tape-track::-webkit-scrollbar { display: none; }
	@media (min-width: 1024px) {
		.tc-tape-track {
			margin-top: 56px;
			overflow: visible;
			width: max-content;
			will-change: transform;
		}
	}
	.tc-quote {
		flex: none;
		width: 78vw;
		border: 1px solid var(--border);
		padding: 32px;
		background: color-mix(in srgb, var(--bg-deep) 70%, transparent);
		transition: border-color 320ms cubic-bezier(0.33, 1, 0.68, 1);
	}
	@media (min-width: 1024px) {
		.tc-quote { width: 46vw; padding: 40px; }
		.tc-quote:hover { border-color: var(--accent); }
	}
	.tc-quote-text {
		font-size: var(--text-body);
		line-height: 1.6;
		color: var(--text);
	}
	.tc-quote-author {
		margin-top: 28px;
		display: flex;
		align-items: center;
		gap: 12px;
		font-family: var(--font-label);
		font-size: var(--text-label);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	/* ── T2 Живая стена ─────────────────────────────────────────────── */
	.tc-wall-plane {
		position: relative;
		margin-top: 40px;
		display: grid;
		gap: 20px;
	}
	@media (min-width: 1024px) {
		.tc-wall-plane {
			display: block;
			height: 92vh;
			margin-top: 0;
		}
	}
	.tc-wall-card {
		border: 1px solid var(--border);
		padding: 28px;
		background: color-mix(in srgb, var(--bg-deep) 78%, transparent);
		transition: border-color 320ms cubic-bezier(0.33, 1, 0.68, 1), opacity 320ms cubic-bezier(0.33, 1, 0.68, 1);
	}
	@media (min-width: 1024px) {
		.tc-wall-card {
			position: absolute;
			left: var(--wx);
			top: var(--wy);
			width: 30vw;
			max-width: 420px;
			will-change: transform;
		}
		.tc-wall-card[data-near] {
			border-color: var(--accent);
			z-index: 3;
		}
		.tc-wall-card[data-far] { opacity: 0.55; }
	}
	.tc-wall-text {
		font-size: var(--text-body);
		line-height: 1.6;
		color: var(--text);
	}
	.tc-wall-author {
		margin-top: 20px;
		display: flex;
		align-items: center;
		gap: 12px;
		font-family: var(--font-label);
		font-size: var(--text-label);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	/* ── T3 Разговор ────────────────────────────────────────────────── */
	.tc-chat {
		margin-top: 40px;
		max-width: 820px;
	}
	.tc-chat-log {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.tc-bubble {
		max-width: 82%;
		border: 1px solid var(--border);
		padding: 18px 20px;
		background: color-mix(in srgb, var(--bg-deep) 72%, transparent);
	}
	.tc-bubble--answer { align-self: flex-start; }
	.tc-bubble--ask {
		align-self: flex-end;
		border-color: color-mix(in srgb, var(--accent-warm) 45%, var(--border));
	}
	.tc-bubble-who {
		font-family: var(--font-label);
		font-size: var(--text-label);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.tc-bubble--ask .tc-bubble-who { color: var(--accent-warm); }
	.tc-bubble-text {
		margin-top: 10px;
		font-size: var(--text-body);
		line-height: 1.55;
		color: var(--text);
	}
	/* Без скрипта все реплики видны — чат читается как расшифровка. */
	.tc[data-js] .tc-bubble {
		opacity: 0;
		transform: translateY(14px);
		transition: opacity 420ms cubic-bezier(0.33, 1, 0.68, 1), transform 420ms cubic-bezier(0.33, 1, 0.68, 1);
	}
	.tc[data-js] .tc-bubble[data-shown] { opacity: 1; transform: none; }
	.tc-typing { display: none; gap: 5px; padding: 14px 18px; border: 1px dashed var(--border); width: max-content; }
	.tc[data-js] .tc-typing[data-on] { display: flex; }
	.tc-typing span {
		width: 6px; height: 6px; border-radius: 50%;
		background: var(--text-muted);
		animation: tc-blink 1.1s infinite ease-in-out;
	}
	.tc-typing span:nth-child(2) { animation-delay: 0.15s; }
	.tc-typing span:nth-child(3) { animation-delay: 0.3s; }
	@keyframes tc-blink {
		0%, 80%, 100% { opacity: 0.25; }
		40% { opacity: 1; }
	}

	/* ── T4 Голос ───────────────────────────────────────────────────── */
	.tc-voice-body { margin-top: 40px; }
	.tc-voice-pick { display: flex; flex-wrap: wrap; gap: 10px; }
	.tc-pick {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-height: 48px;
		padding: 8px 16px 8px 8px;
		border: 1px solid var(--border);
		background: transparent;
		font-family: var(--font-label);
		font-size: var(--text-label);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-muted);
		cursor: pointer;
	}
	.tc-pick[aria-pressed='true'] { border-color: var(--accent); color: var(--text); }
	.tc-voice-stage { margin-top: 28px; }
	/* Без скрипта виден первый отзыв, остальные — друг под другом. */
	.tc-voice-item { margin-top: 28px; }
	.tc-voice-item[data-hidden] { display: none; }
	.tc-voice-text {
		max-width: 62ch;
		font-size: 1.375rem;
		line-height: 1.5;
		color: var(--text-muted);
	}
	.tc-word { transition: color 260ms cubic-bezier(0.33, 1, 0.68, 1); }
	.tc-word[data-spoken] { color: var(--text); }
	.tc-word::after { content: ' '; }
	.tc-wave {
		margin-top: 28px;
		display: flex;
		align-items: flex-end;
		gap: 3px;
		height: 72px;
	}
	.tc-bar {
		flex: 1 1 0;
		height: var(--h);
		background: color-mix(in srgb, var(--text-muted) 45%, transparent);
		transition: background-color 200ms linear, height 200ms linear;
	}
	.tc-bar[data-played] { background: var(--accent); }
	.tc-voice-author {
		margin-top: 20px;
		font-family: var(--font-label);
		font-size: var(--text-label);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	/* ── T5 Полный экран ────────────────────────────────────────────── */
	.tc-full-stage {
		position: relative;
		margin: 0 auto;
		max-width: 1400px;
		min-height: 60vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.tc-full-item { display: grid; gap: 28px; justify-items: start; }
	.tc[data-js] .tc-full-item {
		position: absolute;
		inset: 0;
		align-content: center;
		opacity: 0;
		pointer-events: none;
		transition: opacity 520ms cubic-bezier(0.33, 1, 0.68, 1), transform 520ms cubic-bezier(0.33, 1, 0.68, 1);
		transform: translateY(18px);
	}
	.tc[data-js] .tc-full-item[data-shown] { opacity: 1; pointer-events: auto; transform: none; }
	.tc-full-text {
		max-width: 34ch;
		font-family: var(--font-manifest);
		font-size: clamp(1.5rem, 2.6vw, 2.6rem);
		line-height: 1.18;
		letter-spacing: -0.02em;
		color: var(--text);
	}
	.tc-full-author {
		font-family: var(--font-label);
		font-size: var(--text-label);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.tc-full-nav {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-top: 40px;
	}
	.tc-dots { display: inline-flex; gap: 8px; }
	.tc-dot {
		width: 34px;
		height: 3px;
		border: 0;
		padding: 0;
		background: var(--border);
		cursor: pointer;
	}
	.tc-dot[aria-selected='true'] { background: var(--accent); }

	/* ── Reduced motion ─────────────────────────────────────────────── */
	@media (prefers-reduced-motion: reduce) {
		.tc-tape-scene { height: auto !important; }
		.tc-tape-sticky { position: static !important; height: auto !important; }
		.tc-tape-track { transform: none !important; }
		.tc-wall-card,
		.tc-quote,
		.tc-bubble,
		.tc-word,
		.tc-bar,
		.tc-full-item {
			transition: none !important;
			transform: none !important;
			opacity: 1 !important;
		}
		.tc-typing { display: none !important; }
		.tc[data-js] .tc-bubble { opacity: 1 !important; transform: none !important; }
		.tc[data-js] .tc-full-item { position: static !important; opacity: 1 !important; }
	}
</style>

<script>
	/* Пять концепций — пять независимых модулей. Каждый умеет boot() (включить)
	   и reset() (вернуть в «плоское» состояние, когда концепцию скрыли). */
	type Boot = { boot: () => void; reset: () => void };
	type Win = Window & { __tcBoot?: Record<string, Boot> };
	const win = window as Win;
	win.__tcBoot = win.__tcBoot || {};
	const reduceQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
	const sec = (id: string) => document.getElementById(id) as HTMLElement | null;

	/* ── T1 Лента: вертикальный скролл гонит ленту вбок (scroll-linked) ── */
	(() => {
		let wired = false;
		let queued = false;
		const frame = () => {
			const s = sec('tc-t1');
			if (!s || reduceQuery.matches) return;
			const scene = s.querySelector<HTMLElement>('[data-tape-scene]');
			const track = s.querySelector<HTMLElement>('[data-tape-track]');
			if (!scene || !track || window.innerWidth < 1024) return;
			const box = scene.getBoundingClientRect();
			const span = Math.max(1, box.height - window.innerHeight);
			const progress = Math.min(1, Math.max(0, -box.top / span));
			const distance = Math.max(0, track.scrollWidth - window.innerWidth + 64);
			track.style.transform = `translate3d(${-progress * distance}px, 0, 0)`;
		};
		const onScroll = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(() => { queued = false; frame(); });
		};
		win.__tcBoot.t1 = {
			boot() {
				const s = sec('tc-t1');
				if (!s || reduceQuery.matches) return;
				s.setAttribute('data-js', '');
				if (!wired) {
					wired = true;
					window.addEventListener('scroll', onScroll, { passive: true });
					window.addEventListener('resize', onScroll);
				}
				frame();
			},
			reset() {
				const s = sec('tc-t1');
				if (!s) return;
				s.removeAttribute('data-js');
				const track = s.querySelector<HTMLElement>('[data-tape-track]');
				if (track) track.style.transform = '';
			},
		};
	})();

	/* ── T2 Живая стена: дрейф карточек + параллакс по скроллу ───────── */
	(() => {
		let wired = false;
		let t0 = performance.now();
		let raf = 0;
		const frame = () => {
			const s = sec('tc-t2');
			if (!s || reduceQuery.matches || window.innerWidth < 1024) return;
			const cards = Array.from(s.querySelectorAll<HTMLElement>('[data-wall-card]'));
			const box = s.getBoundingClientRect();
			const vh = window.innerHeight;
			const scrollProgress = Math.min(1, Math.max(0, (vh - box.top) / (box.height + vh)));
			const time = (performance.now() - t0) / 1000;
			cards.forEach((card, index) => {
				const depth = index + 1;
				const drift = Math.sin(time * 0.28 + index * 1.7) * (6 * depth);
				const parallax = (scrollProgress - 0.5) * -46 * depth;
				card.style.transform = `translate3d(0, ${(drift + parallax).toFixed(2)}px, 0)`;
				const rect = card.getBoundingClientRect();
				const center = rect.top + rect.height / 2;
				card.toggleAttribute('data-near', Math.abs(center - vh / 2) < vh * 0.28);
				card.toggleAttribute('data-far', Math.abs(center - vh / 2) > vh * 0.36);
			});
			raf = requestAnimationFrame(frame);
		};
		win.__tcBoot.t2 = {
			boot() {
				const s = sec('tc-t2');
				if (!s || reduceQuery.matches) return;
				s.setAttribute('data-js', '');
				if (!wired) { wired = true; t0 = performance.now(); }
				cancelAnimationFrame(raf);
				raf = requestAnimationFrame(frame);
			},
			reset() {
				const s = sec('tc-t2');
				if (!s) return;
				cancelAnimationFrame(raf);
				raf = 0;
				s.removeAttribute('data-js');
				s.querySelectorAll<HTMLElement>('[data-wall-card]').forEach((card) => {
					card.style.transform = '';
					card.removeAttribute('data-near');
					card.removeAttribute('data-far');
				});
			},
		};
	})();

	/* ── T3 Разговор: реплики по одной, клик/Enter ───────────────────── */
	(() => {
		let shown = 0;
		let timer = 0;
		const total = () => sec('tc-t3')?.querySelectorAll('[data-bubble]').length ?? 0;
		const paint = () => {
			const s = sec('tc-t3');
			if (!s) return;
			const bubbles = Array.from(s.querySelectorAll<HTMLElement>('[data-bubble]'));
			const typing = s.querySelector<HTMLElement>('[data-typing]');
			const state = s.querySelector<HTMLElement>('[data-chat-state]');
			bubbles.forEach((bubble, index) => bubble.toggleAttribute('data-shown', index < shown));
			typing?.toggleAttribute('data-on', shown > 0 && shown < bubbles.length);
			if (state) state.textContent = `${shown} / ${bubbles.length}`;
		};
		const next = () => {
			const s = sec('tc-t3');
			if (!s) return;
			if (shown >= total()) return;
			/* «Печатает…» показывается на 700 мс, потом появляется реплика. */
			const typing = s.querySelector<HTMLElement>('[data-typing]');
			typing?.setAttribute('data-on', '');
			window.clearTimeout(timer);
			timer = window.setTimeout(() => { shown += 1; paint(); }, reduceQuery.matches ? 0 : 700);
		};
		win.__tcBoot.t3 = {
			boot() {
				const s = sec('tc-t3');
				if (!s || reduceQuery.matches) return;
				s.setAttribute('data-js', '');
				s.addEventListener('click', (event) => {
					const target = event.target as HTMLElement;
					if (target.closest('[data-chat-next]')) { next(); return; }
					if (target.closest('[data-chat-reset]')) { shown = 0; paint(); return; }
					if (target.closest('.tc-chat')) next();
				});
				s.addEventListener('keydown', (event) => {
					if ((event as KeyboardEvent).key === 'Enter' || (event as KeyboardEvent).key === ' ') {
						event.preventDefault();
						next();
					}
				});
				s.tabIndex = 0;
				shown = 0;
				paint();
				next();
			},
			reset() {
				const s = sec('tc-t3');
				if (!s) return;
				window.clearTimeout(timer);
				shown = 0;
				s.removeAttribute('data-js');
				s.querySelectorAll<HTMLElement>('[data-bubble]').forEach((b) => b.removeAttribute('data-shown'));
				s.querySelector('[data-typing]')?.removeAttribute('data-on');
			},
		};
	})();

	/* ── T4 Голос: дорожка «проигрывает» отзыв ──────────────────────── */
	(() => {
		let index = 0;
		let raf = 0;
		const paint = (value: number) => {
			const s = sec('tc-t4');
			if (!s) return;
			const items = Array.from(s.querySelectorAll<HTMLElement>('[data-voice-item]'));
			items.forEach((item, i) => item.toggleAttribute('data-hidden', i !== index));
			const item = items[index];
			if (!item) return;
			const bars = Array.from(item.querySelectorAll<HTMLElement>('.tc-bar'));
			const words = Array.from(item.querySelectorAll<HTMLElement>('.tc-word'));
			const played = Math.round(value * bars.length);
			const spoken = Math.round(value * words.length);
			bars.forEach((bar, i) => bar.toggleAttribute('data-played', i < played));
			words.forEach((word, i) => word.toggleAttribute('data-spoken', i < spoken));
			const state = s.querySelector<HTMLElement>('[data-voice-state]');
			if (state) state.textContent = value <= 0 ? 'готов' : value >= 1 ? 'прослушано' : `идёт ${Math.round(value * 100)} %`;
		};
		const play = () => {
			const s = sec('tc-t4');
			if (!s) return;
			cancelAnimationFrame(raf);
			if (reduceQuery.matches) { paint(1); return; }
			const start = performance.now();
			const duration = 6000;
			const step = (now: number) => {
				const value = Math.min(1, (now - start) / duration);
				paint(value);
				if (value < 1) raf = requestAnimationFrame(step);
			};
			raf = requestAnimationFrame(step);
		};
		const pick = (next: number) => {
			index = next;
			const s = sec('tc-t4');
			s?.querySelectorAll<HTMLButtonElement>('[data-voice-pick]').forEach((button, i) => button.setAttribute('aria-pressed', String(i === index)));
			cancelAnimationFrame(raf);
			paint(0);
		};
		win.__tcBoot.t4 = {
			boot() {
				const s = sec('tc-t4');
				if (!s) return;
				s.setAttribute('data-js', '');
				s.addEventListener('click', (event) => {
					const target = event.target as HTMLElement;
					const pickButton = target.closest<HTMLElement>('[data-voice-pick]');
					if (pickButton) { pick(Number(pickButton.dataset.voicePick)); return; }
					if (target.closest('[data-voice-play]')) play();
				});
				pick(0);
			},
			reset() {
				const s = sec('tc-t4');
				if (!s) return;
				cancelAnimationFrame(raf);
				raf = 0;
				s.removeAttribute('data-js');
				s.querySelectorAll<HTMLElement>('[data-hidden]').forEach((item) => item.removeAttribute('data-hidden'));
				s.querySelectorAll<HTMLElement>('.tc-bar').forEach((bar) => bar.removeAttribute('data-played'));
				s.querySelectorAll<HTMLElement>('.tc-word').forEach((word) => word.removeAttribute('data-spoken'));
			},
		};
	})();

	/* ── T5 Полный экран: один отзыв, клавиши и точки ───────────────── */
	(() => {
		let index = 0;
		const paint = () => {
			const s = sec('tc-t5');
			if (!s) return;
			const items = Array.from(s.querySelectorAll<HTMLElement>('[data-full-item]'));
			const dots = Array.from(s.querySelectorAll<HTMLElement>('[data-full-dot]'));
			items.forEach((item, i) => item.toggleAttribute('data-shown', i === index));
			dots.forEach((dot, i) => dot.setAttribute('aria-selected', String(i === index)));
			const state = s.querySelector<HTMLElement>('[data-full-state]');
			if (state) state.textContent = `${index + 1} / ${items.length}`;
		};
		win.__tcBoot.t5 = {
			boot() {
				const s = sec('tc-t5');
				if (!s || reduceQuery.matches) return;
				s.setAttribute('data-js', '');
				const items = () => s.querySelectorAll('[data-full-item]').length;
				s.addEventListener('click', (event) => {
					const target = event.target as HTMLElement;
					if (target.closest('[data-full-next]')) { index = (index + 1) % items(); paint(); return; }
					if (target.closest('[data-full-prev]')) { index = (index - 1 + items()) % items(); paint(); return; }
					const dot = target.closest<HTMLElement>('[data-full-dot]');
					if (dot) { index = Number(dot.dataset.fullDot); paint(); }
				});
				s.addEventListener('keydown', (event) => {
					const key = (event as KeyboardEvent).key;
					if (key === 'ArrowRight') { event.preventDefault(); index = (index + 1) % items(); paint(); }
					else if (key === 'ArrowLeft') { event.preventDefault(); index = (index - 1 + items()) % items(); paint(); }
				});
				s.tabIndex = 0;
				index = 0;
				paint();
			},
			reset() {
				const s = sec('tc-t5');
				if (!s) return;
				s.removeAttribute('data-js');
				s.querySelectorAll<HTMLElement>('[data-shown]').forEach((item) => item.removeAttribute('data-shown'));
			},
		};
	})();

	/* Автозапуск той концепции, что уже выбрана в адресе/панели. */
	const active = document.documentElement.dataset.tc;
	if (active && win.__tcBoot[active]) win.__tcBoot[active].boot();
</script>
