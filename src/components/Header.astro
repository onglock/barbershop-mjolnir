---
// Шапка: фиксированная, прозрачная на первом экране, с волосяной линией
// и матовым стеклом после прокрутки. Статика — JS только на смену состояния.
import HammerButton from './HammerButton.astro';
import HeaderMenu from './HeaderMenu';

const links = [
	{ href: '#services', label: 'Услуги' },
	{ href: '#masters', label: 'Мастера' },
	{ href: '#reviews', label: 'Отзывы' },
	{ href: '#faq', label: 'Вопросы' },
	{ href: '#contact', label: 'Контакты' },
];

// Классы кнопки берём из того же варианта, что и <Button>, но применяем к <a>:
// вариант радикс-Slot (`asChild`) не сливает props при SSR из .astro, потому что
// дети приходят как слот Astro и Slot получает не единственный элемент.
---

<header
	data-header
	class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-300 ease-hover"
>
	<div class="mx-auto flex h-16 max-w-[1400px] items-center justify-between gap-6 px-6 lg:h-[72px] lg:px-8">
		<!-- Логотип -->
		<a href="#top" class="group flex shrink-0 items-baseline gap-2" aria-label="Мьёльнир — на главную">
			<span class="font-display text-xl font-semibold uppercase tracking-[-0.045em] text-text transition-colors duration-200 ease-hover group-hover:text-accent">
				Мьёльнир
			</span>
			<span class="hidden font-label text-label uppercase text-text-muted sm:block">барбершоп</span>
		</a>

		<!-- Навигация: только десктоп -->
		<nav class="hidden items-center gap-8 lg:flex" aria-label="Основная навигация">
			{
				links.map((link) => (
					<a
						href={link.href}
						class="group relative flex items-center py-4 font-label text-label uppercase text-text-muted transition-colors duration-200 ease-hover hover:text-text"
					>
						{link.label}
						<span class="absolute -bottom-1 left-0 h-px w-full origin-left scale-x-0 bg-accent transition-transform duration-300 ease-hover group-hover:scale-x-100" />
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-4">
			<!-- TODO: заменить на реальные контакты -->
			<a
				href="tel:+74951234567"
				class="hidden items-center py-4 font-label text-label uppercase text-text-muted transition-colors duration-200 ease-hover hover:text-text xl:flex"
			>
				+7 (495) 123-45-67
			</a>

			<!-- Кнопка «Записаться»: в Hero её нет, появляется на первой секции
			     после Hero (§10.2, логика — lib/headerCta.ts). Эффектов нет:
			     обычный CTA-стиль и скролл к форме. Слот общий для двух
			     вариантов оформления — на широком экране подпись, на узком
			     только молот. -->
			<div data-header-cta class="cta-slot">
				<div class="hidden sm:block">
					<HammerButton variant="v1" />
				</div>
				<div class="sm:hidden">
					<HammerButton variant="v2" compact />
				</div>
			</div>

			<!-- Бургер + полноэкранное меню: остров, грузится по idle -->
			<HeaderMenu links={links} client:idle />
		</div>
	</div>
</header>

<script>
	import { initHeaderCta } from '../lib/headerCta';

	/* Кнопка «Записаться»: в Hero её нет, появляется на секции после Hero
	   (Manifest) и снова прячется при возврате к Hero. Ни магнита, ни звука,
	   ни ритуала у кнопки больше нет (§10.2, правка 2026-09-24). */
	initHeaderCta();

	const header = document.querySelector('[data-header]');
	if (header) {
		const sync = () => {
			header.toggleAttribute('data-scrolled', window.scrollY > 24);
		};
		sync();
		window.addEventListener('scroll', sync, { passive: true });
	}
</script>

<style>
	/* Safe area (mobile-first §10): на устройствах с вырезом и в ландшафте
	   fixed-шапка иначе заезжает под статус-бар. В обычном Safari значение
	   env(safe-area-inset-top) равно 0, поэтому на десктопе и телефоне без
	   выреза правка ничего не меняет. */
	header[data-header] {
		padding-top: env(safe-area-inset-top, 0px);
	}

	/* Матовое стекло только на десктопе: на мобильных backdrop-filter
	   на всю ширину шапки заметно бьёт по fps. */
	header[data-scrolled] {
		background-color: var(--bg-deep);
		border-bottom-color: var(--border);
	}

	@media (min-width: 1024px) {
		header[data-scrolled] {
			background-color: color-mix(in oklab, var(--bg) 85%, transparent);
			backdrop-filter: blur(12px);
		}
	}
</style>
