---
// «Обучение» — три тарифа курсов. БОЕВАЯ ВЕРСИЯ, параметры зафиксированы
// решениями Кирилла (2026-09-25):
//   • выделена правая карточка «Премиум»: граница --accent (сталь), фон --surface, подъём −10 px;
//   • плашка «Премиум» — в стали, статична (никуда не переезжает);
//   • появление карточек при входе в кадр с разносом 90 мс; при reduce — без анимации.
// Переключателей вариантов здесь нет: развилки остались в снимке
// src/components/preview/TrainingVariants.astro для страницы /training-preview.
//
// Без JS контент читается целиком: скрытое стартовое состояние проявления
// включает ТОЛЬКО скрипт (атрибут data-rv), в SSR-разметке его нет.
import { training, type TrainingPlan } from '../lib/training';

interface Props {
	/** Якорь секции. Пропом — чтобы превью не ломало id боевой секции. */
	sectionId?: string;
}

const { sectionId = 'training' } = Astro.props;

/** Выделенный тариф — правая карточка «Премиум» (решение Кирилла). */
const FEATURED = 'premium';
---

<section
	id={sectionId}
	class="training scroll-mt-24 border-b border-border px-6 py-8 lg:px-8 lg:py-10"
>
	<div class="mx-auto max-w-[1400px]">
		<p class="font-label text-label uppercase text-text-muted">{training.eyebrow}</p>

		<h2 class="mt-6 max-w-[16ch] text-h2 uppercase text-text">{training.heading}</h2>

		<p class="mt-6 max-w-[64ch] text-body text-text-muted">{training.lead}</p>

		<div class="mt-10 grid gap-6 lg:grid-cols-3">
			{
				training.plans.map((plan: TrainingPlan) => (
					<article class={`tr-item${plan.id === FEATURED ? ' is-featured' : ''}`} data-plan={plan.id}>
						<div class="tr-card flex h-full flex-col border border-border">
							{/* Плашка — только у тарифа, у которого она объявлена в данных. */}
							{plan.badge && <span class="tr-badge font-label text-label uppercase">{plan.badge}</span>}

							<div class="flex flex-1 flex-col p-6 lg:p-7">
								<p class="font-label text-label uppercase text-text-muted">{plan.step}</p>

								<p class="mt-5 flex items-baseline gap-3">
									<span class="tr-price font-display text-text">{plan.price}</span>
									<span class="font-label text-label uppercase text-text-muted">{plan.unit}</span>
								</p>

								<h3 class="tr-name mt-4 font-display uppercase text-text">{plan.name}</h3>

								<p class="mt-4 text-body text-text-muted">{plan.description}</p>

								<ul class="mt-6 space-y-3">
									{plan.features.map((feature) => (
										<li class="flex gap-3 text-body text-text">
											{/* Галочка — SVG в акцентном цвете. Разметку нельзя вынести
											    в frontmatter const: там обычный TS, JSX не парсится. */}
											<svg
												class="tr-check"
												viewBox="0 0 16 16"
												fill="none"
												aria-hidden="true"
												focusable="false"
											>
												<path
													d="M2.5 8.5 6 12l7.5-8"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="square"
												/>
											</svg>
											<span>{feature}</span>
										</li>
									))}
								</ul>
							</div>
						</div>
					</article>
				))
			}
		</div>

		<p class="mt-8 font-label text-label uppercase text-text-muted">{training.footnote}</p>
	</div>
</section>

<style>
	/* Размеры цены и названия тарифа — КОМПОНЕНТНЫЕ (уровень 3 токенов).
	   Шкала сайта — три размера (display / h2 / body / label), и ни один из
	   них не годится внутри карточки: text-h2 на 1280 это 83 px. */
	.tr-price {
		font-size: clamp(2rem, 3.4vw, 2.75rem);
		line-height: 1;
		letter-spacing: -0.03em;
		font-weight: 600;
	}
	.tr-name {
		font-size: clamp(1.375rem, 2.1vw, 1.75rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		font-weight: 600;
	}

	.tr-check {
		flex: 0 0 auto;
		width: 16px;
		height: 16px;
		margin-top: 0.28em;
		color: var(--accent);
	}

	/* Плашка выделенного тарифа: сталь, статична. */
	.tr-badge {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 30px;
		padding: 0 12px;
		background: var(--accent);
		color: var(--bg-deep);
	}

	.tr-card {
		transition:
			transform 300ms var(--ease-hover),
			border-color 300ms var(--ease-hover),
			background-color 300ms var(--ease-hover);
	}

	/* ── Выделенная карточка (правая, «Премиум») ───────────────────── */
	.tr-item.is-featured .tr-card {
		background-color: var(--surface);
		border-color: var(--accent);
	}

	/* Подъём — только на десктопе: на 390 карточки идут столбиком, и подъём
	   читался бы как сломанный зазор. */
	@media (min-width: 1024px) {
		.tr-item.is-featured .tr-card {
			transform: translateY(-10px);
		}
	}

	/* Наведение — как у соседних секций (Masters, Services). На выделенной
	   карточке не меняем ничего: она уже акцентная, второй акцент читался бы
	   как ошибка. */
	@media (hover: hover) and (min-width: 1024px) {
		.tr-item:hover .tr-card {
			transform: translateY(-4px);
			border-color: var(--accent);
		}
		.tr-item.is-featured:hover .tr-card {
			transform: translateY(-10px);
		}
	}

	/* ── Проявление карточек ──────────────────────────────────────────
	   Скрытое стартовое состояние включает ТОЛЬКО скрипт (data-rv) — без JS
	   карточки видны сразу. Разнос по времени — 90 мс на карточку. */
	.training[data-rv='ready'] .tr-item {
		opacity: 0;
		transform: translateY(18px);
		transition:
			opacity 620ms var(--ease-hover),
			transform 620ms var(--ease-hover);
	}
	.training[data-rv='ready'] .tr-item:nth-child(2) {
		transition-delay: 90ms;
	}
	.training[data-rv='ready'] .tr-item:nth-child(3) {
		transition-delay: 180ms;
	}
	.training[data-rv='ready'] .tr-item.is-in {
		opacity: 1;
		transform: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.tr-item {
			opacity: 1 !important;
			transform: none !important;
			transition: none !important;
			transition-delay: 0ms !important;
		}
		.tr-card {
			transition: none !important;
		}
	}
	/* Подъём выделенной карточки — это раскладка, а не движение: при reduce он
	   остаётся, иначе выделение держится только цветом. */
	@media (prefers-reduced-motion: reduce) and (min-width: 1024px) {
		.tr-item.is-featured .tr-card {
			transform: translateY(-10px) !important;
		}
	}
</style>

<script>
	/* Проявление карточек при входе в кадр. Корень ищем по КЛАССУ, а не по id:
	   на превью-странице рядом может стоять вторая копия секции.
	   Скрытый старт включаем ПОСЛЕ первого кадра: иначе браузер склеит
	   стартовое и конечное состояния в один стиль и анимации не будет. */
	document.querySelectorAll<HTMLElement>('section.training').forEach((section) => {
		const items = [...section.querySelectorAll<HTMLElement>('.tr-item')];
		if (!items.length) return;

		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			items.forEach((item) => item.classList.add('is-in'));
			return;
		}

		section.dataset.rv = 'ready';
		requestAnimationFrame(() => {
			const observer = new IntersectionObserver(
				(entries, obs) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						entry.target.classList.add('is-in');
						obs.unobserve(entry.target);
					});
				},
				{ threshold: 0.15 },
			);
			items.forEach((item) => observer.observe(item));
		});
	});
</script>
