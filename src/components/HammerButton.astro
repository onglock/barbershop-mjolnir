---
/**
 * Кнопка-молот для шапки (§10.2).
 *
 * Три варианта оформления — `variant`: v1 «силуэт + подпись», v2 «только молот»,
 * v3 «молот как подложка». Выбор варианта — один проп.
 *
 * Эффектов у кнопки нет: ни магнита, ни звука, ни ритуала. Остался обычный
 * hover-стиль как у остальных CTA (цвет + подъём) и скролл к форме по клику —
 * это обычная ссылка на `#contact`, якорь перехватывает Lenis. Появление и
 * скрытие при прокрутке живёт не здесь, а в шапке (`data-header-cta`).
 */

const props = Astro.props;
const variant = props.variant || 'v1';
const compact = props.compact || false;
const label = props.label || 'Записаться';
const ctaHref = props.href || '#contact';
const extra = props.class || '';

const hammer = (size, cls) =>
  `<svg viewBox="0 0 24 24" width="${size}" height="${size}" class="${cls}" aria-hidden="true" fill="currentColor">
    <path d="M3.6 5.2h16.8c.5 0 .9.4.85.9l-.65 5.1c-.06.45-.44.8-.9.8H4.3c-.46 0-.84-.35-.9-.8l-.65-5.1c-.05-.5.34-.9.85-.9Z" />
    <path d="M10.7 12h2.6v7.1c0 .9-.6 1.6-1.3 1.6s-1.3-.7-1.3-1.6V12Z" />
  </svg>`;

const base =
  'inline-flex min-h-12 items-center border border-border text-text transition-all duration-200 ease-hover hover:border-accent-warm hover:text-accent-warm hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 motion-reduce:hover:translate-y-0';
---

<a
  href={ctaHref}
  class:list={[
    base,
    compact && 'h-11 w-11 min-h-11 min-w-11 justify-center',
    !compact && variant === 'v1' && 'gap-2.5 px-4',
    !compact && variant === 'v2' && 'px-3.5',
    !compact && variant === 'v3' && 'relative overflow-hidden px-6',
    extra
  ]}
  aria-label={compact ? label : undefined}
>
  {
    compact ? (
      <>
        <span set:html={hammer(22, '')} />
        <span class="sr-only">{label}</span>
      </>
    ) : variant === 'v3' ? (
      <>
        <span class="pointer-events-none absolute -left-2 top-1/2 -translate-y-1/2 opacity-[0.16]" set:html={hammer(46, '')} />
        <span class="relative pl-5 font-display text-[13px] uppercase tracking-[0.16em]">{label}</span>
      </>
    ) : (
      <>
        <span class:list={['shrink-0', variant === 'v1' && 'opacity-70']} set:html={hammer(variant === 'v1' ? 20 : 22, '')} />
        <span class:list={['font-display text-[13px] uppercase tracking-[0.14em]', variant === 'v1' && 'ml-2.5']}>
          {label}
        </span>
      </>
    )
  }
</a>
