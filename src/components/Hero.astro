---
// Hero: кадр на всю высоту. Слои снизу вверх:
//   0 — затемняющие градиенты, 1 — 3D-молот (десктоп),
//   2 — текстовая сцена входа + индикатор скролла.
// Градиенты не перехватывают курсор.
// Видео-дыма больше нет (решение Кирилла 2026-09-22): убрано вместе с файлом
// hero-bg.mp4 на 2,1 МБ, фон держат градиенты и свет из Hero3D.
import Hero3D from './Hero3D';
import HeroHammer from './HeroHammer.astro';
import HeroIntro from './HeroIntro';
---

<section
	id="top"
	class="relative h-[100svh] min-h-[560px] w-full overflow-hidden border-b border-border lg:h-[100dvh]"
>
	<!-- Слой 0: затемнение. Вертикальный лёгкий (0.35→0.6), горизонтальный
	     держит тёмной левую треть под заголовок и сходит в ноль правее 85%. -->
	<div
		class="pointer-events-none absolute inset-0 z-[1]"
		style="background-image: linear-gradient(180deg, rgba(6,10,14,0.35) 0%, rgba(6,10,14,0.3) 45%, rgba(6,10,14,0.6) 100%), linear-gradient(90deg, rgba(6,10,14,0.85) 0%, rgba(6,10,14,0.6) 35%, rgba(6,10,14,0.15) 55%, rgba(6,10,14,0) 85%);"
	>
	</div>

	<!-- Слой 1: молот на мобильных. Тот же кадр, что рисует 3D, но картинкой:
	     на 390 остров three.js не грузится, и подложку держит этот слой.
	     Позиция зафиксирована под будущий прилёт (константы в компоненте). -->
	<HeroHammer />

	<!-- Слой 2: 3D-молот. client:media — на мобильных остров вообще не загружается -->
	<Hero3D client:media="(min-width: 1024px)" />

	<!-- Слой 3: сцена входа -->
	<HeroIntro client:load />
</section>

<noscript>
	<!-- Без JS сцена входа не проигрывается, а в SSR-разметке лежат её
	     стартовые стили. Принудительно показываем текст в конечном виде. -->
	<style>
		#top p,
		#top h1 span span,
		#top a {
			opacity: 1 !important;
			filter: none !important;
			transform: none !important;
		}
	</style>
</noscript>
