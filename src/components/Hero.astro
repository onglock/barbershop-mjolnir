---
// Hero: кадр на всю высоту. Слои снизу вверх:
//   0 — затемняющие градиенты, 1 — 3D-молот (десктоп),
//   2 — текстовая сцена входа.
// Градиенты не перехватывают курсор.
// Видео-дыма больше нет (решение Кирилла 2026-09-22): убрано вместе с файлом
// hero-bg.mp4 на 2,1 МБ, фон держат градиенты и свет из Hero3D.
// bg-bg (непрозрачный фон страницы) обязателен с 2026-09-24: под секциями
// появился общий фон на весь экран (index.astro, .section-bg). Без него кадр
// Hero накладывался бы на такой же кадр общего слоя и Hero стал бы светлее.
import Hero3D from './Hero3D';
import HeroHammer from './HeroHammer.astro';
import HeroIntro from './HeroIntro';
---

<section
	id="top"
	class="relative h-[100svh] min-h-[560px] w-full overflow-hidden border-b border-border bg-bg lg:h-[100dvh]"
>
	<!-- Слой 0: затемнение. Вертикальный лёгкий (0.35→0.6), горизонтальный
	     держит тёмной левую треть под заголовок и сходит в ноль правее 85%. -->
	<div
		class="pointer-events-none absolute inset-0 z-[1]"
		style="background-image: linear-gradient(180deg, rgba(6,10,14,0.35) 0%, rgba(6,10,14,0.3) 45%, rgba(6,10,14,0.6) 100%), linear-gradient(90deg, rgba(6,10,14,0.85) 0%, rgba(6,10,14,0.6) 35%, rgba(6,10,14,0.15) 55%, rgba(6,10,14,0) 85%);"
	>
	</div>

	<!-- Слой 1: молот на мобильных. Тот же кадр, что рисует 3D, но картинкой:
	     на 390 остров three.js не грузится, и подложку держит этот слой.
	     Позиция зафиксирована под будущий прилёт (константы в компоненте). -->
	<HeroHammer />

	<!-- Слой 2: 3D-молот. client:media — на мобильных остров вообще не загружается -->
	<Hero3D client:media="(min-width: 1024px)" />

	<!-- Фон Hero: туманный северный пейзаж (вариант A, nano-banana).
	     Только десктоп, opacity 0.5 (зафиксирована 2026-09-24). -->
	<div class="hero-bg" aria-hidden="true"></div>

	<!-- Декор фона. Варианты для выбора: ?decor=1|2|3 (0 — выключено). -->
	<div class="hero-decor decor-1" aria-hidden="true">
		<svg viewBox="0 0 120 640" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
			<path d="M30 20v60M30 40l22 20M52 40L30 60M30 120v60M30 140h22M30 160h22M30 220v60M30 240l22 20v20M30 300v60M30 320l22 20M52 340H30M30 400v60M30 420h22v20H30M30 500v60M30 520l22 20M52 540l-22 20M30 600v40"/>
			<path d="M90 60v60M90 80l-22 20M68 80l22 20M90 180v60M90 200h-22M90 220h-22M90 300v60M90 320l-22 20v20M90 420v60M90 440l-22 20M68 460h22M90 540v60"/>
		</svg>
	</div>
	<div class="hero-decor decor-3" aria-hidden="true"></div>

	<!-- Слой затемнения для варианта ?fly=dim: виден только во время полёта,
	     лежит выше текста (z-3), но ниже молота (50 на мобильном, 60 в 3D). -->
	<div class="hero-dim" aria-hidden="true"></div>

	<!-- Слой 3: сцена входа -->
	<HeroIntro client:load />
</section>


<style>
	/* ── Композиция Hero на десктопе (A+B, 2026-09-23) ──────────────────
	   Было: justify-center и отступы 32/32/48 — блок висел в пустоте.
	   Стало: прижат к верху, отступы 20/20/32, типографика крупнее.
	   :global() обязателен — элементы живут в React-острове HeroIntro. */
	@media (min-width: 1024px) {
		:global(.hero-intro) { justify-content: flex-start; }
		:global(.hero-intro a[href='#contact']) {
			font-size: 1.1875rem;    /* CTA 19px */
			padding: 1.25rem 2.5rem;
		}
	}
	@media (min-width: 1024px) {
		/* Надзаголовок тоже крупнее, H1 не трогаем (98px). */
		/* Надзаголовок — только первый <p> внутри обёртки текстовой колонки.
	   Селектор `p:first-of-type` без обёртки цеплял и подзаголовок, который после
	   выноса прямым ребёнком .hero-intro сам стал «первым <p>» — кегль падал с 17
	   до 14px (нашёл координатор, сверив с картой). */
	/* Надзаголовок — только элемент с классом .text-label. Раньше здесь стоял
	   `> div > p:first-of-type`, и он же цеплял призыв в слоте CTA (тот тоже
	   «первый p» внутри div) — призыв молча падал с 26px до 14px, а вместе с
	   ним и ширина кнопки (386px вместо 560px). Нашёл Hermes 2026-09-24. */
	:global(.hero-intro p.text-label) { font-size: 0.875rem; }
		:global(.hero-sub) {
			font-size: 1.5rem;       /* подзаголовок 24px — выбран Кириллом 2026-09-24 */
			line-height: 1.55;
		}
	}

	/* ── Декор фона: C2 выбран, C1 и C3 в резерве (?decor=1|3) ────────
	   Только для 1024+: мобильный Hero остаётся как был. */
	/* Фон Hero: opacity задаётся переменной (по умолчанию 0.4), поверх него
	   работают прежние градиенты — они и держат читаемость текста. */
	.hero-bg {
		position: absolute; inset: 0; z-index: 0;
		background-image: url('/hero-bg/hero-bg-main.jpg');
		background-size: cover;
		background-position: center 45%;
		opacity: 0.5; /* зафиксировано Кириллом 2026-09-24 */
		pointer-events: none;
	}
	@media (max-width: 1023px) { .hero-bg { display: none; } }

	.hero-decor {
		display: none; position: absolute; pointer-events: none;
		/* z-index: 1 — выше затемняющего градиента (он тоже z-1, но декор идёт
		   позже в DOM). Слой молота (.hero-3d, z-4) рисуется выше — он поднят
		   над слоем текста (z-3) намеренно: раньше знак ложился поверх металла
		   дымкой букв (нашёл Кирилл, причина — z-index 3 у корня острова, а не
		   auto у знака, как считали в прошлой сессии). */
		z-index: 1;
	}
	/* Мобильный: декор не показываем. Селектор глобальный — знак-2 рендерит
	   React-остров и атрибута скоупа Astro у него нет. */
	@media (max-width: 1023px) { :global(.hero-decor) { display: none !important; } }
	html[data-decor='1'] .hero-decor.decor-1 {
		display: block; inset: 0;
		color: var(--accent-warm); opacity: 0.30;
	}
	html[data-decor='1'] .hero-decor.decor-1 svg { display: block; position: absolute; top: 4%; bottom: 4%; left: 0.5%; width: 170px; height: auto; stroke-width: 8; }
	/* C2 выбран Кириллом — работает по умолчанию, без параметра.
	   Отключить: ?decor=0. C1 и C3 остаются в резерве (?decor=1 и ?decor=3). */
	/* Декор-2 — элемент потока внутри .hero-intro (рендерит React-остров,
	   поэтому селекторы через :global). margin-top: auto раздаёт остаток высоты
	   поровну между тремя зазорами: H1 → подзаголовок → призыв → знак. */
	html:not([data-decor]) :global(.hero-decor.decor-2),
	html[data-decor='2'] :global(.hero-decor.decor-2) {
		display: block; position: static;
		/* Отступ до знака: в пиксельном «Авто-равных» его считает JS по глифам
		   (--hero-gap-c), иначе работает прежнее автораспределение по боксам. */
		margin-top: var(--hero-gap-c, auto); margin-bottom: -2vh;
		text-align: center;
		/* Знак — на всю ширину окна (решение Кирилла 2026-09-24): растягиваем по
		   горизонтали transform'ом, а не размером шрифта. Transform не участвует
		   в раскладке, поэтому высота знака и все три пиксельных зазора остаются
		   ровно теми же. --sign-k и --sign-shift считает скрипт по фактической
		   ширине краски букв (canvas + letter-spacing); без JS k = 1 — как было. */
		transform: translateX(var(--sign-shift, 0px)) scaleX(var(--sign-k, 1));
		transform-origin: center center;
	}
	/* Скрытие знака на низких окнах ОТМЕНЕНО (решение принято без согласования,
	   Кирилл: «оптимизация, которая убирает элемент — поломка»). Знак виден всегда
	   на ≥1024px; зазоры при нехватке высоты сжимаются сами. */

	html[data-decor='2'] :global(.hero-decor.decor-2 span),
	html:not([data-decor]) :global(.hero-decor.decor-2 span) {
		font-family: var(--font-display);
		/* Базовый размер — 20vw. Мягкое ограничение по высоте окна включается
		   только на невысоких окнах (ниже 820px), где знак иначе уходит выше
		   кнопки и подрезается нижним краем: на 1920×800 пиксельный зазор
		   был −3px. Это вариант B, выбранный Кириллом 2026-09-24. */
		font-size: 20vw; line-height: 0.8; letter-spacing: 0.02em;
		/* Рамка строчного бокса выше верхушек букв примерно на 0.12em (замер
		   пиксельно). Поднимаем буквы на эту величину, чтобы зазор «кнопка →
		   знак» считался от реальной верхней границы букв, как остальные два. */
		position: relative; top: -0.04em;
		color: var(--text); opacity: 0.18; white-space: nowrap;
	}
	/* Вариант B: мягкое ограничение знака по высоте окна. Правило стоит ПОСЛЕ
	   базового и с тем же селектором — если поставить его выше, базовый
	   font-size: 20vw его перекроет (на этих граблях уже стояли). */
	@media (min-width: 1024px) and (max-height: 820px) {
		html:not([data-decor]) :global(.hero-decor.decor-2 span),
		html[data-decor='2'] :global(.hero-decor.decor-2 span) {
			font-size: 30svh;
		}
	}
	html[data-decor='3'] .hero-decor.decor-3 { display: block; inset: 0; }
	/* v1 — резкий перепад: верх залит, переход на 40 % */
	html[data-decor='3'][data-c3v='1'] .hero-decor.decor-3 {
		background: linear-gradient(180deg, rgba(2,5,8,1) 0%, rgba(2,5,8,1) 40%, rgba(26,42,58,0.55) 100%);
	}
	/* v2 — с цветом палитры: сталь сверху, янтарь снизу */
	html[data-decor='3']:not([data-c3v='1']):not([data-c3v='3']) .hero-decor.decor-3 {
		background: linear-gradient(180deg, rgba(123,165,201,0.28) 0%, rgba(4,8,12,0.92) 48%, rgba(204,156,66,0.2) 100%);
	}
	/* v3 — виньетка: тёмные края, светлый центр */
	html[data-decor='3'][data-c3v='3'] .hero-decor.decor-3 {
		background: radial-gradient(125% 85% at 50% 46%, rgba(0,0,0,0) 28%, rgba(2,5,8,0.78) 72%, rgba(2,5,8,0.96) 100%);
	}
</style>
<style>
	.hero-dim {
		position: absolute;
		inset: 0;
		z-index: 40;
		background: rgba(4, 8, 11, 0.55);
		opacity: 0;
		transition: opacity 0.25s ease;
		pointer-events: none;
	}
	/* Фокус на молоте: пока летит — затемняем всё остальное. Состояние берём
	   прямо у слоя молота, поэтому JS для этого не нужен. */
	html[data-fly='dim'] section:has(.hero-hammer[data-state='flying']) .hero-dim { opacity: 1; }
	/* Десктоп: пока 3D-молот летит, сцена поднимается над текстом сцены входа. */
	/* :global() обязателен: .hero-3d живёт в React-компоненте Hero3D и атрибута
	   скоупа Astro не получает — со scoped-селектором правило не срабатывало. */
	html[data-flying='1'] :global(.hero-3d) { z-index: 60; }
</style>

<script>
	/* Переключатель декора: ?decor=1 (руны по краям) | 2 (водяной знак) | 3 (усиленный градиент). */
	const params = new URLSearchParams(location.search);
	const decor = params.get('hero') || params.get('decor') || '';
	if (decor.indexOf('decor-c') === 0) document.documentElement.dataset.decor = decor.slice(-1);
	else if (decor && decor.indexOf('decor') !== 0) document.documentElement.dataset.decor = decor;
</script>


<style>

	/* ── Призыв-триггер, теперь в слоте бывшей CTA ───────────────────────
	   Живёт внутри React-острова HeroIntro, поэтому только :global().
	   Слот — grid с одной ячейкой: призыв и рамка занимают одну точку. */
	/* :global() на всю цепочку: потомок "*" в scoped-стиле Astro требовал бы
	   атрибут скоупа у детей React-острова, а их у них нет. */
	/* Слот: по горизонтали — на прежнем месте (левый край колонки текста,
	   как у H1 и подзаголовка), по вертикали — центр свободной зоны между
	   подзаголовком и водяным знаком. auto-отступы делят остаток поровну,
	   нижний padding контейнера не пускает слот в буквы.
	   Ячейка общая и растянутая: призыв и рамка получают один и тот же бокс,
	   поэтому подмена не даёт сдвига, а центры совпадают. */
		:global(.hero-cta) {
		display: grid;
		justify-items: stretch;
		align-items: stretch;
		align-self: flex-start;
		/* Вертикальный ритм задаётся здесь и у подзаголовка одним числом:
		   равные отступы H1→подзаголовок→кнопка. Под кнопкой остаётся столько же
		   за счёт резерва под водяной знак у .hero-intro. */
		margin-top: 48px;
		margin-bottom: 0;
	}
	:global(.hero-cta > *) { grid-area: 1 / 1; }
	/* Оба состояния — одного размера: высота 60px у обоих, ячейка задаёт ширину,
	   текст по центру. Переключение не двигает ни низ блока, ни композицию. */
	:global(.hero-cta) { min-height: 60px; }
	:global(.hero-cta > *) {
		min-height: 60px; display: flex; align-items: center; justify-content: center;
		text-align: center; box-sizing: border-box;
	}
	:global(.hero-call) {
		margin: 0;
		text-align: left;
		font-family: var(--font-display);
		font-size: 1.25rem;
		line-height: 1.25;
		letter-spacing: 0.01em;
		color: var(--accent-warm);
		pointer-events: auto;
		cursor: pointer;
		transition: color 0.3s ease, opacity 0.3s ease;
	}
	:global(.hero-call:hover) { color: var(--text); }
	:global(.hero-call[data-done='1']) { opacity: 0; pointer-events: none; color: var(--text); }
	html[data-call='a'] :global(.hero-call) {
		padding: 12px 20px;
		border: 1px solid color-mix(in srgb, var(--accent-warm) 45%, transparent);
		border-radius: 14px;
		background: color-mix(in srgb, var(--bg-deep) 55%, transparent);
		backdrop-filter: blur(6px);
	}
	html[data-call='a'] :global(.hero-call:hover) {
		border-color: var(--accent-warm);
		background: color-mix(in srgb, var(--bg-deep) 72%, transparent);
	}
	html[data-call='b'] :global(.hero-call) {
		padding: 14px 22px;
		border: 1px solid transparent;
		border-radius: 14px;
		background: none;
	}
	html[data-call='b'] :global(.hero-call:hover) { border-color: var(--accent-warm); }
	@media (min-width: 1024px) {
		:global(.hero-call) { font-size: 1.625rem; max-width: 560px; }
		/* Резерв больше не нужен: знак-2 стоит в потоке и занимает свою полосу сам,
		   отступ до него даёт margin-top: auto. */
		:global(.hero-intro) { padding-bottom: 0; }
	}


	/* ── Вертикальный ритм Hero: два варианта (?spacing=1|2) ────────────
	   Вариант 1 (по умолчанию) — точное центрирование: отступ H1→подзаголовок
	   равен отступу подзаголовок→кнопка, под кнопкой столько же до знака.
	   Вариант 2 — минимальные равные 28px. Горизонталь не трогаем. */
	/* Отступы. По умолчанию — пиксельные «Авто-равные»: модуль src/lib/heroGaps.ts
	   считает три отступа по КРАСКЕ букв (не по боксам) и кладёт их в
	   --hero-gap-a|b|c на .hero-intro, поэтому визуальные зазоры равны, хотя
	   боксы у всех разные. Пока переменных нет (JS не успел, узкий экран),
	   работает прежнее автораспределение по боксам.
	   Атрибут data-spacing='24|32|40|48|56' ставит фиксированный зазор между
	   H1 → подзаголовком → призывом (знак остаётся прижат к низу автополем). */
	:global(.hero-sub) { margin-top: var(--hero-gap-a, auto); }
	:global(.hero-cta) { margin-top: var(--hero-gap-b, auto); }
	/* Поправка центрирования подзаголовка (была margin-bottom: −11px под кегль
	   21px) снята: в пиксельном авто её роль играет расчёт по глифам, а в
	   фиксированных режимах она ломала их смысл — «48px» давало 48 по первому
	   зазору и 37 по второму. Теперь фиксированный режим = ровно N px между
	   боксами, а визуальные зазоры показывает отладка на /hero-spacing-preview. */
	html[data-spacing='24'] :global(.hero-sub), html[data-spacing='24'] :global(.hero-cta) { margin-top: 24px; }
	html[data-spacing='32'] :global(.hero-sub), html[data-spacing='32'] :global(.hero-cta) { margin-top: 32px; }
	html[data-spacing='40'] :global(.hero-sub), html[data-spacing='40'] :global(.hero-cta) { margin-top: 40px; }
	html[data-spacing='48'] :global(.hero-sub), html[data-spacing='48'] :global(.hero-cta) { margin-top: 48px; }
	html[data-spacing='56'] :global(.hero-sub), html[data-spacing='56'] :global(.hero-cta) { margin-top: 56px; }
	/* Размер подзаголовка — варианты кнопками на /hero-spacing-preview (правило 20.6).
	   База — 24px (задана выше в герой-блоке), здесь только отклонения от неё. */
	@media (min-width: 1024px) {
		html[data-sub='21'] :global(.hero-sub) { font-size: 1.3125rem; }
		html[data-sub='22'] :global(.hero-sub) { font-size: 1.375rem; }
		html[data-sub='26'] :global(.hero-sub) { font-size: 1.625rem; }
	}
	/* Мобильный: знака нет, автополя растянули бы два зазора на всю высоту
	   (измерено 253px на 390×844) — там держим прежние фиксированные 48px. */
	@media (max-width: 1023px) {
		:global(.hero-sub), :global(.hero-cta) { margin-top: 48px; }
	}

	/* ── Рамка-кнопка §10.3.1 (скелет, без огня) ─────────────────────────
	   До прилёта рамки нет: на этом месте стоит призыв «Нажми — узнаешь…».
	   После посадки молота призыв гаснет, рамка проявляется. */
	:global(.hero-frame) {
		display: none;
		font-family: var(--font-display);
		font-size: 1.375rem;
		letter-spacing: 0.06em;
		line-height: 1.2;
		color: var(--text);
		background: none;
		/* Тот же стиль, что у призыва-триггера: закругление, толщина и цвет. */
		border: 1px solid color-mix(in srgb, var(--accent-warm) 45%, transparent);
		border-radius: 14px;
		background: color-mix(in srgb, var(--bg-deep) 55%, transparent);
		backdrop-filter: blur(6px);
		padding: 0.9rem 2rem;
		/* Размер задаёт общая ячейка слота — он же, что у призыва. */
		cursor: pointer;
		pointer-events: auto;
		position: relative;
		text-align: center;
		transition: border-color 0.25s ease, background 0.25s ease, color 0.25s ease;
	}
	:global(.hero-frame__label--mobile) { display: none; }
	:global(.hero-frame__label--hover) { display: none; }
	/* Наведение: надпись меняется на «Записаться», рамка и текст — --accent
	   (решение Кирилла: всё в синий, монолитно с огнём). Состояние задаётся
	   ТОЛЬКО классом .is-hover, а не :hover: рамка встаёт на место призыва, и
	   курсор после клика оказывается на ней — на чистом :hover надпись менялась
	   бы сама, без движения мыши (см. защиту от автозапуска в скрипте).
	   Фокус с клавиатуры (:focus-visible) и его эмуляция (.is-focus) дают то же
	   самое: надпись, синие цвета, бегущий огонь. */
	:global(.hero-frame.is-hover) :global(.hero-frame__label--desktop),
	:global(.hero-frame:focus-visible) :global(.hero-frame__label--desktop),
	:global(.hero-frame.is-focus) :global(.hero-frame__label--desktop) { display: none; }
	:global(.hero-frame.is-hover) :global(.hero-frame__label--hover),
	:global(.hero-frame:focus-visible) :global(.hero-frame__label--hover),
	:global(.hero-frame.is-focus) :global(.hero-frame__label--hover) { display: inline; }
	body:has(.hero-hammer[data-state='landed']) :global(.hero-frame),
	html[data-cta-preview='now'] :global(.hero-frame),
	html[data-cta-preview='both'] :global(.hero-frame) { display: inline-block; }
	/* Режим превью «оба сразу»: рамка поверх полупрозрачного призыва — видно,
	   что боксы и стили совпадают. На главной такого режима нет. */
	html[data-cta-preview='both'] :global(.hero-call[data-done='1']) { opacity: 0.35; pointer-events: none; }

	/* Стиль A — тонкая рамка accent, минимум декора (по умолчанию). */
	/* Стиль B — рамка 2px и угловые насечки, как руны. */
	html[data-cta='b'] :global(.hero-frame) { border-width: 2px; }
	html[data-cta='b'] :global(.hero-frame)::before,
	html[data-cta='b'] :global(.hero-frame)::after {
		content: ''; position: absolute; width: 14px; height: 14px;
		border: 2px solid var(--accent-warm);
	}
	html[data-cta='b'] :global(.hero-frame)::before { top: -6px; left: -6px; border-right: 0; border-bottom: 0; }
	html[data-cta='b'] :global(.hero-frame)::after { bottom: -6px; right: -6px; border-left: 0; border-top: 0; }
	/* Стиль C — рамка с лёгкой подложкой. */
	html[data-cta='c'] :global(.hero-frame) {
		border-width: 2px;
		background: color-mix(in srgb, var(--surface) 72%, transparent);
		backdrop-filter: blur(6px);
	}

	:global(.hero-frame.is-hover),
	:global(.hero-frame:focus-visible),
	:global(.hero-frame.is-focus) { border-color: var(--accent); color: var(--accent); }
	/* У рамки в фокусе роль индикатора играют огонь, синий цвет и смена надписи,
	   поэтому системную обводку убираем. При reduced-motion огня нет — там
	   возвращаем обычную обводку, иначе фокус не виден (см. медиазапрос ниже). */
	:global(.hero-frame:focus-visible),
	:global(.hero-frame.is-focus) { outline: none; }
	:global(.hero-frame.is-pulse) { animation: cta-pulse 400ms ease; }
	@keyframes cta-pulse {
		0% { border-color: var(--accent); box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent); }
		50% { border-color: var(--accent-warm); box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 0%, transparent); }
		100% { border-color: var(--accent); box-shadow: none; }
	}

	/* ── Огонь по рамке (§10.3.1, этап 2, скелет) ─────────────────────────
	   Две SVG-линии идут от СЕРЕДИНЫ ВЕРХНЕЙ границы: левая — влево, вниз по
	   левой стороне, к середине нижней; правая — зеркально. Встречаются в
	   середине нижней границы. Раскрытие — stroke-dashoffset 1 → 0 при
	   pathLength="1" (длина пути нормализована, поэтому от размера рамки
	   анимация не зависит). Геометрию путей и viewBox ставит скрипт ниже.
	   Параметры: --fire-dur (длительность обхода), --fire-w (толщина),
	   --fire-glow (свечение). Вариант затухания — html[data-fire]. */
	/* Значения по умолчанию (пока Кирилл не выбрал другое): обход 1,2 с,
	   толщина 2 px, свечение 4 px (0,5 на превью), затухание «гаснет».
	   Заданы на корне, чтобы превью могло переопределить их инлайном. */
	:global(:root) {
		--fire-dur: 1200ms;
		--fire-w: 2;
		--fire-glow: 4px;
	}
	:global(.hero-frame__fire) {
		position: absolute; inset: 0; width: 100%; height: 100%;
		overflow: visible; pointer-events: none;
	}
	:global(.hero-frame__fire path) {
		fill: none;
		stroke: var(--accent);
		stroke-width: var(--fire-w, 2);
		stroke-linecap: round;
		stroke-dasharray: 1 1;
		stroke-dashoffset: 1;
		opacity: 0;
		filter: drop-shadow(0 0 var(--fire-glow, 4px) var(--accent));
		transition: stroke-dashoffset 0s linear, opacity 0s linear;
	}
	/* Розыгрыш: огонь расползается из середины верхней границы в две стороны. */
	:global(.hero-frame.is-firing) :global(.hero-frame__fire path),
	:global(.hero-frame:focus-visible) :global(.hero-frame__fire path),
	:global(.hero-frame.is-focus) :global(.hero-frame__fire path) {
		stroke-dashoffset: 0;
		opacity: 1;
		transition: stroke-dashoffset var(--fire-dur, 1200ms) linear, opacity 120ms linear;
	}
	/* Вариант A (развилка части 3): пока огонь идёт — border гаснет, и линия
	   огня становится видимой границей. По умолчанию border остаётся (C/B). */
	html[data-fire-border='hide'] :global(.hero-frame.is-firing),
	html[data-fire-border='hide'] :global(.hero-frame.is-dying),
	html[data-fire-border='hide'] :global(.hero-frame:focus-visible),
	html[data-fire-border='hide'] :global(.hero-frame.is-focus) { border-color: transparent; }
	/* Затухание «просто гаснет»: огонь остаётся на месте и теряет яркость. */
	html[data-fire='fade'] :global(.hero-frame.is-dying) :global(.hero-frame__fire path) {
		stroke-dashoffset: 0;
		opacity: 0;
		transition: opacity 300ms ease, stroke-dashoffset 0s linear;
	}
	/* Затухание «обратный ход»: огонь уходит назад, к середине верхней границы.
	   Скорость — в 1.6 раза быстрее активации (решение Кирилла): при 1200 мс
	   активации откат идёт 750 мс, поэтому длительность считается из --fire-dur. */
	html[data-fire='rewind'] :global(.hero-frame.is-dying) :global(.hero-frame__fire path) {
		stroke-dashoffset: 1;
		opacity: 1;
		transition: stroke-dashoffset calc(var(--fire-dur, 1200ms) / 1.6) linear, opacity 0s linear;
	}
	/* Наведение без курсора (превью «Hover ON») описано выше, вместе с :hover. */
	@media (max-width: 1023px) {
		:global(.hero-frame) { min-width: 0; font-size: 1.0625rem; padding: 0.85rem 1.25rem; }
		:global(.hero-frame__label--desktop) { display: none; }
		:global(.hero-frame__label--mobile) { display: inline; }
		/* Огонь — только на десктопе: на тач-устройствах наведения нет. */
		:global(.hero-frame__fire) { display: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		:global(.hero-frame.is-pulse) { animation: none; }
		:global(.hero-frame__fire) { display: none; }
		/* Огня нет — фокус с клавиатуры показываем обычной обводкой. */
		:global(.hero-frame:focus-visible),
		:global(.hero-frame.is-focus) { outline: 2px solid var(--accent); outline-offset: 3px; }
	}

</style>

<script>
	/* Рамка-кнопка §10.3.1: клик — короткая вспышка рамки, затем скролл к форме.
	   Огонь по периметру — этап 2 (см. ниже). */
	const heroFrame = document.getElementById('hero-frame');
	/* Переключатели для /hero-cta-preview. */
	const ctaParams = new URLSearchParams(location.search);
	const ctaStyle = ctaParams.get('cta');
	if (ctaStyle) document.documentElement.dataset.cta = ctaStyle;
	const spacing = ctaParams.get('spacing');
	if (spacing) document.documentElement.dataset.spacing = spacing;
	/* Варианты по умолчанию (решения Кирилла): затухание — обратный ход
	   (быстрее активации в 1.6 раза, см. CSS выше), линия огня — ровно по
	   border'у (вариант B, без «двойной рамки»). */
	if (!document.documentElement.dataset.fire) document.documentElement.dataset.fire = 'rewind';
	if (!document.documentElement.dataset.fireLine) document.documentElement.dataset.fireLine = 'on';

	if (heroFrame) {
		heroFrame.addEventListener('click', () => {
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const go = () => {
				const target = document.getElementById('contact');
				if (target) target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
				history.replaceState(null, '', '#contact');
			};
			if (reduced) { go(); return; }
			heroFrame.classList.add('is-pulse');
			window.setTimeout(() => { heroFrame.classList.remove('is-pulse'); go(); }, 400);
		});
	}

	/* ── Огонь по рамке (§10.3.1, этап 2, скелет) ────────────────────────
	   Две линии: от середины верхней границы влево и вправо, поворот на верхних
	   углах, вниз по боковым границам, поворот на нижних — и обе приходят в
	   середину нижней границы. Геометрия считается по фактическому размеру
	   рамки (надпись меняется на «Записаться», ширина при этом немного другая,
	   плюс ресайз), поэтому пути задаются скриптом, а не в разметке.
	   Затухание при уходе курсора: «fade» (просто гаснет) или «rewind»
	   (обратный ход) — выбирается html[data-fire]. */
	const fireSvg = heroFrame ? heroFrame.querySelector('.hero-frame__fire') : null;
	const FIRE_RADIUS = 14; /* совпадает с border-radius рамки */

	function fireGeometry() {
		if (!heroFrame || !fireSvg) return null;
		const w = heroFrame.offsetWidth, h = heroFrame.offsetHeight;
		if (!w || !h) return null;
		/* d — смещение линии внутрь от padding-бокса. «over» (по умолчанию):
		   0,5 px, линия идёт по внутреннему краю border'а (как было — видно
		   «двойную рамку»). «on»: −0,5 px — ровно по центру border'а, визуально
		   один контур. Радиус считаем от внешнего border-radius (14 px), вычитая
		   толщину border'а (1 px) и смещение. */
		const onBorder = document.documentElement.dataset.fireLine === 'on';
		const d = onBorder ? -0.5 : 0.5;
		const r = Math.max(2, FIRE_RADIUS - 1 - d);
		const left = d, right = w - d, top = d, bottom = h - d;
		const cx = w / 2;
		const dLeft = `M ${cx} ${top} H ${left + r} A ${r} ${r} 0 0 0 ${left} ${top + r} V ${bottom - r} A ${r} ${r} 0 0 0 ${left + r} ${bottom} H ${cx}`;
		const dRight = `M ${cx} ${top} H ${right - r} A ${r} ${r} 0 0 1 ${right} ${top + r} V ${bottom - r} A ${r} ${r} 0 0 1 ${right - r} ${bottom} H ${cx}`;
		fireSvg.setAttribute('viewBox', `0 0 ${w} ${h}`);
		fireSvg.setAttribute('preserveAspectRatio', 'none');
		const paths = fireSvg.querySelectorAll('path');
		if (paths[0]) paths[0].setAttribute('d', dLeft);
		if (paths[1]) paths[1].setAttribute('d', dRight);
		return { w, h };
	}

	function fireDurationMs() {
		const raw = heroFrame ? getComputedStyle(heroFrame).getPropertyValue('--fire-dur').trim() : '';
		if (!raw) return 1200;
		const num = parseFloat(raw);
		if (!isFinite(num)) return 1200;
		if (raw.endsWith('ms')) return num;
		if (raw.endsWith('s')) return num * 1000;
		return num;
	}

	/* Откат идёт со скоростью в 1.6 раза быстрее активации (решение Кирилла):
	   при 1200 мс активации — 750 мс. */
	const REWIND_RATIO = 1.6;

	let fireTimer = 0;

	function fireStart() {
		if (!heroFrame) return;
		fireGeometry();
		window.clearTimeout(fireTimer);
		/* Каждое наведение — огонь идёт с нуля, от середины верхней границы.
		   Поэтому всегда снимаем состояние и сбрасываем переход: иначе после
		   полного обхода повторное наведение показало бы готовый периметр. */
		heroFrame.classList.remove('is-firing', 'is-dying');
		void heroFrame.offsetWidth;
		heroFrame.classList.add('is-hover', 'is-firing');
	}

	function fireStop() {
		if (!heroFrame) return;
		heroFrame.classList.remove('is-hover');
		if (!heroFrame.classList.contains('is-firing')) return;
		const variant = document.documentElement.dataset.fire || 'fade';
		heroFrame.classList.add('is-dying');
		window.clearTimeout(fireTimer);
		fireTimer = window.setTimeout(
			() => { heroFrame.classList.remove('is-firing', 'is-dying'); },
			variant === 'rewind' ? fireDurationMs() / REWIND_RATIO + 40 : 340
		);
	}

	function fireRestart() {
		fireStart();
	}

	/* ── Защита от автозапуска (решение Кирилла) ──────────────────────────
	   Рамка встаёт ровно на место призыва-триггера, и курсор после клика
	   остаётся на этом месте — браузер сразу шлёт mouseenter, огонь бежал бы
	   сам и надпись менялась сама. Поэтому наведение считается только если
	   мышь РЕАЛЬНО двигалась после того, как рамка появилась. */
	let lastMoveAt = -1;      /* время последнего движения мыши */
	let visibleSince = -1;    /* когда рамка сменила видимость (-1 — ещё не появлялась) */

	const hoverAllowed = () => visibleSince < 0 || lastMoveAt > visibleSince;

	document.addEventListener('mousemove', (e) => {
		lastMoveAt = performance.now();
		if (!heroFrame || !hoverAllowed() || heroFrame.classList.contains('is-firing')) return;
		/* Движение уже после появления рамки: если курсор над ней — это вход. */
		const r = heroFrame.getBoundingClientRect();
		if (r.width > 0 && e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom) fireStart();
	}, { passive: true });

	if (heroFrame) {
		heroFrame.addEventListener('mouseenter', () => { if (hoverAllowed()) fireStart(); });
		heroFrame.addEventListener('mouseleave', fireStop);
		/* Клавиатура: Tab доводит до рамки, :focus-visible даёт тот же вид, что
		   наведение. Огонь гоняем классами, чтобы уход фокуса гасил его так же,
		   как уход курсора. Enter/Space на <button> браузер сам превращает в
		   click — отдельный обработчик не нужен. */
		heroFrame.addEventListener('focus', () => { if (heroFrame.matches(':focus-visible')) fireStart(); });
		heroFrame.addEventListener('blur', fireStop);
		/* Рамка показывается по фазе молота (body:has(.hero-hammer[data-state=landed])).
		   Каждая смена фазы — новый показ: наведение снова требует движения мыши. */
		const hammerLayer = document.querySelector('.hero-hammer');
		if (hammerLayer && 'MutationObserver' in window) {
			new MutationObserver(() => {
				visibleSince = performance.now();
				if (heroFrame.classList.contains('is-firing')) fireStop();
			}).observe(hammerLayer, { attributes: true, attributeFilter: ['data-state'] });
		}
		/* Ширина рамки меняется от ресайза (надпись на размер не влияет) —
		   пересчитываем геометрию путей по фактическому размеру. */
		if ('ResizeObserver' in window) new ResizeObserver(() => fireGeometry()).observe(heroFrame);
		window.addEventListener('resize', fireGeometry);
		window.addEventListener('load', fireGeometry, { once: true });
		window.setTimeout(fireGeometry, 0);
	}

	/* ── Знак «МЬЁЛЬНИР» на всю ширину окна ─────────────────────────────
	   Краска букв шире или уже окна — считаем коэффициент растяжения по
	   фактической ширине краски (canvas + letter-spacing, как её рисует браузер)
	   и сдвиг, чтобы краска встала центру. Растяжение — transform: scaleX, он не
	   участвует в раскладке: высота знака и три пиксельных зазора не меняются. */
	const signDecor = document.querySelector('.hero-decor.decor-2');
	const signSpan = signDecor ? signDecor.querySelector('span') : null;

	function fitSign() {
		if (!signDecor || !signSpan) return null;
		if (!window.matchMedia('(min-width: 1024px)').matches) {
			/* На мобильном знака нет — переменные не нужны. */
			document.documentElement.style.removeProperty('--sign-k');
			document.documentElement.style.removeProperty('--sign-shift');
			return null;
		}
		const cs = getComputedStyle(signSpan);
		const text = (signSpan.textContent || '').trim();
		if (!text) return null;
		const ls = parseFloat(cs.letterSpacing) || 0;
		const ctx = document.createElement('canvas').getContext('2d');
		if (!ctx) return null;
		ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${parseFloat(cs.fontSize)}px ${cs.fontFamily}`;
		const m = ctx.measureText(text);
		/* Краска в координатах строки: от −actualBoundingBoxLeft до
		   actualBoundingBoxRight (+ межбуквенные пробелы, если canvas их не знает). */
		const supportsLS = 'letterSpacing' in ctx;
		if (supportsLS) (ctx as any).letterSpacing = `${ls}px`;
		const gaps = Math.max(0, text.length - 1) * ls;
		const inkLeft = -m.actualBoundingBoxLeft;
		const inkRight = m.actualBoundingBoxRight + (supportsLS ? 0 : gaps);
		const ink = inkRight - inkLeft;
		if (!(ink > 10)) return null;

		/* Геометрию меряем БЕЗ растяжения: transform искажает getBoundingClientRect.
		   Знак может переполнять контейнер (на 1920 текст шире 1400-й колонки), и
		   тогда `text-align: center` его не центрирует — поэтому считаем сдвиг по
		   фактическому положению краски, а не по центру бокса. */
		const root = document.documentElement;
		const keepK = root.style.getPropertyValue('--sign-k');
		const keepShift = root.style.getPropertyValue('--sign-shift');
		if (keepK) {
			root.style.setProperty('--sign-k', '1');
			root.style.setProperty('--sign-shift', '0px');
		}
		const spanRect = signSpan.getBoundingClientRect();
		const decorRect = signDecor.getBoundingClientRect();
		if (keepK) {
			root.style.setProperty('--sign-k', keepK);
			root.style.setProperty('--sign-shift', keepShift);
		}

		const vw = window.innerWidth;
		const k = vw / ink;
		const inkCenter = spanRect.left + inkLeft + ink / 2;
		const decorCenter = decorRect.left + decorRect.width / 2;
		/* После масштабирования относительно центра бокса краска окажется тут: */
		const scaledCenter = decorCenter + k * (inkCenter - decorCenter);
		const shift = vw / 2 - scaledCenter;

		root.style.setProperty('--sign-k', k.toFixed(5));
		root.style.setProperty('--sign-shift', shift.toFixed(2) + 'px');
		const state = {
			k: Number(k.toFixed(5)), shift: Number(shift.toFixed(2)), ink: Math.round(ink), vw,
			inkLeft: Math.round(inkLeft), inkRight: Math.round(inkRight),
			spanLeft: Math.round(spanRect.left), decorCenter: Math.round(decorCenter),
		};
		root.dispatchEvent(new CustomEvent('hero:sign', { detail: state }));
		return state;
	}

	/* Пересчёт: ресайз (с паузой, как у зазоров), загрузка шрифтов, старт. */
	let signTimer = 0;
	const scheduleSign = () => {
		if (signTimer) window.clearTimeout(signTimer);
		signTimer = window.setTimeout(() => { signTimer = 0; fitSign(); }, 120);
	};
	fitSign();
	window.addEventListener('resize', scheduleSign, { passive: true });
	document.fonts?.ready.then(scheduleSign).catch(() => {});
	window.addEventListener('load', fitSign, { once: true });
	window.setTimeout(fitSign, 400);

	(window as any).__cta = {
		signFit: fitSign,
		signRect: () => {
			if (!signDecor || !signSpan) return null;
			const d = signDecor.getBoundingClientRect();
			const s = signSpan.getBoundingClientRect();
			const cs = getComputedStyle(signSpan);
			const root = document.documentElement;
			return {
				k: root.style.getPropertyValue('--sign-k') || '1',
				shift: root.style.getPropertyValue('--sign-shift') || '0px',
				decorBox: [Math.round(d.left), Math.round(d.right), Math.round(d.width)],
				spanBox: [Math.round(s.left), Math.round(s.right)],
				fontSize: cs.fontSize, letterSpacing: cs.letterSpacing, vw: window.innerWidth,
			};
		},
		style: (v: string) => { document.documentElement.dataset.cta = v; },
		show: (mode: string) => {
			if (mode === 'after') delete document.documentElement.dataset.ctaPreview;
			else document.documentElement.dataset.ctaPreview = mode;
		},
		spacing: (v: string) => {
			if (v === '1') delete document.documentElement.dataset.spacing;
			else document.documentElement.dataset.spacing = v;
		},
		gaps: () => {
			const g = (s: string) => document.querySelector(s)?.getBoundingClientRect() ?? null;
			const h1 = g('.hero-intro h1'), sub = g('.hero-sub'), slot = g('.hero-cta'), dec = g('.decor-2');
			if (!h1 || !sub || !slot) return null;
			return {
				h1_подзаг: Math.round(sub.top - h1.bottom),
				подзаг_кнопка: Math.round(slot.top - sub.bottom),
				кнопка_знак: dec ? Math.round(dec.top - slot.bottom) : null,
			};
		},
		state: () => {
			const el = document.getElementById('hero-frame');
			return {
				cta: document.documentElement.dataset.cta || 'a',
				preview: document.documentElement.dataset.ctaPreview || 'after',
				visible: el ? getComputedStyle(el).display !== 'none' : null,
				label: el ? (el as HTMLElement).innerText.trim().split('\n')[0] : null,
			};
		},
		/* Огонь: включить/выключить как при наведении, перезапустить, настроить. */
		fire: (on: boolean) => { on ? fireStart() : fireStop(); },
		fireRestart,
		/* Эмуляция фокуса с клавиатуры: тот же CSS, что у :focus-visible. */
		focusEmu: (on: boolean) => {
			if (!heroFrame) return;
			heroFrame.classList.toggle('is-focus', on);
			if (!on && !heroFrame.classList.contains('is-hover')) fireStop();
		},
		/* Развилка части 3: как линия огня соотносится с border'ом. */
		fireLine: (mode: 'over' | 'on') => {
			document.documentElement.dataset.fireLine = mode;
			fireGeometry();
			return (window as any).__cta.fireState();
		},
		fireBorder: (mode: 'show' | 'hide') => {
			document.documentElement.dataset.fireBorder = mode;
			return (window as any).__cta.fireState();
		},
		fireParams: (o: { dur?: string; w?: string; glow?: string; variant?: string }) => {
			const root = document.documentElement;
			if (o.dur) root.style.setProperty('--fire-dur', o.dur);
			if (o.w) root.style.setProperty('--fire-w', o.w);
			if (o.glow !== undefined) root.style.setProperty('--fire-glow', o.glow);
			if (o.variant) root.dataset.fire = o.variant;
			return (window as any).__cta.fireState();
		},
		fireState: () => {
			const root = document.documentElement;
			const paths = fireSvg ? Array.from(fireSvg.querySelectorAll('path')) : [];
			return {
				variant: root.dataset.fire || 'fade',
				line: root.dataset.fireLine || 'over',
				border: root.dataset.fireBorder || 'show',
				focus: heroFrame ? heroFrame.classList.contains('is-focus') : false,
				tabindex: heroFrame ? heroFrame.getAttribute('tabindex') : null,
				dur: getComputedStyle(root).getPropertyValue('--fire-dur').trim() || '1200ms',
				w: getComputedStyle(root).getPropertyValue('--fire-w').trim() || '2',
				glow: getComputedStyle(root).getPropertyValue('--fire-glow').trim() || '4px',
				firing: heroFrame ? heroFrame.classList.contains('is-firing') : false,
				dying: heroFrame ? heroFrame.classList.contains('is-dying') : false,
				box: heroFrame ? [heroFrame.offsetWidth, heroFrame.offsetHeight] : null,
				/* Длины путей в пикселях — чтобы видеть, что обе половины равны. */
				len: paths.map((p) => Math.round((p as SVGPathElement).getTotalLength())),
			};
		},
	};
</script>

<noscript>
	<!-- Без JS сцена входа не проигрывается, а в SSR-разметке лежат её
	     стартовые стили. Принудительно показываем текст в конечном виде. -->
	<style>
		#top p,
		#top h1 span span,
		#top a {
			opacity: 1 !important;
			filter: none !important;
			transform: none !important;
		}
	</style>
</noscript>

