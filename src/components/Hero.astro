---
// Hero: кадр на всю высоту. Слои снизу вверх:
//   0 — затемняющие градиенты, 1 — 3D-молот (десктоп),
//   2 — текстовая сцена входа.
// Градиенты не перехватывают курсор.
// Видео-дыма больше нет (решение Кирилла 2026-09-22): убрано вместе с файлом
// hero-bg.mp4 на 2,1 МБ, фон держат градиенты и свет из Hero3D.
import Hero3D from './Hero3D';
import HeroHammer from './HeroHammer.astro';
import HeroIntro from './HeroIntro';
---

<section
	id="top"
	class="relative h-[100svh] min-h-[560px] w-full overflow-hidden border-b border-border lg:h-[100dvh]"
>
	<!-- Слой 0: затемнение. Вертикальный лёгкий (0.35→0.6), горизонтальный
	     держит тёмной левую треть под заголовок и сходит в ноль правее 85%. -->
	<div
		class="pointer-events-none absolute inset-0 z-[1]"
		style="background-image: linear-gradient(180deg, rgba(6,10,14,0.35) 0%, rgba(6,10,14,0.3) 45%, rgba(6,10,14,0.6) 100%), linear-gradient(90deg, rgba(6,10,14,0.85) 0%, rgba(6,10,14,0.6) 35%, rgba(6,10,14,0.15) 55%, rgba(6,10,14,0) 85%);"
	>
	</div>

	<!-- Слой 1: молот на мобильных. Тот же кадр, что рисует 3D, но картинкой:
	     на 390 остров three.js не грузится, и подложку держит этот слой.
	     Позиция зафиксирована под будущий прилёт (константы в компоненте). -->
	<HeroHammer />

	<!-- Слой 2: 3D-молот. client:media — на мобильных остров вообще не загружается -->
	<Hero3D client:media="(min-width: 1024px)" />

	<!-- Фон Hero: туманный северный пейзаж (вариант A, nano-banana).
	     Только десктоп, opacity 0.5 (зафиксирована 2026-09-24). -->
	<div class="hero-bg" aria-hidden="true"></div>

	<!-- Декор фона. Варианты для выбора: ?decor=1|2|3 (0 — выключено). -->
	<div class="hero-decor decor-1" aria-hidden="true">
		<svg viewBox="0 0 120 640" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
			<path d="M30 20v60M30 40l22 20M52 40L30 60M30 120v60M30 140h22M30 160h22M30 220v60M30 240l22 20v20M30 300v60M30 320l22 20M52 340H30M30 400v60M30 420h22v20H30M30 500v60M30 520l22 20M52 540l-22 20M30 600v40"/>
			<path d="M90 60v60M90 80l-22 20M68 80l22 20M90 180v60M90 200h-22M90 220h-22M90 300v60M90 320l-22 20v20M90 420v60M90 440l-22 20M68 460h22M90 540v60"/>
		</svg>
	</div>
	<div class="hero-decor decor-3" aria-hidden="true"></div>

	<!-- Слой затемнения для варианта ?fly=dim: виден только во время полёта,
	     лежит выше текста (z-3), но ниже молота (50 на мобильном, 60 в 3D). -->
	<div class="hero-dim" aria-hidden="true"></div>

	<!-- Слой 3: сцена входа -->
	<HeroIntro client:load />
</section>


<style>
	/* ── Композиция Hero на десктопе (A+B, 2026-09-23) ──────────────────
	   Было: justify-center и отступы 32/32/48 — блок висел в пустоте.
	   Стало: прижат к верху, отступы 20/20/32, типографика крупнее.
	   :global() обязателен — элементы живут в React-острове HeroIntro. */
	@media (min-width: 1024px) {
		:global(.hero-intro) { justify-content: flex-start; }
		:global(.hero-intro a[href='#contact']) {
			font-size: 1.1875rem;    /* CTA 19px */
			padding: 1.25rem 2.5rem;
		}
	}
	@media (min-width: 1024px) {
		/* Надзаголовок тоже крупнее, H1 не трогаем (98px). */
		/* Надзаголовок — только первый <p> внутри обёртки текстовой колонки.
	   Селектор `p:first-of-type` без обёртки цеплял и подзаголовок, который после
	   выноса прямым ребёнком .hero-intro сам стал «первым <p>» — кегль падал с 17
	   до 14px (нашёл координатор, сверив с картой). */
	/* Надзаголовок — только элемент с классом .text-label. Раньше здесь стоял
	   `> div > p:first-of-type`, и он же цеплял призыв в слоте CTA (тот тоже
	   «первый p» внутри div) — призыв молча падал с 26px до 14px, а вместе с
	   ним и ширина кнопки (386px вместо 560px). Нашёл Hermes 2026-09-24. */
	:global(.hero-intro p.text-label) { font-size: 0.875rem; }
		:global(.hero-sub) {
			font-size: 1.5rem;       /* подзаголовок 24px — выбран Кириллом 2026-09-24 */
			line-height: 1.55;
		}
	}

	/* ── Декор фона: C2 выбран, C1 и C3 в резерве (?decor=1|3) ────────
	   Только для 1024+: мобильный Hero остаётся как был. */
	/* Фон Hero: opacity задаётся переменной (по умолчанию 0.4), поверх него
	   работают прежние градиенты — они и держат читаемость текста. */
	.hero-bg {
		position: absolute; inset: 0; z-index: 0;
		background-image: url('/hero-bg/hero-bg-main.jpg');
		background-size: cover;
		background-position: center 45%;
		opacity: 0.5; /* зафиксировано Кириллом 2026-09-24 */
		pointer-events: none;
	}
	@media (max-width: 1023px) { .hero-bg { display: none; } }

	.hero-decor {
		display: none; position: absolute; pointer-events: none;
		/* z-index: 1 — выше затемняющего градиента (он тоже z-1, но декор идёт
		   позже в DOM). Слой молота (.hero-3d, z-4) рисуется выше — он поднят
		   над слоем текста (z-3) намеренно: раньше знак ложился поверх металла
		   дымкой букв (нашёл Кирилл, причина — z-index 3 у корня острова, а не
		   auto у знака, как считали в прошлой сессии). */
		z-index: 1;
	}
	/* Мобильный: декор не показываем. Селектор глобальный — знак-2 рендерит
	   React-остров и атрибута скоупа Astro у него нет. */
	@media (max-width: 1023px) { :global(.hero-decor) { display: none !important; } }
	html[data-decor='1'] .hero-decor.decor-1 {
		display: block; inset: 0;
		color: var(--accent-warm); opacity: 0.30;
	}
	html[data-decor='1'] .hero-decor.decor-1 svg { display: block; position: absolute; top: 4%; bottom: 4%; left: 0.5%; width: 170px; height: auto; stroke-width: 8; }
	/* C2 выбран Кириллом — работает по умолчанию, без параметра.
	   Отключить: ?decor=0. C1 и C3 остаются в резерве (?decor=1 и ?decor=3). */
	/* Декор-2 — элемент потока внутри .hero-intro (рендерит React-остров,
	   поэтому селекторы через :global). margin-top: auto раздаёт остаток высоты
	   поровну между тремя зазорами: H1 → подзаголовок → призыв → знак. */
	html:not([data-decor]) :global(.hero-decor.decor-2),
	html[data-decor='2'] :global(.hero-decor.decor-2) {
		display: block; position: static;
		/* Отступ до знака: в пиксельном «Авто-равных» его считает JS по глифам
		   (--hero-gap-c), иначе работает прежнее автораспределение по боксам. */
		margin-top: var(--hero-gap-c, auto); margin-bottom: -2vh;
		text-align: center;
	}
	/* Скрытие знака на низких окнах ОТМЕНЕНО (решение принято без согласования,
	   Кирилл: «оптимизация, которая убирает элемент — поломка»). Знак виден всегда
	   на ≥1024px; зазоры при нехватке высоты сжимаются сами. */

	html[data-decor='2'] :global(.hero-decor.decor-2 span),
	html:not([data-decor]) :global(.hero-decor.decor-2 span) {
		font-family: var(--font-display);
		/* Базовый размер — 20vw. Мягкое ограничение по высоте окна включается
		   только на невысоких окнах (ниже 820px), где знак иначе уходит выше
		   кнопки и подрезается нижним краем: на 1920×800 пиксельный зазор
		   был −3px. Это вариант B, выбранный Кириллом 2026-09-24. */
		font-size: 20vw; line-height: 0.8; letter-spacing: 0.02em;
		/* Рамка строчного бокса выше верхушек букв примерно на 0.12em (замер
		   пиксельно). Поднимаем буквы на эту величину, чтобы зазор «кнопка →
		   знак» считался от реальной верхней границы букв, как остальные два. */
		position: relative; top: -0.04em;
		color: var(--text); opacity: 0.18; white-space: nowrap;
	}
	/* Вариант B: мягкое ограничение знака по высоте окна. Правило стоит ПОСЛЕ
	   базового и с тем же селектором — если поставить его выше, базовый
	   font-size: 20vw его перекроет (на этих граблях уже стояли). */
	@media (min-width: 1024px) and (max-height: 820px) {
		html:not([data-decor]) :global(.hero-decor.decor-2 span),
		html[data-decor='2'] :global(.hero-decor.decor-2 span) {
			font-size: 30svh;
		}
	}
	html[data-decor='3'] .hero-decor.decor-3 { display: block; inset: 0; }
	/* v1 — резкий перепад: верх залит, переход на 40 % */
	html[data-decor='3'][data-c3v='1'] .hero-decor.decor-3 {
		background: linear-gradient(180deg, rgba(2,5,8,1) 0%, rgba(2,5,8,1) 40%, rgba(26,42,58,0.55) 100%);
	}
	/* v2 — с цветом палитры: сталь сверху, янтарь снизу */
	html[data-decor='3']:not([data-c3v='1']):not([data-c3v='3']) .hero-decor.decor-3 {
		background: linear-gradient(180deg, rgba(123,165,201,0.28) 0%, rgba(4,8,12,0.92) 48%, rgba(204,156,66,0.2) 100%);
	}
	/* v3 — виньетка: тёмные края, светлый центр */
	html[data-decor='3'][data-c3v='3'] .hero-decor.decor-3 {
		background: radial-gradient(125% 85% at 50% 46%, rgba(0,0,0,0) 28%, rgba(2,5,8,0.78) 72%, rgba(2,5,8,0.96) 100%);
	}
</style>
<style>
	.hero-dim {
		position: absolute;
		inset: 0;
		z-index: 40;
		background: rgba(4, 8, 11, 0.55);
		opacity: 0;
		transition: opacity 0.25s ease;
		pointer-events: none;
	}
	/* Фокус на молоте: пока летит — затемняем всё остальное. Состояние берём
	   прямо у слоя молота, поэтому JS для этого не нужен. */
	html[data-fly='dim'] section:has(.hero-hammer[data-state='flying']) .hero-dim { opacity: 1; }
	/* Десктоп: пока 3D-молот летит, сцена поднимается над текстом сцены входа. */
	/* :global() обязателен: .hero-3d живёт в React-компоненте Hero3D и атрибута
	   скоупа Astro не получает — со scoped-селектором правило не срабатывало. */
	html[data-flying='1'] :global(.hero-3d) { z-index: 60; }
</style>

<script>
	/* Переключатель декора: ?decor=1 (руны по краям) | 2 (водяной знак) | 3 (усиленный градиент). */
	const params = new URLSearchParams(location.search);
	const decor = params.get('hero') || params.get('decor') || '';
	if (decor.indexOf('decor-c') === 0) document.documentElement.dataset.decor = decor.slice(-1);
	else if (decor && decor.indexOf('decor') !== 0) document.documentElement.dataset.decor = decor;
</script>


<style>

	/* ── Призыв-триггер, теперь в слоте бывшей CTA ───────────────────────
	   Живёт внутри React-острова HeroIntro, поэтому только :global().
	   Слот — grid с одной ячейкой: призыв и рамка занимают одну точку. */
	/* :global() на всю цепочку: потомок "*" в scoped-стиле Astro требовал бы
	   атрибут скоупа у детей React-острова, а их у них нет. */
	/* Слот: по горизонтали — на прежнем месте (левый край колонки текста,
	   как у H1 и подзаголовка), по вертикали — центр свободной зоны между
	   подзаголовком и водяным знаком. auto-отступы делят остаток поровну,
	   нижний padding контейнера не пускает слот в буквы.
	   Ячейка общая и растянутая: призыв и рамка получают один и тот же бокс,
	   поэтому подмена не даёт сдвига, а центры совпадают. */
		:global(.hero-cta) {
		display: grid;
		justify-items: stretch;
		align-items: stretch;
		align-self: flex-start;
		/* Вертикальный ритм задаётся здесь и у подзаголовка одним числом:
		   равные отступы H1→подзаголовок→кнопка. Под кнопкой остаётся столько же
		   за счёт резерва под водяной знак у .hero-intro. */
		margin-top: 48px;
		margin-bottom: 0;
	}
	:global(.hero-cta > *) { grid-area: 1 / 1; }
	/* Оба состояния — одного размера: высота 60px у обоих, ячейка задаёт ширину,
	   текст по центру. Переключение не двигает ни низ блока, ни композицию. */
	:global(.hero-cta) { min-height: 60px; }
	:global(.hero-cta > *) {
		min-height: 60px; display: flex; align-items: center; justify-content: center;
		text-align: center; box-sizing: border-box;
	}
	:global(.hero-call) {
		margin: 0;
		text-align: left;
		font-family: var(--font-display);
		font-size: 1.25rem;
		line-height: 1.25;
		letter-spacing: 0.01em;
		color: var(--accent-warm);
		pointer-events: auto;
		cursor: pointer;
		transition: color 0.3s ease, opacity 0.3s ease;
	}
	:global(.hero-call:hover) { color: var(--text); }
	:global(.hero-call[data-done='1']) { opacity: 0; pointer-events: none; color: var(--text); }
	html[data-call='a'] :global(.hero-call) {
		padding: 12px 20px;
		border: 1px solid color-mix(in srgb, var(--accent-warm) 45%, transparent);
		border-radius: 14px;
		background: color-mix(in srgb, var(--bg-deep) 55%, transparent);
		backdrop-filter: blur(6px);
	}
	html[data-call='a'] :global(.hero-call:hover) {
		border-color: var(--accent-warm);
		background: color-mix(in srgb, var(--bg-deep) 72%, transparent);
	}
	html[data-call='b'] :global(.hero-call) {
		padding: 14px 22px;
		border: 1px solid transparent;
		border-radius: 14px;
		background: none;
	}
	html[data-call='b'] :global(.hero-call:hover) { border-color: var(--accent-warm); }
	@media (min-width: 1024px) {
		:global(.hero-call) { font-size: 1.625rem; max-width: 560px; }
		/* Резерв больше не нужен: знак-2 стоит в потоке и занимает свою полосу сам,
		   отступ до него даёт margin-top: auto. */
		:global(.hero-intro) { padding-bottom: 0; }
	}


	/* ── Вертикальный ритм Hero: два варианта (?spacing=1|2) ────────────
	   Вариант 1 (по умолчанию) — точное центрирование: отступ H1→подзаголовок
	   равен отступу подзаголовок→кнопка, под кнопкой столько же до знака.
	   Вариант 2 — минимальные равные 28px. Горизонталь не трогаем. */
	/* Отступы. По умолчанию — пиксельные «Авто-равные»: модуль src/lib/heroGaps.ts
	   считает три отступа по КРАСКЕ букв (не по боксам) и кладёт их в
	   --hero-gap-a|b|c на .hero-intro, поэтому визуальные зазоры равны, хотя
	   боксы у всех разные. Пока переменных нет (JS не успел, узкий экран),
	   работает прежнее автораспределение по боксам.
	   Атрибут data-spacing='24|32|40|48|56' ставит фиксированный зазор между
	   H1 → подзаголовком → призывом (знак остаётся прижат к низу автополем). */
	:global(.hero-sub) { margin-top: var(--hero-gap-a, auto); }
	:global(.hero-cta) { margin-top: var(--hero-gap-b, auto); }
	/* Поправка центрирования подзаголовка (была margin-bottom: −11px под кегль
	   21px) снята: в пиксельном авто её роль играет расчёт по глифам, а в
	   фиксированных режимах она ломала их смысл — «48px» давало 48 по первому
	   зазору и 37 по второму. Теперь фиксированный режим = ровно N px между
	   боксами, а визуальные зазоры показывает отладка на /hero-spacing-preview. */
	html[data-spacing='24'] :global(.hero-sub), html[data-spacing='24'] :global(.hero-cta) { margin-top: 24px; }
	html[data-spacing='32'] :global(.hero-sub), html[data-spacing='32'] :global(.hero-cta) { margin-top: 32px; }
	html[data-spacing='40'] :global(.hero-sub), html[data-spacing='40'] :global(.hero-cta) { margin-top: 40px; }
	html[data-spacing='48'] :global(.hero-sub), html[data-spacing='48'] :global(.hero-cta) { margin-top: 48px; }
	html[data-spacing='56'] :global(.hero-sub), html[data-spacing='56'] :global(.hero-cta) { margin-top: 56px; }
	/* Размер подзаголовка — варианты кнопками на /hero-spacing-preview (правило 20.6).
	   База — 24px (задана выше в герой-блоке), здесь только отклонения от неё. */
	@media (min-width: 1024px) {
		html[data-sub='21'] :global(.hero-sub) { font-size: 1.3125rem; }
		html[data-sub='22'] :global(.hero-sub) { font-size: 1.375rem; }
		html[data-sub='26'] :global(.hero-sub) { font-size: 1.625rem; }
	}
	/* Мобильный: знака нет, автополя растянули бы два зазора на всю высоту
	   (измерено 253px на 390×844) — там держим прежние фиксированные 48px. */
	@media (max-width: 1023px) {
		:global(.hero-sub), :global(.hero-cta) { margin-top: 48px; }
	}

	/* ── Рамка-кнопка §10.3.1 (скелет, без огня) ─────────────────────────
	   До прилёта рамки нет: на этом месте стоит призыв «Нажми — узнаешь…».
	   После посадки молота призыв гаснет, рамка проявляется. */
	:global(.hero-frame) {
		display: none;
		font-family: var(--font-display);
		font-size: 1.375rem;
		letter-spacing: 0.06em;
		line-height: 1.2;
		color: var(--text);
		background: none;
		/* Тот же стиль, что у призыва-триггера: закругление, толщина и цвет. */
		border: 1px solid color-mix(in srgb, var(--accent-warm) 45%, transparent);
		border-radius: 14px;
		background: color-mix(in srgb, var(--bg-deep) 55%, transparent);
		backdrop-filter: blur(6px);
		padding: 0.9rem 2rem;
		/* Размер задаёт общая ячейка слота — он же, что у призыва. */
		cursor: pointer;
		pointer-events: auto;
		position: relative;
		text-align: center;
		transition: border-color 0.25s ease, background 0.25s ease, color 0.25s ease;
	}
	:global(.hero-frame__label--mobile) { display: none; }
	:global(.hero-frame__label--hover) { display: none; }
	/* Наведение: надпись меняется на «Записаться». Огонь — этап 2. */
	:global(.hero-frame:hover) :global(.hero-frame__label--desktop) { display: none; }
	:global(.hero-frame:hover) :global(.hero-frame__label--hover) { display: inline; }
	body:has(.hero-hammer[data-state='landed']) :global(.hero-frame),
	html[data-cta-preview='now'] :global(.hero-frame),
	html[data-cta-preview='both'] :global(.hero-frame) { display: inline-block; }
	/* Режим превью «оба сразу»: рамка поверх полупрозрачного призыва — видно,
	   что боксы и стили совпадают. На главной такого режима нет. */
	html[data-cta-preview='both'] :global(.hero-call[data-done='1']) { opacity: 0.35; pointer-events: none; }

	/* Стиль A — тонкая рамка accent, минимум декора (по умолчанию). */
	/* Стиль B — рамка 2px и угловые насечки, как руны. */
	html[data-cta='b'] :global(.hero-frame) { border-width: 2px; }
	html[data-cta='b'] :global(.hero-frame)::before,
	html[data-cta='b'] :global(.hero-frame)::after {
		content: ''; position: absolute; width: 14px; height: 14px;
		border: 2px solid var(--accent-warm);
	}
	html[data-cta='b'] :global(.hero-frame)::before { top: -6px; left: -6px; border-right: 0; border-bottom: 0; }
	html[data-cta='b'] :global(.hero-frame)::after { bottom: -6px; right: -6px; border-left: 0; border-top: 0; }
	/* Стиль C — рамка с лёгкой подложкой. */
	html[data-cta='c'] :global(.hero-frame) {
		border-width: 2px;
		background: color-mix(in srgb, var(--surface) 72%, transparent);
		backdrop-filter: blur(6px);
	}

	:global(.hero-frame:hover) { border-color: var(--accent-warm); color: var(--accent-warm); }
	:global(.hero-frame.is-pulse) { animation: cta-pulse 400ms ease; }
	@keyframes cta-pulse {
		0% { border-color: var(--accent); box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent); }
		50% { border-color: var(--accent-warm); box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 0%, transparent); }
		100% { border-color: var(--accent); box-shadow: none; }
	}
	@media (max-width: 1023px) {
		:global(.hero-frame) { min-width: 0; font-size: 1.0625rem; padding: 0.85rem 1.25rem; }
		:global(.hero-frame__label--desktop) { display: none; }
		:global(.hero-frame__label--mobile) { display: inline; }
	}
	@media (prefers-reduced-motion: reduce) {
		:global(.hero-frame.is-pulse) { animation: none; }
	}

</style>

<script>
	/* Рамка-кнопка §10.3.1: клик — короткая вспышка рамки, затем скролл к форме.
	   Огонь по рамке будет этапом 2, здесь только механика. */
	const heroFrame = document.getElementById('hero-frame');
	/* Переключатели для /hero-cta-preview. */
	const ctaParams = new URLSearchParams(location.search);
	const ctaStyle = ctaParams.get('cta');
	if (ctaStyle) document.documentElement.dataset.cta = ctaStyle;
	const spacing = ctaParams.get('spacing');
	if (spacing) document.documentElement.dataset.spacing = spacing;

	if (heroFrame) {
		heroFrame.addEventListener('click', () => {
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const go = () => {
				const target = document.getElementById('contact');
				if (target) target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
				history.replaceState(null, '', '#contact');
			};
			if (reduced) { go(); return; }
			heroFrame.classList.add('is-pulse');
			window.setTimeout(() => { heroFrame.classList.remove('is-pulse'); go(); }, 400);
		});
	}

	(window as any).__cta = {
		style: (v: string) => { document.documentElement.dataset.cta = v; },
		show: (mode: string) => {
			if (mode === 'after') delete document.documentElement.dataset.ctaPreview;
			else document.documentElement.dataset.ctaPreview = mode;
		},
		spacing: (v: string) => {
			if (v === '1') delete document.documentElement.dataset.spacing;
			else document.documentElement.dataset.spacing = v;
		},
		gaps: () => {
			const g = (s: string) => document.querySelector(s)?.getBoundingClientRect() ?? null;
			const h1 = g('.hero-intro h1'), sub = g('.hero-sub'), slot = g('.hero-cta'), dec = g('.decor-2');
			if (!h1 || !sub || !slot) return null;
			return {
				h1_подзаг: Math.round(sub.top - h1.bottom),
				подзаг_кнопка: Math.round(slot.top - sub.bottom),
				кнопка_знак: dec ? Math.round(dec.top - slot.bottom) : null,
			};
		},
		state: () => {
			const el = document.getElementById('hero-frame');
			return {
				cta: document.documentElement.dataset.cta || 'a',
				preview: document.documentElement.dataset.ctaPreview || 'after',
				visible: el ? getComputedStyle(el).display !== 'none' : null,
				label: el ? (el as HTMLElement).innerText.trim().split('\n')[0] : null,
			};
		},
	};
</script>

<noscript>
	<!-- Без JS сцена входа не проигрывается, а в SSR-разметке лежат её
	     стартовые стили. Принудительно показываем текст в конечном виде. -->
	<style>
		#top p,
		#top h1 span span,
		#top a {
			opacity: 1 !important;
			filter: none !important;
			transform: none !important;
		}
	</style>
</noscript>

<style is:global>
	/* ── Скрим под строкой H1 ──────────────────────────────────────────
	   Принят Кириллом для 360px, где молот вплотную подходил к строке и
	   контраст упирался в порог. Живёт только на мобильном и только под
	   текстом: псевдоэлемент самой строки, слоем ниже её глифов, поэтому
	   он едет за заголовком и не затемняет молот целиком. */
	@media (max-width: 1023px) {
		#top h1 {
			position: relative;
		}
		#top h1::before {
			content: '';
			position: absolute;
			inset: -0.3em -0.45em;
			background: radial-gradient(
				62% 62% at 26% 50%,
				color-mix(in oklab, var(--bg-deep) 62%, transparent) 0%,
				color-mix(in oklab, var(--bg-deep) 34%, transparent) 55%,
				transparent 78%
			);
			filter: blur(14px);
			z-index: -1;
			pointer-events: none;
		}
	}

	/* ── Контент прижат к шапке (выбранный вариант A) ──────────────────
	   Убирает пустое поле между шапкой и надзаголовком: отступ 88px —
	   это высота шапки плюс дыхание. Только мобильный. */
	@media (max-width: 1023px) {
