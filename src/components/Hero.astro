---
// Hero: кадр на всю высоту. Слои снизу вверх:
//   0 — видео-фон, 1 — затемняющие градиенты, 2 — 3D-молот (десктоп),
//   3 — текстовая сцена входа + индикатор скролла.
// Видео и градиенты не перехватывают курсор.
import Hero3D from './Hero3D';
import HeroIntro from './HeroIntro';
---

<section
	id="top"
	class="relative h-[100svh] min-h-[560px] w-full overflow-hidden border-b border-border lg:h-[100dvh]"
>
	<!-- Слой 0: видео. Файл зеркальный — дым уходит вправо, под молот, а левая
	     треть остаётся тёмной под заголовок. Это раскладка, которая нужна
	     композиции: текст слева на тёмном, дым справа. -->
	<video
		data-hero-video
		class="absolute inset-0 z-0 h-full w-full object-cover opacity-80"
		autoplay
		loop
		muted
		playsinline
		preload="metadata"
		poster="/hero-poster.jpg"
		aria-hidden="true"
	>
		<source src="/hero-bg.mp4" type="video/mp4" />
	</video>

	<!-- Слой 1: затемнение. Вертикальный лёгкий (0.35→0.6): прежние 0.6→0.95
	     перемножались с горизонтальным и пропускали около 8% картинки — дым
	     тонул. Горизонтальный держит тёмной левую треть и сходит в ноль правее 85%. -->
	<div
		class="pointer-events-none absolute inset-0 z-[1]"
		style="background-image: linear-gradient(180deg, rgba(6,10,14,0.35) 0%, rgba(6,10,14,0.3) 45%, rgba(6,10,14,0.6) 100%), linear-gradient(90deg, rgba(6,10,14,0.85) 0%, rgba(6,10,14,0.6) 35%, rgba(6,10,14,0.15) 55%, rgba(6,10,14,0) 85%);"
	>
	</div>

	<!-- Слой 2: 3D-молот. client:media — на мобильных остров вообще не загружается -->
	<Hero3D client:media="(min-width: 1024px)" />

	<!-- Слой 3: сцена входа -->
	<HeroIntro client:load />
</section>

<script>
	// prefers-reduced-motion: видео не крутим, оставляем постер
	const video = document.querySelector('[data-hero-video]');
	if (video && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		video.removeAttribute('autoplay');
		video.pause();
		video.currentTime = 0;
	}
</script>

<noscript>
	<!-- Без JS сцена входа не проигрывается, а в SSR-разметке лежат её
	     стартовые стили. Принудительно показываем текст в конечном виде. -->
	<style>
		#top p,
		#top h1 span span,
		#top a {
			opacity: 1 !important;
			filter: none !important;
			transform: none !important;
		}
	</style>
</noscript>
