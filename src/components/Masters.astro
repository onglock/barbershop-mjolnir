---
// Мастерская: три карточки с двумя фото. Кадр каждого разрезан по белой линии:
// слева «до», справа «после». Второй слой открывается clip-path-веером из левого
// верхнего угла — угол 25°, раскрыто 85 % кадра (решение Кирилла 2026-09-24).
// Подпись карточки — только тип услуги; имена, роли и описательные тексты убраны
// (решения Кирилла 2026-09-24). Выравнивания лиц нет: масштаб обрезал кадр.
// Отступы секции — как у соседей: py-8 / lg:py-10 (32/40, решение Кирилла
// 2026-09-24). Выравнивания лиц нет: масштаб обрезал кадр.
// Подъём и акцентная граница на hover — как было, чистый CSS.
import { Image } from 'astro:assets';
import master01 from '../assets/master-01.jpg';
import master02 from '../assets/master-02.jpg';
import master03 from '../assets/master-03.jpg';
import master01After from '../assets/master-01-after.jpg';
import master02After from '../assets/master-02-after.jpg';
import master03After from '../assets/master-03-after.jpg';

const masters = [
	{
		photo: master01,
		photoAfter: master01After,
		service: 'Королевское бритьё',
		alt: '«До»: длинные волосы и борода',
		altAfter: '«После»: короткая стрижка и борода',
		shift: { x: 0, y: 0 },
	},
	{
		photo: master02,
		photoAfter: master02After,
		service: 'Мужская стрижка',
		alt: '«До»: отросшая форма',
		altAfter: '«После»: короткая стрижка',
		shift: { x: 0, y: 0 },
	},
	{
		photo: master03,
		photoAfter: master03After,
		service: 'Стрижка с машинкой',
		alt: '«До»: длинные волосы и борода',
		altAfter: '«После»: короткая стрижка и чистое лицо',
		shift: { x: 0, y: 0 },
	},
];
---

<section id="transformations" class="scroll-mt-24 border-b border-border px-6 py-8 lg:px-8 lg:py-10">
	<div class="mx-auto max-w-[1400px]">
		<p class="font-label text-label uppercase text-text-muted">Мастерская</p>

		<h2 class="mt-6 max-w-[14ch] text-h2 uppercase text-text">Облик — наше ремесло</h2>

		<div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
			{
				masters.map((master) => (
					<article class="flex flex-col border border-border transition-all duration-300 ease-hover hover:-translate-y-1 hover:border-accent">
						<div class="masters-media">
							<Image
								src={master.photo}
								alt={master.alt}
								widths={[345, 420]}
								sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
								format="webp"
								quality={80}
								loading="lazy"
								decoding="async"
								class="masters-img"
							/>
							<!-- Второй слой: клип живёт на обёртке, сдвиг выравнивания — на
							     самом фото, иначе сдвиг утащил бы за собой клип. Масштаба
							     нет: он обрезал кадр. -->
							<div
								class="masters-img masters-img--top"
								style={`--mb-shift-x: ${master.shift.x}%; --mb-shift-y: ${master.shift.y}%;`}
							>
								<Image
									src={master.photoAfter}
									alt={master.altAfter}
									widths={[345, 420]}
									sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
									format="webp"
									quality={80}
									loading="lazy"
									decoding="async"
									class="masters-img masters-img--inner"
								/>
							</div>
						</div>

						<div class="flex flex-1 flex-col items-center justify-center p-6 text-center">
							<h3 class="text-body font-medium uppercase text-text">{master.service}</h3>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	/* Первое фото — в потоке, второе («после») лежит поверх и открывается
	   clip-path-веером из верхнего угла (решение Кирилла 2026-09-24: веер
	   вместо клина). --mb-fan-x = 70 % — точка выхода кромки на нижней стороне,
	   это угол 25° и 85 % раскрытого кадра. Углы и вершина подбираются кнопками
	   на превью /masters-hover-preview (20/22/25/28/30°). */
	.masters-media {
		position: relative;
		overflow: hidden;
	}
	.masters-img {
		display: block;
		width: 100%;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border-bottom: 1px solid var(--border);
	}
	/* Обёртка второго слоя: клип и переход живут здесь. */
	.masters-img--top {
		position: absolute;
		inset: 0;
		border-bottom: 0;
		/* закрытое состояние: веер вырожден в верхний левый угол */
		clip-path: polygon(0 0, 0% 0%, 0% 100%, 0 100%);
		transition: clip-path 500ms cubic-bezier(0.33, 1, 0.68, 1);
		will-change: clip-path;
	}
	/* Фото внутри обёртки: сдвиг выравнивания лиц. Масштаба нет — масштаб
	   обрезал кадр, из-за него у «после» срезало нос (Кирилл, 2026-09-24). */
	.masters-img--inner {
		position: absolute;
		inset: 0;
		height: 100%;
		transform: translate(var(--mb-shift-x, 0), var(--mb-shift-y, 0));
	}
	.masters-media:hover .masters-img--top,
	.masters-media.is-on .masters-img--top {
		clip-path: polygon(0 0, 130% 0%, var(--mb-fan-x, 70%) 100%, 0 100%);
	}
	/* Кирилл: при reduced-motion «после» показывается мгновенно, без анимации. */
	@media (prefers-reduced-motion: reduce) {
		.masters-img--top { transition: none; }
		.masters-media:hover .masters-img--top,
		.masters-media.is-on .masters-img--top {
			clip-path: polygon(0 0, 130% 0%, var(--mb-fan-x, 70%) 100%, 0 100%);
		}
	}
</style>

<script>
	/* Клип курсор не двигает — вершина всегда в верхнем углу, поэтому из JS
	   осталось только тач-переключение: на устройстве без наведения тап
	   открывает и закрывает «после» (решение Кирилла — мгновенно). */
	document.querySelectorAll<HTMLElement>('.masters-media').forEach((media) => {
		media.addEventListener('click', () => {
			if (window.matchMedia('(hover: none)').matches || window.innerWidth < 1024) {
				media.classList.toggle('is-on');
			}
		});
	});
</script>
