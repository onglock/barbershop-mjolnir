---
// Мастера: три карточки с двумя фото. Кадр каждого мастера разрезан по белой
// линии: слева «до», справа «после». Второй слой открывается clip-path-клином
// от верхнего правого угла (решение Кирилла 2026-09-24).
// Лица «до» и «после» выровнены сдвигом второго слоя: shift — сдвиг в процентах
// карточки, найденный корреляцией по голове (Δ = «после» − «до», в CSS знак
// обратный); scale закрывает края, которые иначе обнажил бы сдвиг.
// Подъём и акцентная граница на hover — как было, чистый CSS.
import { Image } from 'astro:assets';
import master01 from '../assets/master-01.jpg';
import master02 from '../assets/master-02.jpg';
import master03 from '../assets/master-03.jpg';
import master01After from '../assets/master-01-after.jpg';
import master02After from '../assets/master-02-after.jpg';
import master03After from '../assets/master-03-after.jpg';

const masters = [
	{
		photo: master01,
		photoAfter: master01After,
		name: 'Артём Соколов',
		role: 'старший мастер',
		alt: 'Артём Соколов — «до»: длинные волосы и борода',
		altAfter: 'Артём Соколов — «после»: короткая стрижка и борода',
		shift: { x: 0, y: 0 },
		text: 'Двенадцать лет в профессии, начинал в Петербурге. Классические мужские формы и тонкие волосы — его тема. Ведёт молодых мастеров цеха.',
	},
	{
		photo: master02,
		photoAfter: master02After,
		name: 'Данил Ковалёв',
		role: 'барбер',
		alt: 'Данил Ковалёв — «до»: отросшая форма',
		altAfter: 'Данил Ковалёв — «после»: короткая стрижка',
		shift: { x: 0, y: 0 },
		text: 'Шесть лет за креслом. Быстро и точно работает машинкой, любит фейды и короткие формы. Подбирает укладку под тип волос за пару минут.',
	},
	{
		photo: master03,
		photoAfter: master03After,
		name: 'Максим Лебедев',
		role: 'мастер бритья',
		alt: 'Максим Лебедев — «до»: длинные волосы и борода',
		altAfter: 'Максим Лебедев — «после»: короткая стрижка и чистое лицо',
		shift: { x: 0, y: 0 },
		text: 'Девять лет, из них пять — только бритьё. Держит опасную бритву так, что клиенты засыпают в кресле. Делает королевское бритьё и камуфляж седины.',
	},
];
---

<section id="masters" class="scroll-mt-24 border-b border-border px-6 py-24 lg:px-8 lg:py-32">
	<div class="mx-auto max-w-[1400px]">
		<p class="font-label text-label uppercase text-text-muted">Мастера</p>

		<h2 class="mt-6 max-w-[14ch] text-display uppercase text-text">Кто стрижёт</h2>

		<div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
			{
				masters.map((master) => (
					<article class="border border-border transition-all duration-300 ease-hover hover:-translate-y-1 hover:border-accent">
						<div class="masters-media">
							<Image
								src={master.photo}
								alt={master.alt}
								widths={[345, 420]}
								sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
								format="webp"
								quality={80}
								loading="lazy"
								decoding="async"
								class="masters-img"
							/>
							<!-- Второй слой: клип живёт на обёртке, сдвиг выравнивания — на
							     самом фото, иначе сдвиг утащил бы за собой клип. Масштаба
							     нет: он обрезал кадр. -->
							<div
								class="masters-img masters-img--top"
								style={`--mb-shift-x: ${master.shift.x}%; --mb-shift-y: ${master.shift.y}%;`}
							>
								<Image
									src={master.photoAfter}
									alt={master.altAfter}
									widths={[345, 420]}
									sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
									format="webp"
									quality={80}
									loading="lazy"
									decoding="async"
									class="masters-img masters-img--inner"
								/>
							</div>
						</div>

						<div class="p-6">
							<h3 class="text-body font-medium uppercase text-text">{master.name}</h3>
							<p class="mt-2 font-label text-label uppercase text-text-muted">{master.role}</p>
							<p class="mt-4 text-body text-text-muted">{master.text}</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	/* Первое фото — в потоке, второе («после») лежит поверх и открывается
	   clip-path-веером из верхнего угла (решение Кирилла 2026-09-24: веер
	   вместо клина). --mb-fan-x = 70 % — точка выхода кромки на нижней стороне,
	   это угол 25° и 85 % раскрытого кадра. Углы и вершина подбираются кнопками
	   на превью /masters-hover-preview (20/22/25/28/30°). */
	.masters-media {
		position: relative;
		overflow: hidden;
	}
	.masters-img {
		display: block;
		width: 100%;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border-bottom: 1px solid var(--border);
	}
	/* Обёртка второго слоя: клип и переход живут здесь. */
	.masters-img--top {
		position: absolute;
		inset: 0;
		border-bottom: 0;
		/* закрытое состояние: веер вырожден в верхний левый угол */
		clip-path: polygon(0 0, 0% 0%, 0% 100%, 0 100%);
		transition: clip-path 500ms cubic-bezier(0.33, 1, 0.68, 1);
		will-change: clip-path;
	}
	/* Фото внутри обёртки: сдвиг выравнивания лиц. Масштаба нет — масштаб
	   обрезал кадр, из-за него у «после» срезало нос (Кирилл, 2026-09-24). */
	.masters-img--inner {
		position: absolute;
		inset: 0;
		height: 100%;
		transform: translate(var(--mb-shift-x, 0), var(--mb-shift-y, 0));
	}
	.masters-media:hover .masters-img--top,
	.masters-media.is-on .masters-img--top {
		clip-path: polygon(0 0, 130% 0%, var(--mb-fan-x, 70%) 100%, 0 100%);
	}
	/* Кирилл: при reduced-motion «после» показывается мгновенно, без анимации. */
	@media (prefers-reduced-motion: reduce) {
		.masters-img--top { transition: none; }
		.masters-media:hover .masters-img--top,
		.masters-media.is-on .masters-img--top {
			clip-path: polygon(0 0, 130% 0%, var(--mb-fan-x, 70%) 100%, 0 100%);
		}
	}
</style>

<script>
	/* Клин курсор не двигает — старт всегда в верхнем правом углу, поэтому из JS
	   осталось только тач-переключение: на устройстве без наведения тап
	   открывает и закрывает «после» (решение Кирилла — мгновенно). */
	document.querySelectorAll<HTMLElement>('.masters-media').forEach((media) => {
		media.addEventListener('click', () => {
			if (window.matchMedia('(hover: none)').matches || window.innerWidth < 1024) {
				media.classList.toggle('is-on');
			}
		});
	});
</script>
