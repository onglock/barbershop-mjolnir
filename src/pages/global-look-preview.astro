---
// /global-look-preview — развилки глобального вида секций (правило 20.6: варианты
// показываются кнопками на живой странице, а не скриншотами).
//   Ряд 1 — отступы секций: сейчас (96/128) | A 32/40 | B 48/64 | C 64/80
//   Ряд 2 — размер заголовков: сейчас | A −10 % | B −15 %
//   Ряд 3 — фон секций: без фона | 0.3 | 0.4 | 0.5
//   Ряд 4 — позиция фона: fixed | absolute
// Секции рендерятся настоящими компонентами — видно в контексте, а не абстрактно.
// Hero и ContactForm не участвуют: у Hero своя композиция, у формы своё решение
// (верхний padding 16 px, прижато к шапке). Hero не трогаем вовсе.
import Layout from '../layouts/Layout.astro';
import Manifest from '../components/Manifest.astro';
import Services from '../components/Services';
import Masters from '../components/Masters.astro';
import Faq from '../components/Faq';
import Testimonials from '../components/Testimonials.astro';
import Footer from '../components/Footer.astro';

const rows = [
	{
		group: 'sp',
		label: 'Отступы секций (верх/низ)',
		options: [
			{ value: 'now', label: 'сейчас 96/128' },
			{ value: 'a', label: 'A — 32/40' },
			{ value: 'b', label: 'B — 48/64' },
			{ value: 'c', label: 'C — 64/80' },
		],
	},
	{
		group: 'hs',
		label: 'Размер заголовков секций (h2)',
		options: [
			{ value: 'now', label: 'сейчас (100 %)' },
			{ value: 'a', label: 'A — минус 10 %' },
			{ value: 'b', label: 'B — минус 15 %' },
		],
	},
	{
		group: 'bg',
		label: 'Фон секций (opacity)',
		options: [
			{ value: 'off', label: 'без фона (сейчас)' },
			{ value: '0.3', label: '0.3' },
			{ value: '0.4', label: '0.4' },
			{ value: '0.5', label: '0.5 — как в Hero' },
		],
	},
	{
		group: 'bgpos',
		label: 'Позиция фона',
		options: [
			{ value: 'fixed', label: 'fixed — не скроллится' },
			{ value: 'absolute', label: 'absolute — скроллится' },
		],
	},
];
---

<Layout title="Глобальный вид — превью">
	<div class="glp-page" id="glp">
		<div class="glp-bar" data-pp>
			<p class="glp-title">Глобальный вид секций — превью</p>
			<p class="glp-note">
				Hero и форма записи не участвуют: у Hero своя композиция, у формы своё решение
				(верхний отступ 16 px, прижато к шапке). Секции — настоящие компоненты.
			</p>
			{
				rows.map((row) => (
					<div class="glp-row">
						<span class="glp-row-label">{row.label}</span>
						<span class="glp-row-btns">
							{row.options.map((opt) => (
								<button
									type="button"
									class="glp-btn"
									data-glp-group={row.group}
									data-glp-value={opt.value}
									aria-pressed="false"
								>
									{opt.label}
								</button>
							))}
						</span>
					</div>
				))
			}
			<p class="glp-state" id="glp-state">Состояние: —</p>
		</div>

		<!-- Общий фон: тот же кадр, что в Hero (/hero-bg/hero-bg-main.jpg).
		     z-index: −1 — над фоном страницы, под всем контентом. -->
		<div class="glp-bg" aria-hidden="true"></div>

		<div class="glp-sections">
			<Manifest />
			<Services client:visible />
			<Masters />
			<Faq client:visible />
			<Testimonials />
			<Footer />
		</div>
	</div>
</Layout>

<style>
	/* Тонкая страница-обёртка: превью не должно влиять на главную. */
	.glp-page {
		position: relative;
	}

	/* ── Панель управления ──────────────────────────────────────────── */
	.glp-bar {
		position: sticky;
		top: 0;
		z-index: 50;
		padding: 12px 24px 14px;
		border-bottom: 1px solid var(--border);
		background: color-mix(in srgb, var(--bg-deep) 88%, transparent);
		backdrop-filter: blur(10px);
	}
	.glp-title {
		font-family: var(--font-label);
		font-size: var(--text-label);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text);
	}
	.glp-note {
		margin-top: 6px;
		max-width: 92ch;
		font-size: 13px;
		line-height: 1.45;
		color: var(--text-muted);
	}
	.glp-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin-top: 10px;
	}
	.glp-row-label {
		min-width: 232px;
		font-family: var(--font-label);
		font-size: var(--text-label);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.glp-row-btns {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.glp-btn {
		min-height: 40px;
		padding: 8px 14px;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: transparent;
		font-family: var(--font-label);
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
		cursor: pointer;
		transition: border-color 200ms cubic-bezier(0.33, 1, 0.68, 1), color 200ms cubic-bezier(0.33, 1, 0.68, 1);
	}
	.glp-btn:hover {
		border-color: var(--accent);
		color: var(--text);
	}
	.glp-btn[aria-pressed='true'] {
		border-color: var(--accent);
		color: var(--text);
		background: color-mix(in srgb, var(--accent) 14%, transparent);
	}
	.glp-state {
		margin-top: 10px;
		font-family: var(--font-label);
		font-size: var(--text-label);
		letter-spacing: 0.06em;
		color: var(--accent-warm);
	}

	/* ── Общий фон секций ───────────────────────────────────────────── */
	.glp-bg {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background-image: url('/hero-bg/hero-bg-main.jpg');
		background-size: cover;
		background-position: center 45%;
		background-repeat: no-repeat;
		opacity: 0;
		transition: opacity 300ms cubic-bezier(0.33, 1, 0.68, 1);
	}
	/* Absolute-вариант: слой растянут на всю высоту документа и скроллится. */
	html[data-bgpos='absolute'] .glp-bg {
		position: absolute;
		inset: 0;
	}
	html[data-bg='0.3'] .glp-bg { opacity: 0.3; }
	html[data-bg='0.4'] .glp-bg { opacity: 0.4; }
	html[data-bg='0.5'] .glp-bg { opacity: 0.5; }
	html[data-bg='off'] .glp-bg { opacity: 0; }

	/* Футер на сайте sticky (bottom: 0) и на живых страницах прикрыт непрозрачным
	   `main` (`relative z-10 bg-bg`) — приём «футер открывается под контентом».
	   В превью этого слоя нет и быть не может: фон секций должен просвечивать.
	   Поэтому здесь футер снова обычный блок, иначе он виден посреди страницы. */
	:global(.glp-sections > footer),
	:global(.glp-sections > astro-island > footer) {
		position: static !important;
		z-index: auto !important;
	}

	/* ── Ряд 1: отступы секций ────────────────────────────────────────
	   Всё через :global(): секции приходят из других компонентов и атрибута
	   скоупа этой страницы не имеют, поэтому scoped-селекторы молча не
	   срабатывали (`py-24 lg:py-32` продолжал побеждать). */
	:global(html[data-sp='now']) { --glp-pt-m: 96px;  --glp-pt-d: 128px; }
	:global(html[data-sp='a'])   { --glp-pt-m: 32px;  --glp-pt-d: 40px; }
	:global(html[data-sp='b'])   { --glp-pt-m: 48px;  --glp-pt-d: 64px; }
	:global(html[data-sp='c'])   { --glp-pt-m: 64px;  --glp-pt-d: 80px; }

	/* Секции приходят и как .astro (прямой ребёнок), и как React-острова
	   (внутри <astro-island>), поэтому селектор покрывает оба случая. */
	:global(.glp-sections > :is(section, footer)),
	:global(.glp-sections > astro-island > :is(section, footer)) {
		padding-top: var(--glp-pt-m, 96px) !important;
		padding-bottom: var(--glp-pt-m, 96px) !important;
	}
	@media (min-width: 1024px) {
		:global(.glp-sections > :is(section, footer)),
		:global(.glp-sections > astro-island > :is(section, footer)) {
			padding-top: var(--glp-pt-d, 128px) !important;
			padding-bottom: var(--glp-pt-d, 128px) !important;
		}
	}

	/* ── Ряд 2: размер заголовков секций ─────────────────────────────
	   Только h2: Hero H1 не участвует (его тут нет), водяной знак и цифры
	   Manifest тоже остаются нетронутыми — это не заголовки. */
	:global(html[data-hs='now']) { --glp-h2: 1; }
	:global(html[data-hs='a'])   { --glp-h2: 0.9; }
	:global(html[data-hs='b'])   { --glp-h2: 0.85; }
	:global(.glp-sections h2) {
		font-size: calc(var(--text-display) * var(--glp-h2, 1)) !important;
	}
</style>

<script>
	type Groups = { sp: string; hs: string; bg: string; bgpos: string };

	const groups: Groups = { sp: 'now', hs: 'now', bg: '0.5', bgpos: 'fixed' };

	const LABELS: Record<string, Record<string, string>> = {
		sp: { now: 'сейчас 96/128', a: 'A 32/40', b: 'B 48/64', c: 'C 64/80' },
		hs: { now: 'сейчас (100 %)', a: 'A −10 %', b: 'B −15 %' },
		bg: { off: 'без фона', '0.3': '0.3', '0.4': '0.4', '0.5': '0.5' },
		bgpos: { fixed: 'fixed', absolute: 'absolute' },
	};

	function apply() {
		const root = document.documentElement;
		root.dataset.sp = groups.sp;
		root.dataset.hs = groups.hs;
		root.dataset.bg = groups.bg;
		root.dataset.bgpos = groups.bgpos;

		document.querySelectorAll<HTMLButtonElement>('[data-glp-group]').forEach((btn) => {
			const g = btn.dataset.glpGroup || '';
			btn.setAttribute('aria-pressed', String(btn.dataset.glpValue === groups[g as keyof Groups]));
		});

		const state = document.getElementById('glp-state');
		if (state) {
			state.textContent =
				`Состояние: отступы ${LABELS.sp[groups.sp]} · заголовки ${LABELS.hs[groups.hs]} · ` +
				`фон ${LABELS.bg[groups.bg]} / ${groups.bgpos}`;
		}
	}

	document.querySelectorAll<HTMLButtonElement>('[data-glp-group]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const g = btn.dataset.glpGroup as keyof Groups;
			const v = btn.dataset.glpValue || '';
			groups[g] = v;
			apply();
		});
	});

	apply();

	/* Ручка для замеров (контраст, FPS) — как на других превью проекта. */
	(window as any).__glp = {
		set: (o: Partial<Groups>) => { Object.assign(groups, o); apply(); return { ...groups }; },
		state: () => ({ ...groups }),
	};
</script>
