---
/**
 * ВРЕМЕННАЯ dev-страница: сравнение картинок-молотов для Hero (§17).
 *
 * Кирилл приносит картинки (Pinterest-доска или локальные файлы) — здесь они
 * показываются в контексте главной, переключение кнопками 1–7, два режима:
 * «фон» (картинка во весь Hero) и «карточка» (картинка отдельной панелью).
 *
 * Самодостаточна: рабочие компоненты (Header, Hero, Hero3D) не задействованы.
 * В прод не собирается — редирект на главную; файл удаляется перед деплоем.
 */
import '../styles/global.css';

if (import.meta.env.PROD) return Astro.redirect('/');

/** Семь вариантов: три скачаны с доски https://ru.pinterest.com/dnsuser895/molot/,
 *  четыре — локальные файлы, которые Кирилл принёс раньше. Разрешения замерены sips. */
const variants = [
  { n: 1, file: 'board-01.jpg', src: 'доска · Ragnir (молот Локи)', w: 564, h: 840, kb: 94 },
  { n: 2, file: 'board-02.jpg', src: 'доска · 736×736', w: 736, h: 736, kb: 97 },
  { n: 3, file: 'board-03.jpg', src: 'доска · третий пин', w: 564, h: 846, kb: 92 },
  { n: 4, file: 'local-1.jpg', src: 'локальный · молот норм', w: 474, h: 727, kb: 42 },
  { n: 5, file: 'local-2.jpg', src: 'локальный · молот', w: 474, h: 842, kb: 42 },
  { n: 6, file: 'local-3.jpg', src: 'локальный · молот с фоном', w: 474, h: 592, kb: 37 },
  { n: 7, file: 'local-4.jpg', src: 'локальный · 3.jpeg (трикветра)', w: 400, h: 400, kb: 15 }
];

const cards = [
  { time: '45–60 мин', title: 'Мужская стрижка', text: 'Разбор формы головы и типа волос, машинка и ножницы, укладка. Форма держится месяц.', price: '3 500 ₽' },
  { time: '30 мин', title: 'Стрижка машинкой', text: 'Одна длина, чистые переходы, окантовка опасной бритвой. Для тех, кто приходит раз в три недели.', price: '2 000 ₽' },
  { time: '40 мин', title: 'Оформление бороды', text: 'Контур опасной бритвой, форма по направлению роста, горячее полотенце и масло.', price: '2 500 ₽' },
  { time: '70 мин', title: 'Отец и сын', text: 'Две стрижки подряд в одном кресле. Детская — с 5 лет, на первой делаем фото.', price: '4 500 ₽' }
];
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Картинки-молоты для Hero — временная страница</title>
		<style>
			/* Режим «фон»: картинка растянута на весь Hero. Режим «карточка»: панель справа. */
			[data-mode='bg'] [data-figure] { display: none; }
			[data-mode='card'] [data-hero-img] { display: none; }
			[data-mode='card'] [data-scrim] { display: none; }

			[data-thumb].is-on { border-color: var(--accent); }
			[data-thumb].is-on span { color: var(--accent); }

			.vbtn.is-on { background: var(--accent); color: var(--bg); border-color: var(--accent); }
		</style>
	</head>
	<body class="min-h-screen bg-bg font-sans text-text antialiased" data-mode="bg">
		<!-- Панель управления: поверх всего, поэтому z-[70] -->
		<div class="fixed inset-x-0 top-0 z-[70] border-b border-border bg-bg-deep/92 backdrop-blur-md">
			<div class="mx-auto flex max-w-6xl flex-wrap items-center gap-2 px-4 py-3">
				<span class="mr-1 font-mono text-[11px] uppercase tracking-[0.2em] text-text-muted">Вариант</span>
				{
					variants.map((v) => (
						<button
							type="button"
							data-v={String(v.n)}
							class="vbtn min-h-11 min-w-11 border border-border px-3 font-display text-[15px] text-text transition-colors hover:border-accent hover:text-accent"
						>
							{v.n}
						</button>
					))
				}
				<span class="mx-1 h-8 w-px bg-border"></span>
				<button type="button" data-mode-set="bg" class="min-h-11 border border-border px-3 font-mono text-[11px] uppercase tracking-[0.14em] text-text-muted transition-colors hover:border-accent hover:text-accent">фон</button>
				<button type="button" data-mode-set="card" class="min-h-11 border border-border px-3 font-mono text-[11px] uppercase tracking-[0.14em] text-text-muted transition-colors hover:border-accent hover:text-accent">карточка</button>
				<button type="button" data-cycle class="min-h-11 border border-border px-3 font-mono text-[11px] uppercase tracking-[0.14em] text-text-muted transition-colors hover:border-accent-warm hover:text-accent-warm">цикл</button>
				<span id="v-status" class="ml-auto font-mono text-[11px] uppercase tracking-[0.14em] text-text-muted">вариант 1</span>
			</div>
		</div>

		<main class="pt-20">
			<!-- Hero: тот же заголовок и кнопки, что на главной -->
			<section class="relative min-h-[600px] overflow-hidden border-b border-border">
				<div
					data-hero-img
					class="absolute inset-0 bg-cover bg-center"
					style="background-image:url('/board/board-01.jpg')"
					aria-hidden="true"
				>
				</div>
				<div
					data-scrim
					class="absolute inset-0"
					style="background:linear-gradient(to top, var(--bg) 2%, color-mix(in oklab, var(--bg) 78%, transparent) 42%, color-mix(in oklab, var(--bg) 34%, transparent) 100%)"
					aria-hidden="true"
				>
				</div>

				<div class="relative mx-auto grid max-w-6xl gap-10 px-4 pb-16 pt-32 md:grid-cols-[minmax(0,1fr)_minmax(0,380px)] md:items-center md:pb-24 md:pt-40">
					<div>
						<p class="font-mono text-[11px] uppercase tracking-[0.28em] text-text-muted">Барбершоп «Мьёльнир»</p>
						<h1 class="mt-6 font-display text-[40px] leading-[0.98] tracking-tight md:text-[92px]">
							Сталь. Время. Ремесло.
						</h1>
						<p class="mt-8 max-w-[52ch] text-[17px] leading-relaxed text-text-muted">
							Так выглядит главная с картинкой-молотом вместо 3D-модели. Переключайте варианты
							кнопками сверху, режимы «фон» и «карточка» — как картинка ложится в макет.
						</p>
						<div class="mt-10 flex flex-wrap gap-3">
							<span class="inline-flex min-h-12 items-center bg-accent px-8 font-display text-[17px] uppercase tracking-[0.1em] text-bg">Записаться</span>
							<span class="inline-flex min-h-12 items-center border border-border px-8 font-display text-[17px] uppercase tracking-[0.1em] text-text">Услуги</span>
						</div>
					</div>

					<!-- Режим «карточка»: та же картинка отдельной панелью -->
					<figure data-figure class="border border-border bg-surface/50 p-3">
						<img data-figure-img src="/board/board-01.jpg" alt="" class="w-full" />
						<figcaption class="mt-3 font-mono text-[11px] uppercase tracking-[0.14em] text-text-muted">
							<span data-cap>board-01.jpg · 564×840 · 94 КБ</span>
						</figcaption>
					</figure>
				</div>
			</section>

			<!-- Подпись активного варианта -->
			<section class="mx-auto max-w-6xl px-4 pt-6">
				<p class="font-mono text-[11px] uppercase tracking-[0.16em] text-text-muted">
					Активно: <span data-cap class="text-accent">board-01.jpg · 564×840 · 94 КБ</span>
					<span class="text-text-muted/60"> · источник: <span data-cap-src>доска · Ragnir (молот Локи)</span></span>
				</p>
			</section>

			<!-- Все семь превью: клик — выбрать, видно разрешение -->
			<section class="mx-auto max-w-6xl px-4 py-10">
				<h2 class="font-display text-[28px] leading-none md:text-[40px]">Все варианты</h2>
				<div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
					{
						variants.map((v) => (
							<button type="button" data-thumb={String(v.n)} class="border border-border bg-surface/40 p-2 text-left transition-colors hover:border-text/40">
								<img src={`/board/${v.file}`} alt="" class="aspect-[3/4] w-full object-cover" loading="lazy" />
								<span class="mt-2 block font-display text-[13px] uppercase tracking-[0.08em]">{v.n} · {v.w}×{v.h}</span>
								<span class="mt-1 block font-mono text-[10px] uppercase tracking-[0.12em] text-text-muted">{v.src}</span>
							</button>
						))
					}
				</div>
			</section>

			<!-- Контент под Hero: как картинка соседствует с секциями -->
			<section class="mx-auto max-w-6xl px-4 pb-24">
				<h2 class="font-display text-[34px] leading-none md:text-[56px]">Что делаем</h2>
				<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
					{
						cards.map((c) => (
							<article class="border border-border bg-surface/60 p-6">
								<p class="font-mono text-[11px] uppercase tracking-[0.18em] text-text-muted">{c.time}</p>
								<h3 class="mt-4 font-display text-[19px] uppercase tracking-[0.06em]">{c.title}</h3>
								<p class="mt-4 text-[15px] leading-relaxed text-text-muted">{c.text}</p>
								<p class="mt-6 font-display text-[18px]">{c.price}</p>
							</article>
						))
					}
				</div>
			</section>

			<footer class="border-t border-border">
				<div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-10">
					<a href="/" class="inline-flex min-h-11 items-center font-display text-[16px] uppercase tracking-[0.1em] text-text transition-colors hover:text-accent">← На главную</a>
					<a href="/header-cta-preview" class="inline-flex min-h-11 items-center font-display text-[16px] uppercase tracking-[0.1em] text-text-muted transition-colors hover:text-accent">Кнопка в шапке: превью →</a>
					<p class="font-mono text-[11px] uppercase tracking-[0.14em] text-text-muted">Временная страница: выбор картинки-молота</p>
				</div>
			</footer>
		</main>

		<p class="fixed bottom-2 right-3 z-[70] font-mono text-[10px] uppercase tracking-[0.16em] text-accent-warm/80">
			Dev-only. Удалить перед деплоем
		</p>

		<script>
			const VARIANTS = [
				{ n: 1, file: 'board-01.jpg', src: 'доска · Ragnir (молот Локи)', w: 564, h: 840, kb: 94 },
				{ n: 2, file: 'board-02.jpg', src: 'доска · 736×736', w: 736, h: 736, kb: 97 },
				{ n: 3, file: 'board-03.jpg', src: 'доска · третий пин', w: 564, h: 846, kb: 92 },
				{ n: 4, file: 'local-1.jpg', src: 'локальный · молот норм', w: 474, h: 727, kb: 42 },
				{ n: 5, file: 'local-2.jpg', src: 'локальный · молот', w: 474, h: 842, kb: 42 },
				{ n: 6, file: 'local-3.jpg', src: 'локальный · молот с фоном', w: 474, h: 592, kb: 37 },
				{ n: 7, file: 'local-4.jpg', src: 'локальный · 3.jpeg (трикветра)', w: 400, h: 400, kb: 15 }
			];

			const hero = document.querySelector<HTMLElement>('[data-hero-img]');
			const figImg = document.querySelector<HTMLImageElement>('[data-figure-img]');
			const body = document.body;
			const status = document.getElementById('v-status');
			const btns = Array.from(document.querySelectorAll<HTMLElement>('.vbtn'));
			const thumbs = Array.from(document.querySelectorAll<HTMLElement>('[data-thumb]'));

			let current = 1;
			let cycleTimer: number | undefined;

			function paint() {
				const v = VARIANTS.find((x) => x.n === current)!;
				const url = `/board/${v.file}`;
				if (hero) hero.style.backgroundImage = `url('${url}')`;
				if (figImg) figImg.src = url;
				for (const b of btns) b.classList.toggle('is-on', Number(b.dataset.v) === current);
				for (const t of thumbs) t.classList.toggle('is-on', Number(t.dataset.thumb) === current);
				for (const el of document.querySelectorAll('[data-cap]')) {
					el.textContent = `${v.file} · ${v.w}×${v.h} · ${v.kb} КБ`;
				}
				for (const el of document.querySelectorAll('[data-cap-src]')) el.textContent = v.src;
				if (status) status.textContent = `вариант ${v.n} — ${v.src}`;
			}

			function select(n: number) {
				current = ((n - 1 + VARIANTS.length) % VARIANTS.length) + 1;
				paint();
			}

			function setMode(m: string) {
				body.dataset.mode = m;
				for (const b of document.querySelectorAll<HTMLElement>('[data-mode-set]')) {
					b.style.borderColor = b.dataset.modeSet === m ? 'var(--accent)' : '';
					b.style.color = b.dataset.modeSet === m ? 'var(--accent)' : '';
				}
			}

			function toggleCycle() {
				if (cycleTimer) {
					window.clearInterval(cycleTimer);
					cycleTimer = undefined;
					return;
				}
				cycleTimer = window.setInterval(() => select(current + 1), 3500);
			}

			document.addEventListener('click', (e) => {
				const t = e.target as HTMLElement;
				const v = t.closest('[data-v]');
				const th = t.closest('[data-thumb]');
				const md = t.closest('[data-mode-set]');
				if (v) select(Number((v as HTMLElement).dataset.v));
				else if (th) select(Number((th as HTMLElement).dataset.thumb));
				else if (md) setMode((md as HTMLElement).dataset.modeSet!);
				else if (t.closest('[data-cycle]')) toggleCycle();
			});

			document.addEventListener('keydown', (e) => {
				if (e.metaKey || e.ctrlKey) return;
				const k = e.key;
				if (/^[1-7]$/.test(k)) select(Number(k));
				else if (k === 'ArrowRight') select(current + 1);
				else if (k === 'ArrowLeft') select(current - 1);
				else if (k === ' ') toggleCycle();
			});

			setMode('bg');
			paint();
		</script>
	</body>
</html>
