---
// Скорость вращения 3D-молота. Правило 20.6: варианты — кнопками, не скриншотами.
// Здесь только сцена с молотом, без текста Hero и остальных слоёв.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero3D from '../components/Hero3D';

/* Dev-only: в прод-сборке страница уводит на главную (правило проекта). */
if (import.meta.env.PROD) return Astro.redirect('/');
---

<Layout>
	<Header />

	<main class="rot-stage">
		<Hero3D client:load />
	</main>

	<div class="switch" role="group" aria-label="Скорость вращения молота" data-pp>
		<div class="row">
			<span class="cap">Оборотов/с</span>
			<button data-spin="0.10">0,10</button>
			<button data-spin="0.15">0,15</button>
			<button data-spin="0.17" class="on">0,17</button>
			<button data-spin="0.20">0,20</button>
			<button data-spin="0.25">0,25</button>
		</div>
		<div class="row">
			<span class="cap">Парение</span>
			<button data-amp="0.05">±0,05</button>
			<button data-amp="0.08" class="on">±0,08</button>
			<button data-amp="0.12">±0,12</button>
		</div>
		<div class="row">
			<span class="cap">Период</span>
			<button data-period="2">2 с</button>
			<button data-period="3">3 с</button>
			<button data-period="3.5" class="on">3,5 с</button>
			<button data-period="4">4 с</button>
		</div>
		<div class="row"><span class="cap">Сейчас</span><span class="val" id="now">0,17 об/с</span></div>
	</div>

	<style>
		.rot-stage {
			position: relative;
			height: 100svh;
			background: var(--bg);
			overflow: hidden;
		}
		.switch {
			position: fixed; top: 84px; left: 50%; transform: translateX(-50%);
			z-index: 200; display: flex; flex-direction: column; gap: 6px;
			padding: 10px 14px; border-radius: 14px;
			background: color-mix(in srgb, var(--bg-deep) 88%, transparent);
			border: 1px solid color-mix(in srgb, var(--accent-warm) 40%, transparent);
			backdrop-filter: blur(8px); font-family: var(--font-label);
		}
		.switch .row { display: flex; gap: 6px; align-items: center; }
		.switch .cap { width: 92px; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
		.switch .val { font-size: 12px; color: var(--text); }
		.switch button {
			font: inherit; font-size: 12px; letter-spacing: 0.04em;
			padding: 6px 12px; border-radius: 8px; cursor: pointer;
			color: var(--text-muted); background: transparent;
			border: 1px solid color-mix(in srgb, var(--text-muted) 35%, transparent);
		}
		.switch button:hover { color: var(--text); border-color: var(--accent-warm); }
		.switch button.on { color: var(--bg-deep); background: var(--accent-warm); border-color: var(--accent-warm); }
	</style>

	<script>
		const now = document.getElementById('now')!;
		document.querySelectorAll<HTMLElement>('[data-spin]').forEach((b) => {
			b.addEventListener('click', () => {
				const rev = Number(b.dataset.spin);
				const api = (window as any).__hammerSpin;
				if (api) api.set(rev);
				document.querySelectorAll('[data-spin]').forEach((x) => x.classList.remove('on'));
				b.classList.add('on');
			});
		});
		document.querySelectorAll<HTMLElement>('[data-amp]').forEach((b) => {
			b.addEventListener('click', () => {
				const api = (window as any).__hammerSpin;
				if (api) api.setAmp(Number(b.dataset.amp));
				document.querySelectorAll('[data-amp]').forEach((x) => x.classList.remove('on'));
				b.classList.add('on');
			});
		});
		document.querySelectorAll<HTMLElement>('[data-period]').forEach((b) => {
			b.addEventListener('click', () => {
				const api = (window as any).__hammerSpin;
				if (api) api.setPeriod(Number(b.dataset.period));
				document.querySelectorAll('[data-period]').forEach((x) => x.classList.remove('on'));
				b.classList.add('on');
			});
		});

		let shown = false;
		window.setInterval(() => {
			const api = (window as any).__hammerSpin;
			if (!api) { now.textContent = 'сцена грузится…'; return; }
			if (!shown) { api.show(); shown = true; }
			const v = api.get();
			now.textContent = `${v.toFixed(2).replace('.', ',')} об/с · ±${api.getAmp().toFixed(2).replace('.', ',')} · ${String(api.getPeriod()).replace('.', ',')} с`;
			const btn = document.querySelector(`[data-spin="${v.toFixed(2)}"]`);
			if (btn && !btn.classList.contains('on')) {
				document.querySelectorAll('[data-spin]').forEach((x) => x.classList.remove('on'));
				btn.classList.add('on');
			}
		}, 250);
	</script>
</Layout>
