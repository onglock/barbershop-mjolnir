---
/**
 * ВРЕМЕННАЯ dev-страница: просмотр тем ритуала A–E вживую (§10.2).
 *
 * Нужна, чтобы выбирать тему в динамике, а не по скриншотам. Самодостаточна:
 * свои разметка и стили, ни один рабочий компонент не задействован.
 * В прод не собирается — редирект на главную; файл удаляется перед деплоем.
 */
import '../styles/global.css';
import { RITUAL_LABELS } from '../lib/ritualEffects';

/** Силуэт молота для вариантов кнопки: голова + рукоять. Размеры — в самой строке. */
const hammer = (size: number, cls = '') =>
	`<svg viewBox="0 0 24 24" width="${size}" height="${size}" class="${cls}" aria-hidden="true" fill="currentColor"><path d="M3.6 5.2h16.8c.5 0 .9.4.85.9l-.65 5.1c-.06.45-.44.8-.9.8H4.3c-.46 0-.84-.35-.9-.8l-.65-5.1c-.05-.5.34-.9.85-.9Z" /><path d="M10.7 12h2.6v7.1c0 .9-.6 1.6-1.3 1.6s-1.3-.7-1.3-1.6V12Z" /></svg>`;


if (import.meta.env.PROD) return Astro.redirect('/');

const variants = ['A', 'B', 'C', 'D', 'E'] as const;

const cards = [
  { time: '45–60 мин', title: 'Мужская стрижка', text: 'Разбор формы головы и типа волос, машинка и ножницы, укладка. Форма держится месяц.', price: '3 500 ₽' },
  { time: '30 мин', title: 'Стрижка машинкой', text: 'Одна длина, чистые переходы, окантовка опасной бритвой. Для тех, кто приходит раз в три недели.', price: '2 000 ₽' },
  { time: '40 мин', title: 'Оформление бороды', text: 'Контур опасной бритвой, форма по направлению роста, горячее полотенце и масло.', price: '2 500 ₽' },
  { time: '70 мин', title: 'Отец и сын', text: 'Две стрижки подряд в одном кресле. Детская — с 5 лет, на первой делаем фото.', price: '4 500 ₽' }
];
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Ритуалы A–E — временная страница</title>
	</head>
	<body class="min-h-screen bg-bg font-sans text-text antialiased">
		<!-- Панель управления: над эффектом (z-45), поэтому z-[70] -->
		<div class="fixed inset-x-0 top-0 z-[70] border-b border-border bg-bg-deep/92 backdrop-blur-md">
			<div class="mx-auto flex max-w-6xl flex-wrap items-center gap-2 px-4 py-3">
				<span class="mr-2 font-mono text-[11px] uppercase tracking-[0.2em] text-text-muted">Ритуал</span>
				{
					variants.map((v) => (
						<button
							type="button"
							data-v={v}
							class="ritual-btn min-h-11 min-w-11 rounded-none border border-border px-4 font-display text-[15px] uppercase tracking-[0.12em] text-text transition-colors hover:border-accent hover:text-accent"
						>
							{v}
						</button>
					))
				}
				<button
					type="button"
					data-v="off"
					class="ritual-btn min-h-11 rounded-none border border-border px-4 font-display text-[15px] uppercase tracking-[0.12em] text-text-muted transition-colors hover:border-accent-warm hover:text-accent-warm"
				>
					Off
				</button>
				<span id="ritual-status" class="ml-auto font-mono text-[11px] uppercase tracking-[0.14em] text-text-muted">выключено</span>
			</div>
		</div>

		<!-- Упрощённая копия главной: тот же тёмный фон, тот же заголовок -->
		<main class="pt-24">
			<section class="mx-auto max-w-6xl px-4 py-24">
				<p class="font-mono text-[11px] uppercase tracking-[0.28em] text-text-muted">Барбершоп «Мьёльнир»</p>
				<h1 class="mt-6 font-display text-[40px] leading-[0.98] tracking-tight md:text-[92px]">
					Сталь. Время. Ремесло.
				</h1>
				<p class="mt-8 max-w-[52ch] text-[17px] leading-relaxed text-text-muted">
					Так выглядит главная под каждой темой. Дождь, сияние или искры ложатся поверх
					контента — здесь видно, как читается текст и как выглядят карточки.
				</p>
				<div class="mt-10 flex flex-wrap gap-3">
					<span class="inline-flex min-h-12 items-center bg-accent px-8 font-display text-[17px] uppercase tracking-[0.1em] text-bg">Записаться</span>
					<span class="inline-flex min-h-12 items-center border border-border px-8 font-display text-[17px] uppercase tracking-[0.1em] text-text">Услуги</span>
				</div>
			</section>

			<section class="mx-auto max-w-6xl px-4 pb-24">
				<h2 class="font-display text-[34px] leading-none md:text-[56px]">Что делаем</h2>
				<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
					{
						cards.map((c) => (
							<article class="border border-border bg-surface/60 p-6">
								<p class="font-mono text-[11px] uppercase tracking-[0.18em] text-text-muted">{c.time}</p>
								<h3 class="mt-4 font-display text-[19px] uppercase tracking-[0.06em]">{c.title}</h3>
								<p class="mt-4 text-[15px] leading-relaxed text-text-muted">{c.text}</p>
								<p class="mt-6 font-display text-[18px]">{c.price}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="mx-auto max-w-6xl px-4 pb-24">
				<h2 class="font-display text-[28px] leading-none md:text-[40px]">Кнопка-молот — варианты</h2>
				<p class="mt-4 max-w-[60ch] text-[15px] leading-relaxed text-text-muted">
					Оформление для шапки. Сейчас в проекте стоит акцентная кнопка (первая в ряду) — она для сравнения.
					Ниже три варианта: тусклый силуэт молота, при наведении светлеет. Живые: наведите курсор.
				</p>

				<h3 class="mt-10 font-mono text-[11px] uppercase tracking-[0.2em] text-text-muted">Как в шапке (десктоп)</h3>
				<div class="mt-4 flex flex-wrap items-center gap-4 border border-border bg-bg-deep/60 px-6 py-5">
					<span class="flex items-center text-bg">
						<a href="#contact" class="group/button inline-flex shrink-0 items-center justify-center gap-2 whitespace-nowrap h-12 px-8 bg-accent text-bg" style="background:var(--accent);color:var(--bg)">Записаться</a>
					</span>
					<span class="font-mono text-[10px] uppercase tracking-[0.14em] text-text-muted">← сейчас</span>
					<span class="mx-2 h-8 w-px bg-border"></span>
					{
						[
							{ k: 'V1', label: 'V1 · силуэт + подпись', inner: <><span class="shrink-0 opacity-70" set:html={hammer(20)} /><span class="font-display text-[13px] uppercase tracking-[0.14em]">Записаться</span></> },
							{ k: 'V2', label: 'V2 · только молот', inner: <><span class="shrink-0" set:html={hammer(22)} /><span class="ml-2.5 font-display text-[13px] uppercase tracking-[0.14em]">Записаться</span></> },
							{ k: 'V3', label: 'V3 · молот-подложка', inner: <><span class="pointer-events-none absolute -left-2 top-1/2 -translate-y-1/2 opacity-[0.16]" set:html={hammer(46)} /><span class="relative pl-5 font-display text-[13px] uppercase tracking-[0.16em]">Записаться</span></> }
						].map((v) => (
							<a
								href="#contact"
								class:list={[
									'group inline-flex min-h-12 items-center text-text-muted transition-colors hover:border-text/40 hover:text-text border border-border',
									v.k === 'V1' && 'gap-2.5 px-4',
									v.k === 'V2' && 'px-3.5',
									v.k === 'V3' && 'relative overflow-hidden px-6'
								]}
							>
								{v.inner}
							</a>
						))
					}
				</div>

				<h3 class="mt-10 font-mono text-[11px] uppercase tracking-[0.2em] text-text-muted">Как в мобильном меню (390)</h3>
				<div class="mt-4 w-[342px] max-w-full border border-border bg-bg-deep/60 p-4">
					<a href="#contact" class="flex h-12 w-full items-center justify-center" style="background:var(--accent);color:var(--bg)">
						<span class="font-display text-[13px] uppercase tracking-[0.14em]">Записаться — сейчас</span>
					</a>
					{
						['V1', 'V2', 'V3'].map((k) => (
							<a href="#contact" class:list={['mt-3 flex min-h-12 w-full items-center justify-center border border-border text-text-muted transition-colors hover:border-text/40 hover:text-text', k === 'V3' && 'relative overflow-hidden px-6']}>
								{k === 'V3' ? <span class="pointer-events-none absolute -left-2 top-1/2 -translate-y-1/2 opacity-[0.16]" set:html={hammer(46)} /> : <span class:list={['shrink-0', k === 'V1' && 'opacity-70']} set:html={hammer(k === 'V1' ? 20 : 22)} />}
								<span class:list={['font-display text-[13px] uppercase tracking-[0.14em]', k === 'V1' && 'ml-2.5', k === 'V2' && 'ml-2.5', k === 'V3' && 'relative pl-5']}>{k} · Записаться</span>
							</a>
						))
					}
				</div>

				<h3 class="mt-10 font-mono text-[11px] uppercase tracking-[0.2em] text-text-muted">Вариант «значок в мобильном баре» (рядом с бургером)</h3>
				<div class="mt-4 flex items-center gap-3 border border-border bg-bg-deep/60 px-6 py-5">
					<a href="#contact" class="inline-flex h-11 w-11 items-center justify-center border border-border text-text-muted"><span set:html={hammer(22)} /></a>
					<span class="font-mono text-[10px] uppercase tracking-[0.14em] text-text-muted">значок 44×44, подписи нет</span>
				</div>
			</section>

			<footer class="border-t border-border">
				<div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-10">
					<a href="/" class="inline-flex min-h-11 items-center font-display text-[16px] uppercase tracking-[0.1em] text-text transition-colors hover:text-accent">
						← На главную
					</a>
					<p class="font-mono text-[11px] uppercase tracking-[0.14em] text-text-muted">Временная страница для выбора ритуала</p>
				</div>
			</footer>
		</main>

		<p class="fixed bottom-2 right-3 z-[70] font-mono text-[10px] uppercase tracking-[0.16em] text-accent-warm/80">
			Dev-only. Удалить перед деплоем
		</p>

		<script>
			/* Импорт динамический и помечен @vite-ignore намеренно: так модуль эффектов
			   не попадает в прод-сборку. В dev Vite отдаёт /src/lib/ritualEffects.ts
			   напрямую, а в прод эта ветка не исполняется — страница редиректит на «/». */
			(async () => {
				const { applyRitual, fadeOutRitual, RITUAL_LABELS } = await import(/* @vite-ignore */ '/src/lib/ritualEffects.ts');

				const LIFETIME_MS = 5000;
				const status = document.getElementById('ritual-status');
				const buttons = Array.from(document.querySelectorAll('.ritual-btn'));

				let timer;
				let ticker;
				let current = null;
				let until = 0;

				function paint() {
					for (const b of buttons) {
						const on = b.dataset.v === current;
						b.style.background = on ? 'var(--accent)' : '';
						b.style.color = on ? 'var(--bg)' : '';
						b.style.borderColor = on ? 'var(--accent)' : '';
					}
					if (!status) return;
					if (!current) {
						status.textContent = 'выключено';
						return;
					}
					status.textContent = `${RITUAL_LABELS[current]} — гаснет через ${Math.max(0, Math.ceil((until - Date.now()) / 1000))} с`;
				}

				function off() {
					/* не «щёлк»: слои уходят за 1200 мс, ease-in-cubic */
					fadeOutRitual();
					window.clearTimeout(timer);
					window.clearInterval(ticker);
					current = null;
					paint();
				}

				function activate(v) {
					if (v === 'off') {
						off();
						return;
					}
					// повторный клик по той же теме — перезапуск с нуля
					applyRitual(v);
					window.clearTimeout(timer);
					window.clearInterval(ticker);
					current = v;
					until = Date.now() + LIFETIME_MS;
					timer = window.setTimeout(off, LIFETIME_MS);
					ticker = window.setInterval(paint, 250);
					paint();
				}

				document.addEventListener('click', (e) => {
					const btn = e.target.closest('button[data-v]');
					if (btn && btn.dataset.v) activate(btn.dataset.v);
				});

				document.addEventListener('keydown', (e) => {
					const k = e.key.toUpperCase();
					if (['A', 'B', 'C', 'D', 'E'].includes(k) && !e.metaKey && !e.ctrlKey) activate(k);
					if (e.key === 'Escape' || k === '0') off();
				});
			})();
		</script>
	</body>
</html>
