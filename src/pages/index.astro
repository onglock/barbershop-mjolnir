---
// Главная страница-лендинг «Мьёльнир». Порядок секций — драматургия страницы.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Manifest from '../components/Manifest.astro';
import Services from '../components/Services';
import Masters from '../components/Masters.astro';
import Training from '../components/Training.astro';
import TestimonialsWall from '../components/TestimonialsWall.astro';
import FaqScroll from '../components/FaqScroll.astro';
import ContactForm from '../components/ContactForm';
import Footer from '../components/Footer.astro';
---

<Layout>
	<Header />

	<main id="main" class="relative z-10 bg-bg">
		<!-- Общий фон всех секций: тот же кадр, что в Hero, fixed — не скроллится.
		     Живёт внутри main, потому что у main свой непрозрачный фон и z-10:
		     слой с z-index −1 встаёт выше фона main, но ниже всего контента.
		     Так сохраняется и приём с футером (он sticky и снаружи main, поэтому
		     по-прежнему открывается из-под контента). На мобильном скрыт — как в Hero. -->
		<div class="section-bg" aria-hidden="true"></div>

		<Hero />
		<Manifest />
		<Services client:visible />
		<Masters />
		<Training />
		<TestimonialsWall count={8} />
		<FaqScroll />
		<ContactForm client:idle />
	</main>

	<Footer />
</Layout>

<style>
	/* Общий фон секций: тот же кадр, что в Hero (/hero-bg/hero-bg-main.jpg).
	   opacity 0.3 — решение Кирилла 2026-09-24 (0.5 давал 2,19 % кадра ниже порога,
	   0.4 — 0,26 % и 10 элементов ниже 4,5, 0.3 — 0,000 % и ни одного элемента;
	   худший мелкий текст 4,68:1). fixed: не скроллится с текстом.
	   z-index −1 внутри main (у него z-10 и непрозрачный фон) — слой ложится
	   выше фона main и ниже контента, поэтому фон виден во всех секциях, а
	   футер по-прежнему открывается из-под контента. */
	.section-bg {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background-image: url('/hero-bg/hero-bg-main.jpg');
		background-size: cover;
		/* 80 % вместо 45 % — сдвиг кадра вниз (решение Кирилла 2026-09-24).
		   Источник квадратный 1024×1024, при cover по горизонтали запаса нет,
		   поэтому работает только вертикальный сдвиг. Подбор по фактическим
		   кадрам (45/55/60/65/70/75/80/85 %): на 80 % абзац FAQ 5,15:1 вместо
		   2,84:1, лейблы 5,21:1 вместо 4,20:1. */
		background-position: center 80%;
		background-repeat: no-repeat;
		opacity: 0.3;
	}

	/* Панель раскрытия карточек услуг (Services): при reduced-motion показана
	   сразу, без анимации. Селектор через :global() обязателен — панель живёт в
	   React-острове и атрибута скоупа страницы не имеет, иначе правило молча не
	   срабатывает. Утилиты motion-reduce: не годятся: у вариантов Tailwind свой
	   порядок, и lg: перебивает motion-reduce:. */
	@media (prefers-reduced-motion: reduce) {
		:global(.svc-reveal) {
			transform: none !important;
			translate: none !important;
			opacity: 1 !important;
			transition: none !important;
		}
		:global(.svc-arrow) {
			transition: none !important;
		}
	}

	/* На мобильном фон выключен — как в Hero: при cover на узком экране кадр
	   сильно зумится и читается как размытое пятно (решение Кирилла). */
	@media (max-width: 1023px) {
		.section-bg { display: none; }
	}
</style>
