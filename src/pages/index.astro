---
// Главная страница-лендинг «Мьёльнир». Порядок секций — драматургия страницы.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Manifest from '../components/Manifest.astro';
import Services from '../components/Services';
import Masters from '../components/Masters.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq';
import ContactForm from '../components/ContactForm';
import Footer from '../components/Footer.astro';
---

<Layout>
	<Header />

	<main id="main" class="relative z-10 bg-bg">
		<Hero />
		<Manifest />
		<Services client:visible />
		<Masters />
		<Testimonials />
		<Faq client:visible />
		<ContactForm client:idle />
	</main>

	<Footer />
</Layout>
