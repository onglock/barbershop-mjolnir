---
// Старт полёта молота: откуда он вылетает. Правило 20.6 — варианты показываем
// живой страницей с кнопками, а не скриншотами.
//
// Зачем: Кирилл видит, что молот появляется в середине левой половины экрана,
// хотя код стартует с x = -8.4 (центр модели при этом на -261 px, за кадром).
// Пиксельный замер показал: у левого края молот появляется рано (x 0..42 px),
// но читаемым становится только с ~1 с, когда уже в полосе x 160..430 —
// поэтому полёт глазами начинается «из середины». Здесь стартовый X и масштаб
// двигаются слайдерами, рядом — числа в пикселях от левого края.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';

/* Dev-only: в прод-сборке страница уводит на главную (правило проекта). */
if (import.meta.env.PROD) return Astro.redirect('/');
---

<Layout title="Старт полёта молота — превью">
	<Header />

	<main>
		<Hero />
	</main>

	<aside class="panel" data-pp>
		<div class="row">
			<span class="cap">Старт X</span>
			<input id="sx" type="range" min="-30" max="5" step="0.1" value="-16" />
			<span class="val" id="sxv">−16,0</span>
		</div>
		<div class="row">
			<span class="cap">Старт масштаб</span>
			<input id="ss" type="range" min="0.01" max="0.5" step="0.01" value="0.05" />
			<span class="val" id="ssv">0,05</span>
		</div>
		<div class="row">
			<span class="cap">Быстро</span>
			<button data-scale="0.05">0,05</button>
			<button data-scale="0.1">0,10</button>
			<button data-scale="0.15">0,15</button>
			<button data-scale="0.2">0,20</button>
		</div>
		<div class="row">
			<span class="cap">Рост с</span>
			<input id="gr" type="range" min="0" max="0.5" step="0.05" value="0.4" />
			<span class="val" id="grv">40 %</span>
		</div>
		<div class="row">
			<span class="cap">Быстро</span>
			<button data-grow="0">0 %</button>
			<button data-grow="0.2">20 %</button>
			<button data-grow="0.3">30 %</button>
			<button data-grow="0.4">40 %</button>
			<button data-grow="0.5">50 %</button>
		</div>
		<div class="row nums">
			<span class="cap">Стартовый бокс</span>
			<span class="val" id="num">сцена грузится…</span>
		</div>
		<div class="row nums">
			<span class="cap">Кривая</span>
			<span class="val" id="curve">—</span>
		</div>
		<div class="row nums">
			<span class="cap">Состояние</span>
			<span class="val" id="state">—</span>
		</div>
		<div class="row">
			<span class="cap">Прогон</span>
			<button id="run">Запустить полёт</button>
			<button id="reset">Сброс</button>
			<button id="hold">Показать в стартовой позе</button>
		</div>
		<div class="row">
			<span class="cap">Старт</span>
			<button id="left">За левым краем</button>
			<button id="defaults">X, масштаб и кривая по умолчанию</button>
		</div>
		<div class="hint">
			Два рычага. «Старт масштаб» — размер молота в начале (0,01 — точка ≈7 px,
			0,1 — бокс 73 px, 0,15 — 105 px, 0,20 — 143 px). «Рост с» — какую долю
			пути молот летит СТАРТОВЫМ размером, прежде чем начать расти: 0 % — растёт
			сразу, 30 % — мелким первые 270 мс, потом растёт за оставшиеся 630 мс.
			Замер пиксельно: при X = −8,4 старт целиком ЗА кадром, поэтому «видно с
			первых кадров» один размер не даёт — он определяет, насколько заметно
			молот ВХОДИТ (0,01 — первый заметный кадр 0,97 с, 724 изменённых пикселя;
			0,1 — 0,99 с, но сразу 1335). Чтобы молот был в кадре с первого кадра,
			нужен X ближе к краю: X = −6,5 при масштабе 0,15 даёт бокс −36…65 px.
			«Стартовый бокс» считается В СТАРТОВОЙ ПОЗЕ, независимо от текущей фазы.
			«Запустить полёт» сам сбрасывает в idle и запускает заново — можно жать
			подряд, значения слайдеров сохраняются. «Сброс» возвращает в idle без
			полёта. Проверять на окне 1280+ (ниже 1024 3D-молота нет, там 2D-слой).
		</div>
	</aside>

	<style>
		.panel {
			position: fixed; top: 84px; right: 16px;
			z-index: 200; display: flex; flex-direction: column; gap: 7px;
			width: 360px; max-height: calc(100svh - 100px); overflow-y: auto;
			padding: 12px 14px; border-radius: 14px;
			background: color-mix(in srgb, var(--bg-deep) 90%, transparent);
			border: 1px solid color-mix(in srgb, var(--accent-warm) 40%, transparent);
			backdrop-filter: blur(8px); font-family: var(--font-label);
		}
		.panel .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
		.panel .cap { width: 88px; flex: none; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
		.panel .val { font-size: 12px; color: var(--text); }
		.panel input[type='range'] { flex: 1; accent-color: var(--accent-warm); }
		.panel .nums .val { font-family: var(--font-price); font-size: 12px; }
		.panel .hint { font-size: 11px; line-height: 1.45; color: var(--text-muted); }
		.panel button {
			font: inherit; font-size: 12px; letter-spacing: 0.04em;
			padding: 6px 10px; border-radius: 8px; cursor: pointer;
			color: var(--text-muted); background: transparent;
			border: 1px solid color-mix(in srgb, var(--text-muted) 35%, transparent);
		}
		.panel .row:nth-child(4) { flex-wrap: wrap; }
		.panel button:hover { color: var(--text); border-color: var(--accent-warm); }
		.panel button.on { color: var(--bg-deep); background: var(--accent-warm); border-color: var(--accent-warm); }
		@media (max-width: 1023px) {
			.panel { display: none; }
		}
	</style>

	<script>
		const api = () => (window as any).__hammerSpin;
		const sx = document.getElementById('sx') as HTMLInputElement;
		const ss = document.getElementById('ss') as HTMLInputElement;
		const sxv = document.getElementById('sxv')!;
		const ssv = document.getElementById('ssv')!;
		const num = document.getElementById('num')!;
		const curveEl = document.getElementById('curve')!;
		const stateEl = document.getElementById('state')!;
		const gr = document.getElementById('gr') as HTMLInputElement;
		const grv = document.getElementById('grv')!;
		const holdBtn = document.getElementById('hold') as HTMLButtonElement;
		const runBtn = document.getElementById('run') as HTMLButtonElement;
		const resetBtn = document.getElementById('reset') as HTMLButtonElement;
		const leftBtn = document.getElementById('left') as HTMLButtonElement;
		const defaultsBtn = document.getElementById('defaults') as HTMLButtonElement;

		const fmt = (v: number, digits = 2) => v.toFixed(digits).replace('.', ',');
		const px = (v: number) => `${Math.round(v)} px`;
		/* Панель один раз подтягивает стартовые значения из кода (не из разметки),
		   чтобы показывать реальные параметры молота. */
		let syncedOnce = false;

		function readout() {
			const a = api();
			const x = Number(sx.value);
			if (!a || !a.bbox) {
				num.textContent = 'сцена грузится…';
				stateEl.textContent = '—';
				return;
			}
			/* Бокс считаем В СТАРТОВОЙ ПОЗЕ: панель должна показывать, откуда
			   молот стартует, а не где он сейчас. */
			if (!syncedOnce && a.getStartX) {
				sx.value = String(a.getStartX());
				ss.value = String(a.getStartScale());
				if (a.getGrowFrom) gr.value = String(a.getGrowFrom());
				syncedOnce = true;
				syncScaleButtons();
				syncGrowButtons();
			}
			const b = a.startBox ? a.startBox() : a.bbox();
			const vp = a.viewport ? a.viewport() : { width: innerWidth };
			sxv.textContent = x < 0 ? '−' + fmt(Math.abs(x), 1) : fmt(x, 1);
			ssv.textContent = fmt(Number(ss.value));
			if (b) {
				const where = b.fullyOffscreen
					? (b.right < 0 ? 'ЗА кадром слева' : 'за кадром справа')
					: (b.left < 0 ? 'частично в кадре' : 'В КАДРЕ');
				num.textContent = `x ${px(b.left)}…${px(b.right)} (ширина ${px(b.width)}) · окно ${Math.round(vp.width)} px · ${where}`;
			} else {
				num.textContent = 'молот ещё не готов';
			}
			const layer = document.querySelector('.hero-hammer');
			stateEl.textContent = `молот: ${a.phase ? a.phase() : '—'}${a.getHold && a.getHold() ? ' (держим старт)' : ''} · слой: ${layer ? layer.dataset.state : '—'}`;
			/* Кривая роста: держим стартовый размер долю пути, потом растём. */
			const g = Number(gr.value);
			const ms = (v: number) => `${Math.round(v * 1000)} мс`;
			grv.textContent = `${Math.round(g * 100)} %`;
			curveEl.textContent = g <= 0
				? `растёт сразу: ${fmt(Number(ss.value))} → 1,0 за весь путь (${ms(1)})`
				: `держит ${fmt(Number(ss.value))} первые ${Math.round(g * 100)} % (${ms(g)}), растёт до 1,0 за оставшиеся ${ms(1 - g)}`;
		}

		sx.addEventListener('input', () => {
			const a = api();
			if (a && a.setStartX) a.setStartX(Number(sx.value));
			readout();
		});
		ss.addEventListener('input', () => {
			const a = api();
			if (a && a.setStartScale) a.setStartScale(Number(ss.value));
			syncScaleButtons();
			readout();
		});

		/* Быстрый выбор стартового масштаба (правило 20.6: варианты — кнопками). */
		const scaleButtons = Array.from(document.querySelectorAll<HTMLElement>('[data-scale]'));
		const syncScaleButtons = () => {
			const v = Number(ss.value);
			scaleButtons.forEach((b) => b.classList.toggle('on', Math.abs(Number(b.dataset.scale) - v) < 0.001));
		};
		scaleButtons.forEach((b) => {
			b.addEventListener('click', () => {
				const a = api();
				const v = Number(b.dataset.scale);
				ss.value = String(v);
				if (a && a.setStartScale) a.setStartScale(v);
				syncScaleButtons();
				readout();
			});
		});

		/* Кривая роста: доля пути, которую молот летит стартовым размером. */
		const growButtons = Array.from(document.querySelectorAll<HTMLElement>('[data-grow]'));
		const syncGrowButtons = () => {
			const v = Number(gr.value);
			growButtons.forEach((b) => b.classList.toggle('on', Math.abs(Number(b.dataset.grow) - v) < 0.001));
		};
		const applyGrow = (v: number) => {
			const a = api();
			gr.value = String(v);
			if (a && a.setGrowFrom) a.setGrowFrom(v);
			syncGrowButtons();
			readout();
		};
		gr.addEventListener('input', () => applyGrow(Number(gr.value)));
		growButtons.forEach((b) => b.addEventListener('click', () => applyGrow(Number(b.dataset.grow))));

		holdBtn.addEventListener('click', () => {
			const a = api();
			if (!a || !a.setHold) return;
			const next = !a.getHold();
			a.setHold(next);
			holdBtn.classList.toggle('on', next);
		});

		runBtn.addEventListener('click', () => {
			const a = api();
			/* Полный прогон: сначала idle, потом полёт — можно жать подряд,
			   ничего не залипает (события те же, что у клика по призыву). */
			if (a && a.replay) { a.replay(); return; }
			const call = document.querySelector<HTMLElement>('.hero-call');
			if (call) call.click();
		});

		resetBtn.addEventListener('click', () => {
			const a = api();
			if (a && a.reset) a.reset();
			if (a && a.setHold && a.getHold()) { a.setHold(false); holdBtn.classList.remove('on'); }
			readout();
		});

		/* «За левым краем»: подбираем X так, чтобы бокс целиком ушёл влево.
		   В экранных пикселях связь линейна (1 единица сцены ≈ pxPerUnit px,
		   знак: X больше → правее). Между шагами ждём кадры: поза обновляется
		   в useFrame, и без ожидания бокс читается старым. */
		leftBtn.addEventListener('click', async () => {
			const a = api();
			if (!a || !a.bbox) return;
			const box = () => (a.startBox ? a.startBox() : a.bbox());
			const frame = () => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
			for (let i = 0; i < 4; i++) {
				const b = box();
				const e = a.edge();
				if (!b || !e) return;
				if (b.right <= -8) break;
				const delta = (b.right + 8) / e.pxPerUnit;
				const next = Number(sx.value) - delta;
				sx.value = String(Math.round(next * 10) / 10);
				if (a.setStartX) a.setStartX(Number(sx.value));
				readout();
				await frame();
			}
			readout();
			leftBtn.classList.add('on');
			window.setTimeout(() => leftBtn.classList.remove('on'), 600);
		});

		defaultsBtn.addEventListener('click', () => {
			const a = api();
			sx.value = '-16';
			ss.value = '0.05';
			if (a && a.setStartX) { a.setStartX(-16); a.setStartScale(0.05); }
			applyGrow(0.4);
			readout();
		});

		syncScaleButtons();
		syncGrowButtons();

		window.setInterval(readout, 120);
	</script>
</Layout>
